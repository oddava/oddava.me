{
  "name": "oddava.me",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "install:deps": "pnpm install --dir ../oddava-tmp-install",
    "dev": "astro dev --mode development",
    "build": "astro build --mode production",
    "build:dev": "astro build --mode development",
    "deploy": "wrangler deploy --keep-vars",
    "preview": "astro preview --mode production",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check README.md .github docs src tests astro.config.mjs keystatic.config.ts package.json tsconfig.json vitest.config.ts wrangler.jsonc",
    "audit": "pnpm audit --prod --audit-level high",
    "spotify:token": "node get-spotify-token.js",
    "verify": "pnpm run format:check && pnpm run check && pnpm run test && pnpm run build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/react": "^5.0.7",
    "@keystatic/astro": "^5.1.0",
    "@keystatic/core": "^0.5.50",
    "astro": "^6.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/cloudflare": "^13.7.0",
    "@types/node": "^24.13.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.95.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "workerd"],
    "overrides": {
      "@babel/core": "7.29.7",
      "esbuild": "0.28.1",
      "js-yaml": "4.2.0"
    }
  }
}
