{
  "name": "oddava.me",
  "description": "Personal website, notes garden, and production publishing studio.",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/oddava/oddava.me.git"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "astro dev --mode development",
    "build": "astro build --mode production && node scripts/verify-build-output.mjs",
    "build:dev": "astro build --mode development && node scripts/verify-build-output.mjs",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "astro preview --mode production",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level moderate",
    "notes:export": "node scripts/export-notes-from-redis.mjs",
    "notes:migrate": "node scripts/migrate-notes-to-redis.mjs",
    "spotify:token": "node scripts/get-spotify-token.mjs",
    "verify": "pnpm run format:check && pnpm run check && pnpm run test && pnpm run build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/preact": "^6.0.1",
    "astro": "^7.0.7",
    "marked": "^18.0.6",
    "preact": "^10.29.7",
    "redis": "^6.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^14.1.2",
    "@types/node": "^24.13.1",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
