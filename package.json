{
  "name": "oddava.me",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "install:deps": "pnpm install --dir ../oddava-tmp-install",
    "gen:critical": "node scripts/gen-critical.mjs",
    "free:ports": "node scripts/free-dev-ports.mjs",
    "notes:migrate": "node scripts/migrate-notes-to-redis.mjs",
    "notes:export": "node scripts/export-notes-from-redis.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run gen:critical && node scripts/build-with-retry.mjs",
    "build:dev": "astro build --mode development",
    "deploy": "wrangler deploy --keep-vars",
    "preview": "astro preview --mode production",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check README.md .github src tests astro.config.mjs package.json pnpm-workspace.yaml tsconfig.json vitest.config.ts wrangler.jsonc",
    "audit": "pnpm audit --prod --audit-level high",
    "spotify:token": "node get-spotify-token.js",
    "verify": "pnpm run format:check && pnpm run check && pnpm run test && pnpm run build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/preact": "^6.0.1",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/m-plus-rounded-1c": "^5.2.5",
    "astro": "^6.4.8",
    "marked": "^18.0.5",
    "preact": "^10.29.4",
    "redis": "^4.7.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/cloudflare": "^13.7.0",
    "@types/node": "^24.13.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.8",
    "wrangler": "^4.95.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.3.6"
    }
  }
}
