# Runtime environment
APP_ENV=development
REDIS_MODE=local
LOCAL_REDIS_URL=redis://127.0.0.1:6379
# Dev-only Node proxy for local Redis when using the Cloudflare adapter.
# Defaults to http://localhost:45555/__local_redis
# LOCAL_REDIS_PROXY_URL=http://localhost:45555/__local_redis
# LOCAL_REDIS_PROXY_PORT=45555
# Optional dedicated proxy token. Falls back to COMMUNITY_SIGNING_SECRET.
# LOCAL_REDIS_PROXY_TOKEN=your_long_random_local_proxy_token
TURNSTILE_BYPASS_IN_DEV=true

# Admin auth and required community signing
ADMIN_PANEL_TOKEN=your_admin_panel_token
GUESTBOOK_ADMIN_TOKEN=your_guestbook_admin_token
COMMUNITY_SIGNING_SECRET=your_long_random_signing_secret

# Shared persistence
# Notes live in Redis in every environment, development included. There is no
# file-based fallback: without a reachable store, Studio and /notes are down.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
# Optional. When using the Cloudflare Upstash integration the binding vars
# are auto-injected under these names; the app falls back to them if the
# primary names above are unset.
# UPSTASH_REDIS_REST_KV_REST_API_URL=your_upstash_redis_kv_rest_api_url
# UPSTASH_REDIS_REST_KV_REST_API_TOKEN=your_upstash_redis_kv_rest_api_token

# ---------------------------------------------------------------------------
# Integrations
#
# These environment variables are the ONLY credential source: there is no
# runtime credential store and no admin write path. Rotating a key means
# setting the Cloudflare secret and pushing (which redeploys). Placeholder
# values (`your_...`, `..._here`) are treated as unset. Providers are
# registered in src/lib/server/integrations/registry.ts.
# ---------------------------------------------------------------------------

# Turnstile — guestbook bot protection. The site key ships in client HTML, so
# it is inherently build/deploy state.
PUBLIC_TURNSTILE_SITE_KEY=your_public_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Spotify — primary now-playing source.
# Generate the refresh token with `pnpm run spotify:token`.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# Lanyard — now-playing fallback via Discord presence. Requires membership of
# the Lanyard Discord server. Resolved in this order:
#   DISCORD_USER_ID -> LANYARD_DISCORD_USER_ID -> SPOTIFY_DISCORD_USER_ID
DISCORD_USER_ID=your_discord_id_here
# LANYARD_DISCORD_USER_ID=your_lanyard_discord_id
# SPOTIFY_DISCORD_USER_ID=your_spotify_discord_id

# Security: optional CSP reporting endpoint group name. When set, a
# `report-to <value>` directive is appended to the Content-Security-Policy
# header. The matching Reporting-Endpoints header must be configured by the
# deployment operator.
# CSP_REPORT_ENDPOINT=my-csp-endpoint

# Build-time: set to `false` to omit the Spotify widget bundle (the loader
# is swapped for a stub). Defaults to `true`.
SPOTIFY_WIDGET_ENABLED=true

# Future: Cloudflare Web Analytics beacon token (not yet wired). Set
# WEB_ANALYTICS_BEACON to enable once the beacon snippet is implemented.
# WEB_ANALYTICS_BEACON=
