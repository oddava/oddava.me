# Container runtime
HOST=0.0.0.0
PORT=4321
APP_ENV=development
REDIS_MODE=local
LOCAL_REDIS_URL=redis://127.0.0.1:6379
# Dev-only Node proxy for local Redis when using the Cloudflare adapter.
# Defaults to http://127.0.0.1:45555/__local_redis
# LOCAL_REDIS_PROXY_URL=http://127.0.0.1:45555/__local_redis
# LOCAL_REDIS_PROXY_PORT=45555
TURNSTILE_BYPASS_IN_DEV=true

# Admin auth and required community signing
ADMIN_PANEL_TOKEN=your_admin_panel_token
GUESTBOOK_ADMIN_TOKEN=your_guestbook_admin_token
COMMUNITY_SIGNING_SECRET=your_long_random_signing_secret

# Content admin
# Content editing is only available in local development. Set to "local" to
# enable filesystem writes during `pnpm run dev`. In production the admin
# content editor is disabled; edit files under src/content/, commit, push,
# and run `pnpm run deploy`.
CONTENT_WRITE_MODE=local
# Dev-only Node proxy for local file writes when using the Cloudflare adapter.
# Defaults to http://127.0.0.1:45556
# LOCAL_CONTENT_PROXY_URL=http://127.0.0.1:45556
# LOCAL_CONTENT_PROXY_PORT=45556

# Shared persistence
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Guestbook bot protection
PUBLIC_TURNSTILE_SITE_KEY=your_public_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# Discord / Lanyard
DISCORD_USER_ID=your_discord_id_here

# AniList
ANILIST_USERNAME=codeJ
