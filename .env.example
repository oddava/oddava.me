# Container runtime
HOST=0.0.0.0
PORT=4321
APP_ENV=development
REDIS_MODE=local
LOCAL_REDIS_URL=redis://127.0.0.1:6379
TURNSTILE_BYPASS_IN_DEV=true

# Admin auth
ADMIN_PANEL_TOKEN=your_admin_panel_token
GUESTBOOK_ADMIN_TOKEN=your_guestbook_admin_token
COMMUNITY_SIGNING_SECRET=your_long_random_signing_secret

# Keystatic
KEYSTATIC_GITHUB_CLIENT_ID=your_client_id
KEYSTATIC_GITHUB_CLIENT_SECRET=your_client_secret
KEYSTATIC_SECRET=your_session_signing_secret
# Optional: set only if Keystatic OAuth needs a forced canonical origin.
# KEYSTATIC_PUBLIC_ORIGIN=http://127.0.0.1:4321
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=your_github_app_slug

# Shared persistence
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Guestbook bot protection
PUBLIC_TURNSTILE_SITE_KEY=your_public_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# Discord / Lanyard
DISCORD_USER_ID=your_discord_id_here

# AniShows
ANISHOWS_API_BASE_URL=https://anishows.com/api/v1
ANISHOWS_USERNAME=oddava
