{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oddava-me",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
}
