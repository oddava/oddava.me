# Copy to .env on the VPS (chmod 600). Never commit the real file.
# Generate each secret with: openssl rand -hex 32

# Redis AUTH password (internal: only srh and loopback use it).
REDIS_PASSWORD=

# Bearer token the Worker sends. Becomes the UPSTASH_REDIS_REST_TOKEN secret.
SRH_TOKEN=

# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install token.
TUNNEL_TOKEN=

# RustFS root credentials (S3 access key id / secret). Root can do anything —
# create scoped keys in the console for apps instead of handing these out.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
