# Off-site backup settings for backup.sh. Copy to backup.env (chmod 600).
# Keep a copy of RESTIC_PASSWORD somewhere other than this VPS: without it the
# backups cannot be decrypted, and the VPS is exactly what they replace.

RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/oddava-backups
RESTIC_PASSWORD=

# R2 API token scoped to the backup bucket (Object Read & Write).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: healthchecks.io ping URL (https://hc-ping.com/<uuid>). Alerts when a
# run fails or does not happen at all. Leave empty to disable.
HEALTHCHECK_URL=
