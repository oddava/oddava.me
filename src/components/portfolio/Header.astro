---
/**
 * Portfolio header: the wordmark home, then projects, about and notes, then
 * the appearance icon. The sky is left out on purpose: it is an easter egg,
 * reached through the footer's visitor line.
 *
 * On the portfolio pages notes may live on its own origin, but it is still
 * this site, so it opens in the same tab like the other pages and is never
 * the current page. The notes pages wear this same header (NotesLayout): there
 * `section="notes"` marks notes as where you are, `origin` points the other
 * links back at the personal site when the page is served on the notes host,
 * and the `tools` slot holds note search beside the appearance icon.
 */
import LoadingIndicator from '../LoadingIndicator.astro';
import AppearanceControl from './AppearanceControl.astro';
import { NOTES_ROUTE_PREFIX, notesIndexUrl } from '../../lib/notes-url';

interface Props {
  /** Prefix for the personal site's own pages: '' on the apex. */
  origin?: string;
  /** The notes pages set this; the portfolio pages leave it unset. */
  section?: 'notes';
}

const { origin = '', section } = Astro.props;
const inNotes = section === 'notes';

const pathname =
  Astro.url.pathname.replace(/(?:\/index)?\.html$|\/$/, '') || '/';

const pages = [
  { href: '/projects', name: 'projects' },
  { href: '/about', name: 'about' },
] as const;

const current = (href: string) =>
  !inNotes && pathname === href ? ('page' as const) : undefined;

const notesHref = notesIndexUrl();
// On a notes page the link is where you are: the index itself, or a page
// inside the notes (`true`, styled the same). The pathname is the app's route
// on either host (`/notes`), whatever URL the visitor sees.
const notesCurrent = inNotes
  ? pathname === NOTES_ROUTE_PREFIX
    ? ('page' as const)
    : ('true' as const)
  : undefined;
---

<header class="pf-header">
  <a
    class="pf-mark"
    href={`${origin}/`}
    aria-current={current('/')}
    data-page-preview-ignore>oddava</a
  >
  <div class="pf-end">
    <nav class="pf-nav" aria-label="primary">
      {
        pages.map((page) => (
          <a
            href={`${origin}${page.href}`}
            aria-current={current(page.href)}
            data-page-preview-ignore
          >
            {page.name}
          </a>
        ))
      }
      <a href={notesHref} aria-current={notesCurrent} data-page-preview-ignore>
        notes
      </a>
    </nav>
    <slot name="tools" />
    <AppearanceControl />
  </div>
  <LoadingIndicator />
</header>
