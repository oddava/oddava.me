---
/**
 * Portfolio footer: a hairline, then the off-site contacts and the feed,
 * each with a small glyph so a one-letter label like "x" reads as a link,
 * not a separator. The glyphs are decorative; the label is the name.
 */
import linksData from '../../data/links.json';
import { externalLinkAttrs, isExternalHref } from '../../lib/portfolio/links';
import VisitorPulse from './VisitorPulse.astro';

type Glyph = 'github' | 'twitter' | 'mail' | 'rss';

const contacts = linksData.links.flatMap(({ url, title, icon }) =>
  url && !url.startsWith('/') ? [{ url, title, icon: icon as Glyph }] : [],
);
const links = [
  ...contacts,
  { url: '/rss.xml', title: 'rss', icon: 'rss' as Glyph },
];
---

<footer class="pf-footer">
  <div class="pf-footer-inner">
    <nav class="pf-contacts" aria-label="contact and feeds">
      {
        links.map((link) => {
          return (
            <a href={link.url} {...externalLinkAttrs(link.url)}>
              <svg
                class:list={['pf-glyph', `pf-glyph--${link.icon}`]}
                viewBox="0 0 24 24"
                width="15"
                height="15"
                aria-hidden="true"
                focusable="false"
              >
                {link.icon === 'github' && (
                  <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
                )}
                {link.icon === 'twitter' && (
                  <path d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.77L17.75 3Zm-1.08 16.18h1.7L7.4 4.73H5.58l11.1 14.45Z" />
                )}
                {link.icon === 'mail' && (
                  <>
                    <rect x="3" y="5" width="18" height="14" rx="2.5" />
                    <path d="m4 7 8 6 8-6" />
                  </>
                )}
                {link.icon === 'rss' && (
                  <>
                    <path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" />
                    <circle cx="6" cy="18" r="1.4" />
                  </>
                )}
              </svg>
              {link.title.toLowerCase()}
              {isExternalHref(link.url) && (
                <span class="sr-only"> (opens in new tab)</span>
              )}
            </a>
          );
        })
      }
    </nav>
    <VisitorPulse />
  </div>
</footer>
