---
/**
 * The portfolio's first bytes in <head>: the canvas colour for the chosen
 * theme, and the pre-paint script that applies the saved appearance before
 * anything is drawn. Both are inline and covered by the hash of their exact
 * bytes, which each page registers from its own frontmatter: here would be
 * too late for a server-rendered page's header (see lib/portfolio/csp.ts).
 */
import {
  APPEARANCE_CANVAS_STYLE,
  APPEARANCE_PREPAINT_SCRIPT,
} from '../../lib/portfolio/appearance';
---

<meta name="color-scheme" content="light dark" />
<meta
  name="theme-color"
  media="(prefers-color-scheme: light)"
  content="#ffffff"
/>
<meta
  name="theme-color"
  media="(prefers-color-scheme: dark)"
  content="#15181d"
/>
<!-- The odd-eyed cat. Every file is written by scripts/render-icons.mjs. -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<style is:inline set:html={APPEARANCE_CANVAS_STYLE}></style>
<script
  is:inline
  data-appearance-prepaint
  set:html={APPEARANCE_PREPAINT_SCRIPT}
/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/dm-sans-latin-variable.woff2"
  crossorigin
  fetchpriority="high"
/>
