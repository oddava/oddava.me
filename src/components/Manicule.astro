---
/**
 * The manicule ☞: a slim pointing hand in rubric ink, the site's one
 * character. Purely decorative — whatever it points at also carries
 * `aria-current` or the hover/focus it follows — so it is always hidden from
 * assistive technology. The thumb crease is cut in the paper colour.
 */
interface Props {
  class?: string;
  /** Marks the hand a list script moves (see src/lib/manicule.ts). */
  glide?: boolean;
}

const { class: className, glide = false } = Astro.props;
---

<svg
  class:list={['manicule', className]}
  viewBox="0 0 24 14"
  width="18"
  height="11"
  aria-hidden="true"
  focusable="false"
  data-manicule-hand={glide ? '' : undefined}
  ><rect x="0.6" y="3.1" width="2.5" height="8.2" rx="0.6"></rect><path
    d="M4.2 3.7C6 3.1 8 2.9 10 3H22.3a1.1 1.1 0 0 1 0 2.2H12.8c.9.2 1.2 1.6-.1 2.1c1 .3 1 1.7-.2 2c.8.4.6 1.6-.6 1.8L8.6 11.2C6.8 11.3 5.4 11 4.2 10.4Z"
  ></path><path class="manicule__crease" d="M6.6 7.3C8.4 6.7 10.4 6.8 12.2 7.3"
  ></path></svg
>
