---
import '../styles/components/_page-preview.css';
---

<aside
  id="page-preview"
  class="page-preview"
  popover="manual"
  role="tooltip"
  hidden
>
  <div class="page-preview__frame">
    <div class="page-preview__sheet">
      <div class="page-preview__skeleton" aria-hidden="true">
        <span class="page-preview__bar page-preview__bar--title"></span>
        <span class="page-preview__bar"></span>
        <span class="page-preview__bar page-preview__bar--short"></span>
      </div>
      <p class="page-preview__title" data-page-preview-title></p>
      <p class="page-preview__excerpt" data-page-preview-excerpt></p>
      <p class="page-preview__meta" data-page-preview-meta></p>
    </div>
  </div>
</aside>

<script>
  import {
    classifyPreviewResponse,
    composePreviewContent,
    previewPageUrl,
    resolvePreviewPlacement,
    type PreviewRect,
    type PreviewResult,
    type PreviewSide,
  } from '../lib/page-preview';

  const preview = document.querySelector<HTMLElement>('#page-preview');
  const sheet = preview?.querySelector<HTMLElement>('.page-preview__sheet');
  const frame = preview?.querySelector<HTMLElement>('.page-preview__frame');
  const titleEl = preview?.querySelector<HTMLElement>(
    '[data-page-preview-title]',
  );
  const excerptEl = preview?.querySelector<HTMLElement>(
    '[data-page-preview-excerpt]',
  );
  const metaEl = preview?.querySelector<HTMLElement>(
    '[data-page-preview-meta]',
  );

  if (preview && frame && sheet && titleEl && excerptEl && metaEl) {
    /** Nothing is open yet, so the reader still has to mean it. */
    const COLD_INTENT_MS = 110;
    /** A sheet is already open; scanning down a list should feel immediate. */
    const WARM_INTENT_MS = 50;
    /**
     * A pointer that travelled further than this while the intent timer ran
     * is passing through, not settling — the timer starts over from where it
     * is now. It is what keeps a sweep across a paragraph from popping sheets.
     */
    const INTENT_TOLERANCE_PX = 7;
    /** Hovering this long starts the fetch, ahead of the sheet opening. */
    const PREFETCH_DWELL_MS = 40;
    /**
     * How long a sheet waits for its page before settling for a skeleton. A
     * fast response opens straight into its content, so most hovers never
     * see a loading frame at all.
     */
    const PATIENCE_MS = 160;
    /** Time to cross the gap between a link and its sheet, or between two
        neighbouring links, without the sheet blinking shut. */
    const CLOSE_GRACE_MS = 120;
    /** Long enough to cover the translate and block-size transitions. */
    const GLIDE_MS = 240;
    const MAX_CACHE_ENTRIES = 24;
    const FETCH_TIMEOUT_MS = 5000;
    const EDGE_MARGIN = 12;
    /** How far the sheet's leading edge sits ahead of the attachment point. */
    const PANEL_LEAD = 24;
    /** A link needs this much of itself on screen to still be worth pointing at. */
    const VISIBLE_SLACK = 8;

    interface CacheEntry {
      promise: Promise<PreviewResult>;
      /** Set once resolved, so a revisit renders without a loading frame. */
      settled?: PreviewResult;
    }

    const cssNumber = (
      element: Element,
      property: string,
      fallback: number,
    ) => {
      const value = parseFloat(
        getComputedStyle(element).getPropertyValue(property),
      );
      return Number.isFinite(value) ? value : fallback;
    };

    // The stylesheet owns these dimensions; read them once so the geometry and
    // the hover bridge across the gap cannot drift apart.
    const GAP = cssNumber(preview, '--preview-gap', 8);
    const FRAME_BORDERS =
      cssNumber(frame, 'border-top-width', 1) +
      cssNumber(frame, 'border-bottom-width', 1);

    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const previewsDisabled = window.matchMedia(
      '(max-width: 720px), (hover: none), (pointer: coarse)',
    );
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const cache = new Map<string, CacheEntry>();

    /** The link whose sheet is showing. */
    let activeLink: HTMLAnchorElement | null = null;
    /** The link under the pointer, if any. */
    let hoveredLink: HTMLAnchorElement | null = null;
    /** Waiting out intent or patience; becomes active once it shows. */
    let pendingLink: HTMLAnchorElement | null = null;
    /** Dismissed with Escape; stays quiet until the reader leaves it. */
    let suppressedLink: HTMLAnchorElement | null = null;
    /** Arrived under the pointer by scrolling; wakes on the next real move. */
    let dormantLink: HTMLAnchorElement | null = null;
    let describedLink: HTMLAnchorElement | null = null;
    let previousDescription: string | null = null;
    let pointerX: number | null = null;
    let pointerY: number | null = null;
    let armedX = 0;
    let armedY = 0;
    let intentTimer = 0;
    let prefetchTimer = 0;
    let closeTimer = 0;
    let glideTimer = 0;
    let placementFrame = 0;
    let requestToken = 0;
    /** Hover changes after a scroll come from content moving under a still
        pointer, not from the reader — until the pointer itself moves. */
    let scrolledSinceMove = false;
    let overSheet = false;
    let isOpen = false;

    const eligibleLink = (target: EventTarget | null) => {
      if (
        previewsDisabled.matches ||
        document.body.classList.contains('note-search-open')
      )
        return null;
      if (!(target instanceof Element)) return null;
      const link = target.closest<HTMLAnchorElement>('a[href]');
      if (
        !link ||
        link.hasAttribute('download') ||
        link.hasAttribute('data-page-preview-ignore') ||
        link.closest('[role="dialog"], dialog, #page-preview') ||
        (link.target && link.target !== '_self') ||
        // A card already carries its own title; a sheet would repeat it.
        link.querySelector('h1, h2, h3, h4, h5, h6')
      ) {
        return null;
      }
      return previewPageUrl(link.href, window.location.href) ? link : null;
    };

    const inSheet = (node: EventTarget | null) =>
      node instanceof Node && preview.contains(node);

    /* --- Geometry ------------------------------------------------------- */

    /**
     * The line box the reader is actually looking at. A link wrapped across
     * two lines has a bounding rect that spans both and starts wherever the
     * first line began — anchoring to it would put the sheet somewhere the
     * pointer never was.
     */
    const anchorRect = (link: HTMLAnchorElement): PreviewRect | null => {
      const rects = Array.from(link.getClientRects());
      if (rects.length === 0) return null;
      if (rects.length === 1 || pointerY === null) return rects[0]!;

      let closest = rects[0]!;
      let shortest = Infinity;
      for (const rect of rects) {
        const distance =
          pointerY < rect.top
            ? rect.top - pointerY
            : pointerY > rect.bottom
              ? pointerY - rect.bottom
              : 0;
        if (distance < shortest) {
          closest = rect;
          shortest = distance;
        }
      }
      return closest;
    };

    /** Target height, read from the sheet so an in-flight height transition
        on the frame cannot feed a stale number back into placement. */
    const panelHeight = () => sheet.offsetHeight + FRAME_BORDERS;

    const setVar = (name: string, value: string) => {
      // CSSOM writes, not authored style attributes: `style-src` does not
      // govern these, so the strict hashed CSP is untouched.
      preview.style.setProperty(name, value);
    };

    /** `keepSide` holds an open sheet on its current side while it still fits. */
    const place = (keepSide = true) => {
      if (!activeLink) return;
      const anchor = anchorRect(activeLink);
      if (
        !anchor ||
        !activeLink.isConnected ||
        eligibleLink(activeLink) !== activeLink ||
        anchor.bottom < VISIBLE_SLACK ||
        anchor.top > window.innerHeight - VISIBLE_SLACK
      ) {
        closePanel();
        return;
      }

      const placement = resolvePreviewPlacement({
        anchor,
        pointerX,
        panel: { width: preview.offsetWidth, height: panelHeight() },
        viewport: { width: window.innerWidth, height: window.innerHeight },
        margin: EDGE_MARGIN,
        gap: GAP,
        lead: PANEL_LEAD,
        prefer: keepSide
          ? (preview.dataset.placement as PreviewSide | undefined)
          : undefined,
      });

      preview.dataset.placement = placement.side;
      setVar('--preview-x', `${Math.round(placement.x)}px`);
      setVar('--preview-y', `${Math.round(placement.y)}px`);
      setVar('--preview-origin-x', `${Math.round(placement.originX)}px`);
    };

    const syncHeight = () => {
      setVar('--preview-block-size', `${sheet.offsetHeight}px`);
    };

    /** Ease the next placement and resize, then go back to tracking instantly
        so a resize never leaves the sheet trailing its link. */
    const glide = () => {
      if (reducedMotion.matches) return;
      preview.classList.add('page-preview--glide');
      window.clearTimeout(glideTimer);
      glideTimer = window.setTimeout(() => {
        preview.classList.remove('page-preview--glide');
      }, GLIDE_MS);
    };

    /** Fade fresh contents in under an already-open sheet. */
    const swapIn = () => {
      if (reducedMotion.matches) return;
      preview.classList.remove('page-preview--swap');
      void preview.offsetWidth;
      preview.classList.add('page-preview--swap');
    };

    preview.addEventListener('animationend', (event) => {
      if (event.animationName === 'page-preview-swap') {
        preview.classList.remove('page-preview--swap');
      }
    });

    /* --- Content -------------------------------------------------------- */

    const setText = (element: HTMLElement, text: string) => {
      if (element.textContent !== text) element.textContent = text;
      element.hidden = !text;
    };

    const render = (result: PreviewResult | undefined) => {
      if (!result) {
        preview.dataset.state = 'loading';
        setText(titleEl, '');
        setText(excerptEl, '');
        setText(metaEl, '');
      } else if (result.kind === 'ready') {
        preview.dataset.state = 'ready';
        setText(titleEl, result.content.title);
        setText(excerptEl, result.content.excerpt);
        setText(metaEl, result.content.meta);
      } else {
        preview.dataset.state = 'missing';
        setText(titleEl, 'page not found');
        setText(excerptEl, '');
        setText(metaEl, '');
      }
    };

    const firstParagraph = (root: ParentNode) => {
      for (const paragraph of root.querySelectorAll('p')) {
        const text = paragraph.textContent?.trim() ?? '';
        // Short paragraphs on note pages are metadata ("updated 4 may"), not
        // the opening the reader wants to see.
        if (text.length >= 40) return text;
      }
      return null;
    };

    const countWords = (text: string) =>
      text.trim().split(/\s+/).filter(Boolean).length;

    const readPreview = (html: string): PreviewResult => {
      const parsed = new DOMParser().parseFromString(html, 'text/html');
      const main = parsed.querySelector('main') ?? parsed.body;
      // A note page puts its related notes and local map inside <main>
      // alongside the article. Read the document itself, so neither the
      // opening line nor the reading time comes from the rail beside it.
      const body = main?.querySelector('article') ?? main;
      const content = composePreviewContent({
        heading: main?.querySelector('h1')?.textContent,
        documentTitle: parsed.title,
        description: parsed.querySelector<HTMLMetaElement>(
          'meta[name=description]',
        )?.content,
        lead: body ? firstParagraph(body) : null,
        updated: main?.querySelector('time[datetime]')?.textContent,
        wordCount: countWords(body?.textContent ?? ''),
      });
      return content ? { kind: 'ready', content } : { kind: 'failed' };
    };

    const fetchPreview = async (url: string): Promise<PreviewResult> => {
      try {
        const response = await fetch(url, {
          signal: AbortSignal.timeout(FETCH_TIMEOUT_MS),
          credentials: 'same-origin',
          headers: { Accept: 'text/html' },
        });
        if (new URL(response.url).origin !== window.location.origin) {
          return { kind: 'failed' };
        }
        const verdict = classifyPreviewResponse({
          ok: response.ok,
          status: response.status,
          contentType: response.headers.get('content-type'),
        });
        if (verdict !== 'read') return { kind: verdict };
        return readPreview(await response.text());
      } catch {
        return { kind: 'failed' };
      }
    };

    const loadPreview = (url: string): CacheEntry => {
      const cached = cache.get(url);
      if (cached) {
        // Refresh insertion order so frequently revisited pages survive the
        // small LRU cache without keeping an unbounded browsing history.
        cache.delete(url);
        cache.set(url, cached);
        return cached;
      }

      const entry: CacheEntry = { promise: fetchPreview(url) };
      entry.promise.then((result) => {
        entry.settled = result;
        // A timeout or a dropped connection says nothing about the page, so
        // it is not remembered: the next hover gets a fresh attempt.
        if (result.kind === 'failed' && cache.get(url) === entry) {
          cache.delete(url);
        }
      });

      cache.set(url, entry);
      if (cache.size > MAX_CACHE_ENTRIES) {
        cache.delete(cache.keys().next().value!);
      }
      return entry;
    };

    /* --- Open / close --------------------------------------------------- */

    const describe = (link: HTMLAnchorElement) => {
      if (describedLink === link) return;
      undescribe();
      previousDescription = link.getAttribute('aria-describedby');
      link.setAttribute(
        'aria-describedby',
        [previousDescription, preview.id].filter(Boolean).join(' '),
      );
      describedLink = link;
    };

    const undescribe = () => {
      if (!describedLink) return;
      if (previousDescription === null) {
        describedLink.removeAttribute('aria-describedby');
      } else {
        describedLink.setAttribute('aria-describedby', previousDescription);
      }
      describedLink = null;
      previousDescription = null;
    };

    const setActive = (link: HTMLAnchorElement | null) => {
      if (activeLink === link) return;
      activeLink?.classList.remove('page-preview-link');
      undescribe();
      activeLink = link;
      link?.classList.add('page-preview-link');
    };

    const cancelPending = () => {
      window.clearTimeout(intentTimer);
      window.clearTimeout(prefetchTimer);
      pendingLink = null;
      requestToken += 1;
    };

    const cancelClose = () => {
      window.clearTimeout(closeTimer);
      closeTimer = 0;
    };

    const closePanel = () => {
      cancelPending();
      cancelClose();
      window.clearTimeout(glideTimer);
      setActive(null);
      isOpen = false;
      preview.classList.remove('page-preview--glide', 'page-preview--swap');
      if (preview.matches(':popover-open')) preview.hidePopover();
    };

    /** Close unless the pointer comes back to the link or onto the sheet. */
    const closeSoon = () => {
      if (!isOpen || closeTimer) return;
      closeTimer = window.setTimeout(() => {
        closeTimer = 0;
        closePanel();
      }, CLOSE_GRACE_MS);
    };

    const dismiss = () => {
      overSheet = false;
      hoveredLink = null;
      suppressedLink = null;
      dormantLink = null;
      closePanel();
    };

    /** Put the sheet on screen for `link`, already filled and placed. */
    const present = (
      link: HTMLAnchorElement,
      result: PreviewResult | undefined,
    ) => {
      const wasOpen = isOpen;
      const changed = wasOpen && activeLink !== link;
      setActive(link);
      render(result);

      // The sheet has to be rendered before it can be measured, and the
      // browser cannot paint between here and the end of this task — so it is
      // shown, filled, sized, and placed without ever being seen misplaced.
      if (!wasOpen) {
        // The attribute only guards the pre-script state; after the first
        // open the popover's own closed state handles display — and leaving
        // it off is what lets the exit transition run at all.
        preview.hidden = false;
        preview.classList.remove('page-preview--glide', 'page-preview--swap');
        if (!preview.matches(':popover-open')) preview.showPopover();
        isOpen = true;
      } else {
        glide();
      }
      syncHeight();
      place(wasOpen);
      if (changed) swapIn();
      if (result?.kind === 'ready') describe(link);
    };

    const show = async (link: HTMLAnchorElement) => {
      const url = previewPageUrl(link.href, window.location.href);
      if (!url || !link.isConnected || eligibleLink(link) !== link) return;

      const token = ++requestToken;
      const entry = loadPreview(url);
      const stale = () => token !== requestToken || pendingLink !== link;

      if (entry.settled === undefined) {
        // Hold off briefly: an open sheet keeps its current page, a closed
        // one stays closed, and a quick answer skips the skeleton entirely.
        await Promise.race([
          entry.promise,
          new Promise((resolve) => window.setTimeout(resolve, PATIENCE_MS)),
        ]);
        if (stale()) return;
      }

      if (entry.settled?.kind === 'failed') {
        pendingLink = null;
        if (isOpen) closePanel();
        return;
      }

      pendingLink = null;
      cancelClose();
      present(link, entry.settled);
      if (entry.settled !== undefined) return;

      // Only the sheet showing this link cares now. Not the request token: a
      // swap the pointer abandoned on its way back here must not strand the
      // skeleton.
      const result = await entry.promise;
      if (activeLink !== link || !isOpen) return;
      if (result.kind === 'failed') {
        closePanel();
        return;
      }
      glide();
      render(result);
      syncHeight();
      place();
      swapIn();
      if (result.kind === 'ready') describe(link);
    };

    /**
     * Wait for the pointer to settle on `link`, then show it. A pointer still
     * travelling when the timer runs out re-arms it from where it is now.
     */
    const schedule = (link: HTMLAnchorElement, delay: number) => {
      const url = previewPageUrl(link.href, window.location.href);
      if (!url) return;
      cancelPending();
      pendingLink = link;

      if (pointerX === null || pointerY === null) {
        void show(link);
        return;
      }

      prefetchTimer = window.setTimeout(() => {
        loadPreview(url);
      }, PREFETCH_DWELL_MS);

      const arm = () => {
        armedX = pointerX ?? 0;
        armedY = pointerY ?? 0;
        intentTimer = window.setTimeout(() => {
          if (pendingLink !== link) return;
          const travelled = Math.hypot(
            (pointerX ?? armedX) - armedX,
            (pointerY ?? armedY) - armedY,
          );
          if (travelled > INTENT_TOLERANCE_PX) arm();
          else void show(link);
        }, delay);
      };
      arm();
    };

    /* --- Pointer -------------------------------------------------------- */

    const hoverLink = (link: HTMLAnchorElement | null, force = false) => {
      if (link === hoveredLink && !force) return;
      hoveredLink = link;
      dormantLink = null;
      if (link !== suppressedLink) suppressedLink = null;

      if (!link) {
        // On plain page now. Abandon anything not yet shown, and let an open
        // sheet go unless the pointer is only crossing to it.
        if (pendingLink) cancelPending();
        closeSoon();
        return;
      }
      if (link === suppressedLink) {
        if (pendingLink) cancelPending();
        closeSoon();
        return;
      }
      if (link === activeLink) {
        // Back on the open sheet's own link: it stays exactly where it was.
        if (pendingLink) cancelPending();
        cancelClose();
        return;
      }
      if (scrolledSinceMove) {
        // The page moved under a still pointer. Wait for the reader to move.
        dormantLink = link;
        if (pendingLink) cancelPending();
        closeSoon();
        return;
      }
      // A neighbour while a sheet is open: keep the current one up until the
      // swap is confirmed, so a pass across the link costs nothing.
      cancelClose();
      schedule(link, isOpen ? WARM_INTENT_MS : COLD_INTENT_MS);
    };

    document.addEventListener(
      'pointerover',
      (event) => {
        if (!finePointer.matches || event.pointerType === 'touch') return;
        pointerX = event.clientX;
        pointerY = event.clientY;
        if (inSheet(event.target)) {
          // Reading the sheet holds it open, and abandons any swap the
          // pointer brushed past on its way here.
          overSheet = true;
          hoveredLink = null;
          if (pendingLink) cancelPending();
          cancelClose();
          return;
        }
        const leftSheet = overSheet;
        overSheet = false;
        hoverLink(eligibleLink(event.target), leftSheet);
      },
      { passive: true },
    );

    document.addEventListener(
      'pointerout',
      (event) => {
        // Leaving the window entirely.
        if (!event.relatedTarget) dismiss();
      },
      { passive: true },
    );

    document.addEventListener(
      'pointermove',
      (event) => {
        // Only a real move counts: the synthetic hover update a browser sends
        // after scrolling carries no movement.
        if (scrolledSinceMove && (event.movementX || event.movementY)) {
          scrolledSinceMove = false;
        }
        // Bound to an active hover, so this is a pair of assignments while the
        // pointer is over a link and nothing at all otherwise.
        if (!hoveredLink) return;
        pointerX = event.clientX;
        pointerY = event.clientY;
        if (dormantLink && !scrolledSinceMove) {
          const link = dormantLink;
          dormantLink = null;
          hoveredLink = null;
          hoverLink(link);
        }
      },
      { passive: true },
    );

    // The sheet stands in for its link: a click on it follows the link, and a
    // modified or middle click opens it in a new tab the way the link would.
    const follow = (event: MouseEvent) => {
      const link = activeLink;
      if (!link || !isOpen) return;
      if (event.button === 1 || event.metaKey || event.ctrlKey) {
        event.preventDefault();
        window.open(link.href, '_blank', 'noopener');
        return;
      }
      if (event.button !== 0) return;
      link.click();
      closePanel();
    };
    preview.addEventListener('click', follow);
    preview.addEventListener('auxclick', follow);

    document.addEventListener(
      'pointerdown',
      (event) => {
        if (!inSheet(event.target)) dismiss();
      },
      { passive: true },
    );

    /* --- Keyboard ------------------------------------------------------- */

    document.addEventListener('focusin', (event) => {
      const link = eligibleLink(event.target);
      if (!link) {
        if (
          !hoveredLink ||
          (event.target instanceof Element &&
            event.target.closest('[role="dialog"], dialog'))
        )
          dismiss();
        return;
      }
      // Only keyboard focus opens a preview; a click's focus would otherwise
      // reopen the sheet the reader is already navigating away from.
      if (!link.matches(':focus-visible')) return;
      if (link === suppressedLink || link === activeLink) return;
      pointerX = null;
      pointerY = null;
      cancelClose();
      schedule(link, 0);
    });

    document.addEventListener('focusout', (event) => {
      const link = eligibleLink(event.target);
      if (!link || link.contains(event.relatedTarget as Node | null)) return;
      if (link === suppressedLink) suppressedLink = null;
      if (link === pendingLink) cancelPending();
      if (link !== activeLink || hoveredLink === link) return;
      closePanel();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !(isOpen || pendingLink)) return;
      suppressedLink = activeLink ?? pendingLink ?? hoveredLink;
      closePanel();
    });

    /* --- Page lifecycle ------------------------------------------------- */

    // Opening search by keyboard need not produce a pointerout. Its overlay
    // also cannot cover a popover in the browser's top layer.
    new MutationObserver(() => {
      if (document.body.classList.contains('note-search-open')) dismiss();
    }).observe(document.body, { attributes: true, attributeFilter: ['class'] });

    window.addEventListener('blur', dismiss);
    window.addEventListener('pagehide', dismiss);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) dismiss();
    });

    // Scrolling moves the link out from under the sheet; a sheet chasing it
    // reads as lag, so it simply goes.
    window.addEventListener(
      'scroll',
      () => {
        scrolledSinceMove = true;
        if (isOpen || pendingLink) dismiss();
      },
      { passive: true, capture: true },
    );

    window.addEventListener(
      'resize',
      () => {
        if (!activeLink || placementFrame) return;
        placementFrame = window.requestAnimationFrame(() => {
          placementFrame = 0;
          syncHeight();
          place();
        });
      },
      { passive: true },
    );

    /**
     * Links inside running text that will open a sheet carry a mark before
     * they are hovered, so a reader can tell them from ordinary links. Nav,
     * cards, and lists of links stay unmarked — the mark is for prose, where
     * a link is a detour the reader might want to peek at first. Recomputed
     * when previews toggle, so a narrow or touch screen shows no promise the
     * page cannot keep.
     */
    const markPreviewableLinks = () => {
      for (const link of document.querySelectorAll<HTMLAnchorElement>(
        'main a[href]',
      )) {
        const inProse =
          link.closest('p, blockquote, .prose li, .prose td') &&
          !link.closest('nav');
        link.toggleAttribute(
          'data-previewable',
          Boolean(inProse && eligibleLink(link)),
        );
      }
    };
    markPreviewableLinks();

    previewsDisabled.addEventListener('change', () => {
      if (previewsDisabled.matches) dismiss();
      markPreviewableLinks();
    });
  }
</script>
