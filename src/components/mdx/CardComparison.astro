---
import './CardComparison.css';
import {
  resolveCardComparisonProps,
  type CardComparisonProps,
} from './cardComparison';

const { beforeSrc, beforeAlt, afterSrc, afterAlt } = Astro.props;

export type Props = CardComparisonProps;

const resolved = resolveCardComparisonProps(Astro.props);
---

<section
  class:list={['card-comparison', resolved.className]}
  style={resolved.rootStyle}
>
  <div class="card-comparison__grid">
    <figure
      class="card-comparison__item"
      style={resolved.beforeStyle}
      data-fit={resolved.beforeFit}
      data-upscale={resolved.beforeAllowUpscale ? 'true' : 'false'}
    >
      <div class="card-comparison__media">
        <img src={beforeSrc} alt={beforeAlt} loading="lazy" decoding="async" />
      </div>
      <figcaption class="card-comparison__caption">
        {resolved.beforeCaption}
      </figcaption>
    </figure>

    <figure
      class="card-comparison__item"
      style={resolved.afterStyle}
      data-fit={resolved.afterFit}
      data-upscale={resolved.afterAllowUpscale ? 'true' : 'false'}
    >
      <div class="card-comparison__media">
        <img src={afterSrc} alt={afterAlt} loading="lazy" decoding="async" />
      </div>
      <figcaption class="card-comparison__caption">
        {resolved.afterCaption}
      </figcaption>
    </figure>
  </div>
</section>
