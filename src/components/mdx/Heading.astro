---
import type { HeadingLevel } from './headings';
import { slugifyHeading } from './headings';

interface Props {
  level: HeadingLevel;
  id?: string;
}

const { level, id } = Astro.props;
const renderedHtml = await Astro.slots.render('default');
const slug = slugifyHeading(renderedHtml, id);
const Tag = `h${level}` as 'h2' | 'h3' | 'h4';
---

<Tag id={slug} tabindex={-1}>
  <slot />
  <a href={`#${slug}`} class="anchor" aria-hidden="true">#</a>
</Tag>
