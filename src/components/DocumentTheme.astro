---
import { createHash } from 'node:crypto';

// Paint the canvas before external stylesheets arrive. Keep this inline and
// register its exact bytes with CSP rather than allowing arbitrary inline CSS.
const css =
  'html{color-scheme:dark;background-color:#000000;background-color:var(--color-surface,#000000)}';
Astro.csp?.insertStyleHash(
  `sha256-${createHash('sha256').update(css).digest('base64')}`,
);
---

<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#000000" />
<!-- Every icon file is written by scripts/render-icons.mjs. -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<style is:inline set:html={css}></style>
