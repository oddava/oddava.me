---
/**
 * The night behind the cat: a canvas star field (drawn by the mount script)
 * and a faint constellation cat that keeps the real one company. Purely
 * decorative; the moon and the overlays live with the page so they can take
 * pointer events above the page layer.
 */
const stars: [number, number][] = [
  [50, 30],
  [88, 27],
  [69, 43],
  [42, 66],
  [97, 63],
  [103, 122],
  [114, 182],
  [64, 198],
  [36, 142],
  [16, 186],
];
const lines = [
  [0, 2],
  [2, 1],
  [0, 3],
  [1, 4],
  [4, 5],
  [5, 6],
  [6, 7],
  [7, 8],
  [8, 3],
  [7, 9],
];
const spark = (r: number) =>
  `M0 ${-r}Q${r * 0.18} ${-r * 0.18} ${r} 0Q${r * 0.18} ${r * 0.18} 0 ${r}Q${-r * 0.18} ${r * 0.18} ${-r} 0Q${-r * 0.18} ${-r * 0.18} 0 ${-r}Z`;
---

<div class="awake-sky" data-awake-sky aria-hidden="true">
  <canvas class="awake-sky__canvas" data-awake-sky-canvas></canvas>
  <svg class="awake-friend" viewBox="0 0 130 215" focusable="false">
    <g class="awake-friend__lines">
      {
        lines.map(([a, b]) => (
          <line
            x1={stars[a!]![0]}
            y1={stars[a!]![1]}
            x2={stars[b!]![0]}
            y2={stars[b!]![1]}
          />
        ))
      }
    </g>
    {
      stars.map(([x, y], i) => (
        <path
          class="awake-friend__star"
          transform={`translate(${x} ${y})`}
          d={spark(i < 2 ? 4.2 : 3)}
        />
      ))
    }
    <g data-awake-friend-eye transform="translate(61 52)">
      <path class="awake-friend__eye" d={spark(2.6)}></path>
    </g>
    <g data-awake-friend-eye transform="translate(79 51)">
      <path class="awake-friend__eye" d={spark(2.6)}></path>
    </g>
  </svg>
</div>
