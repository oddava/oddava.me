  <p class="admin-gate__brand">
    <span class="admin-gate__wordmark">oddava</span>
    <span class="admin-gate__tag">admin</span>
  </p>
  <p class="admin-gate__message">
    admin is off. set <code>ADMIN_PANEL_TOKEN</code> or{' '}
    <code>GUESTBOOK_ADMIN_TOKEN</code> in the environment, then reload this page.
  </p>
</section>
