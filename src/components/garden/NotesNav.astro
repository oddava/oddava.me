---
import type { SearchDocument } from '@lib/garden';
import GardenSearch from './GardenSearch';

interface Props {
  documents: SearchDocument[];
  current?: 'notes' | 'map';
  showSearch?: boolean;
}

const { documents, current, showSearch = true } = Astro.props;
---

<header class="garden-nav">
  <a href="/" class="garden-nav__brand" aria-label="oddava home">
    <span class="garden-nav__mark" aria-hidden="true"></span>
    <span>oddava</span>
  </a>

  <nav class="garden-nav__links" aria-label="Notes navigation">
    <a
      href="/notes"
      class:list={['garden-nav__link', current === 'notes' && 'is-current']}
      aria-current={current === 'notes' ? 'page' : undefined}>notes</a
    >
    <a
      href="/notes/graph"
      class:list={['garden-nav__link', current === 'map' && 'is-current']}
      aria-current={current === 'map' ? 'page' : undefined}>map</a
    >
    {showSearch && <GardenSearch client:load documents={documents} />}
  </nav>
</header>
