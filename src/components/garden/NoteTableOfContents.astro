---
import TocScrollSpy from '@components/TocScrollSpy.astro';
import type { NoteHeading } from '@lib/garden/render';

interface Props {
  headings: NoteHeading[];
  variant: 'rail' | 'mobile';
}

const { headings, variant } = Astro.props;
---

{
  headings.length >= 2 && variant === 'rail' && (
    <nav
      class="note-toc note-toc--rail note-context__section"
      aria-label="On this page"
      data-toc-spy
    >
      <h2 class="note-context__label">On this page</h2>
      <ol class="note-toc__list">
        {headings.map((heading) => (
          <li class={`note-toc__item note-toc__item--depth-${heading.depth}`}>
            <a class="note-toc__link" href={`#${heading.id}`}>
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

{
  headings.length >= 2 && variant === 'mobile' && (
    <details class="note-toc note-toc--mobile" data-toc-spy>
      <summary class="note-toc__summary">On this page</summary>
      <nav aria-label="On this page">
        <ol class="note-toc__list">
          {headings.map((heading) => (
            <li class={`note-toc__item note-toc__item--depth-${heading.depth}`}>
              <a class="note-toc__link" href={`#${heading.id}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<TocScrollSpy />
