---
/**
 * A note's contents, folded under its title like a slip tucked into the
 * page: closed by default, so a short read starts with its first line. Only
 * a note with a few sections has one. The open slip marks the section you
 * are reading (TocScrollSpy).
 */
import TocScrollSpy from '@components/TocScrollSpy.astro';
import type { NoteHeading } from '@lib/garden/render';

interface Props {
  headings: NoteHeading[];
}

const { headings } = Astro.props;
---

{
  headings.length >= 3 && (
    <details class="note-contents" data-toc-spy>
      <summary class="note-contents__toggle">
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="4.5" cy="5.5" r="0.9" />
          <path d="M8 5.5h8.5" />
          <circle cx="4.5" cy="10" r="0.9" />
          <path d="M8 10h8.5" />
          <circle cx="4.5" cy="14.5" r="0.9" />
          <path d="M8 14.5h5.5" />
        </svg>
        contents
        <span class="notes-sticker">{headings.length}</span>
      </summary>
      <nav aria-label="In this note">
        <ol class="note-contents__list" role="list">
          {headings.map((heading) => (
            <li
              class={`note-contents__item note-contents__item--depth-${heading.depth}`}
            >
              <a href={`#${heading.id}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<TocScrollSpy />
