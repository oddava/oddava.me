---
/**
 * A note, as a sheet of paper on the desk: the same page Studio writes on,
 * taped down, one measure wide. Above it, the trail of folders it sits in and
 * the search pill; on it, the note and (for a folder) an index of its pages;
 * beside it on wide screens, a sidebar with the note's neighbourhood in the
 * graph and an outline of its sections (under the sheet on narrow ones, where
 * the folded contents slip stands in for the outline); under it, a few cards
 * to keep reading. Every part off the sheet appears only when it has
 * something to show.
 *
 * Shared by the public note route and the owner's draft preview.
 */
import type { GardenDocument, GardenIndex } from '@lib/garden';
import { getRelatedNotes } from '@lib/garden';
import { deriveNoteGraph } from '@lib/garden/graph';
import { renderNote } from '@lib/garden/render';
import {
  bodyProvidesTitleHeading,
  formatNoteDate,
  shouldShowNoteTitle,
} from '@lib/garden/utils';
import { folderAncestors } from '@lib/garden/wayfinder';
import { notesTagUrl } from '@lib/notes-url';
import NotePageIcon from '../NotePageIcon';
import InteractiveGraph from './InteractiveGraph';
import NoteCard from './NoteCard.astro';
import NotesSearchButton from './NotesSearchButton.astro';
import NoteTableOfContents from './NoteTableOfContents.astro';
import '../../styles/components/_note-prose.css';

interface Props {
  document: GardenDocument;
  index: GardenIndex;
  /** The owner's preview of an unpublished note. */
  draft?: boolean;
}

const { document, index, draft = false } = Astro.props;
const rendered = document.body.trim()
  ? renderNote(document.body, { wikiLinkHrefs: index.wikiLinkHrefs })
  : { html: '', headings: [] };

const isRoot = document.id === index.root.id;

// A note whose body opens with its own `# h1` supplies the page title itself;
// otherwise the page provides it.
const showShellTitle = shouldShowNoteTitle(document.body);
let authoredTitleHtml = '';
let bodyHtml = rendered.html;
if (bodyProvidesTitleHeading(document.body)) {
  const titleEnd = bodyHtml.indexOf('</h1>');
  if (titleEnd >= 0) {
    authoredTitleHtml = bodyHtml.slice(0, titleEnd + '</h1>'.length);
    bodyHtml = bodyHtml.slice(titleEnd + '</h1>'.length).trimStart();
  }
}
const isStub = !rendered.html && document.childIds.length === 0;

const trail = folderAncestors(document, index);

// A folder's note is its folder page: an index of what is inside follows its
// own words. The root's pages are the landing's business.
const pages = isRoot
  ? []
  : document.childIds.flatMap((id) => {
      const child = index.byId.get(id);
      return child ? [child] : [];
    });

// Keep reading: notes that link here, newest first, then notes that share
// its tags. Both read the public index, so a draft never shows.
const backlinks = document.backlinks
  .flatMap((id) => {
    const source = index.byId.get(id);
    return source && source.id !== document.id ? [source] : [];
  })
  .toSorted((left, right) => right.updated.localeCompare(left.updated));
const related = getRelatedNotes(document, index, { limit: 4 });

// The note's corner of the graph, only when it has neighbours: a lone dot in
// a frame says nothing.
const neighbourhood = deriveNoteGraph(index, document.id);
const showGraph = neighbourhood.nodes.length > 1;

// The sidebar's outline: two sections are already worth a map. On narrow
// screens it hides and the folded contents slip on the sheet stands in.
const showOutline = rendered.headings.length >= 2;
const hasAside = showGraph || showOutline;
---

<div class:list={['note-reading', hasAside && 'note-reading--aside']}>
  <div class="notes-bar">
    {
      trail.length > 0 && (
        <nav class="note-trail" aria-label="Where this note lives">
          <ol role="list">
            {trail.map((folder) => (
              <li>
                <a href={folder.href} data-page-preview-ignore>
                  {folder.title}
                </a>
              </li>
            ))}
            <li aria-current="page">{document.title}</li>
          </ol>
        </nav>
      )
    }
    <NotesSearchButton variant="pill" />
  </div>

  <article class:list={['notes-sheet', 'note-sheet', draft && 'is-draft']}>
    {
      draft && (
        <p class="note-sheet__draft" role="status">
          <span class="notes-sticker notes-sticker--draft">draft</span>
          only you can see this page. publish it from Studio to share it.
        </p>
      )
    }
    <NotePageIcon icon={document.data.icon} />
    {showShellTitle && <h1 class="note-sheet__title">{document.title}</h1>}
    {
      authoredTitleHtml && (
        <div
          class="prose note-sheet__authored-title"
          set:html={authoredTitleHtml}
        />
      )
    }
    {
      !isRoot && (
        <p class="note-sheet__meta">
          <time class="notes-stamp" datetime={document.updated}>
            {formatNoteDate(document.updated)}
          </time>
          {document.tags.map((tag) => (
            <a class="notes-sticker notes-sticker--tag" href={notesTagUrl(tag)}>
              #{tag}
            </a>
          ))}
        </p>
      )
    }
    <NoteTableOfContents headings={rendered.headings} />
    {
      bodyHtml && (
        <div
          class:list={[
            'prose',
            'note-sheet__body',
            authoredTitleHtml && 'note-sheet__body--continuation',
          ]}
          set:html={bodyHtml}
        />
      )
    }
    {
      isStub && (
        <p class="note-sheet__stub">
          nothing written here yet — this page is still blank.
        </p>
      )
    }
    {
      pages.length > 0 && (
        <section class="note-index" aria-labelledby="note-index-heading">
          <h2 class="notes-label" id="note-index-heading">
            in this folder
            <span class="notes-sticker">{pages.length}</span>
          </h2>
          <ol class="note-index__list" role="list">
            {pages.map((page) => (
              <li>
                <a
                  class="note-index__row"
                  href={page.href}
                  data-page-preview-ignore
                >
                  <span class="note-index__title">{page.title}</span>
                  <span class="note-index__leader" aria-hidden="true" />
                  <time datetime={page.updated}>
                    {formatNoteDate(page.updated, 'short')}
                  </time>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </article>

  {
    hasAside && (
      <aside class="note-aside" aria-label="Around this note">
        {showGraph && (
          <section class="note-nearby" aria-labelledby="note-nearby-heading">
            <h2 class="notes-label" id="note-nearby-heading">
              nearby
            </h2>
            <div class="notes-slip note-nearby__graph">
              <InteractiveGraph
                client:visible
                data={neighbourhood}
                globalData={deriveNoteGraph(index)}
                currentId={document.id}
              />
            </div>
          </section>
        )}
        {showOutline && (
          <section class="note-outline">
            <h2 class="notes-label" id="note-outline-heading">
              on this page
            </h2>
            <nav
              class="note-outline__scroll"
              aria-labelledby="note-outline-heading"
              data-toc-spy
              data-toc-follow
            >
              <ol class="note-outline__list" role="list">
                {rendered.headings.map((heading) => (
                  <li
                    class={`note-outline__item note-outline__item--depth-${heading.depth}`}
                  >
                    <a href={`#${heading.id}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </section>
        )}
      </aside>
    )
  }

  {
    backlinks.length + related.length > 0 && (
      <section class="note-keep" aria-labelledby="note-keep-heading">
        <h2 class="notes-label" id="note-keep-heading">
          keep reading
        </h2>
        <ol class="note-cards" role="list">
          {backlinks.map((note) => (
            <NoteCard {note} {index} kicker="links here" />
          ))}
          {related.map((note) => (
            <NoteCard {note} {index} kicker="similar" />
          ))}
        </ol>
      </section>
    )
  }
</div>
