---
import type { GardenDocument, GardenIndex } from '@lib/garden';
import { hasLocalMap } from '@lib/garden/local-map';
import { renderNote } from '@lib/garden/render';
import { bodyProvidesTitleHeading, formatNoteDate } from '@lib/garden/utils';
import LocalNoteMap from './LocalNoteMap.astro';
import NoteBacklinks from './NoteBacklinks.astro';
import NoteTableOfContents from './NoteTableOfContents.astro';
import RelatedNotes from './RelatedNotes.astro';
import '../../styles/components/_note-prose.css';

interface Props {
  document: GardenDocument;
  index: GardenIndex;
}

const { document, index } = Astro.props;
const rendered = document.body.trim()
  ? renderNote(document.body, { wikiLinkHrefs: index.wikiLinkHrefs })
  : { html: '', headings: [] };
const tocHeadings = rendered.headings.length >= 2 ? rendered.headings : [];

const isRoot = document.id === index.root.id;
// Like Explorer: a trailing › only when this page is a folder with contents.
const hasNestedContents = document.childIds.length > 0;

// Breadcrumb trail: the folders between the notes root and this page.
const ancestors: GardenDocument[] = [];
if (!isRoot) {
  let cursor = document.parentId
    ? index.byId.get(document.parentId)
    : undefined;
  while (cursor && cursor.id !== index.root.id) {
    ancestors.unshift(cursor);
    cursor = cursor.parentId ? index.byId.get(cursor.parentId) : undefined;
  }
}

// A note whose body opens with its own `# h1` supplies the page title itself;
// otherwise the shell provides it, so every note page has exactly one h1.
const showShellTitle = !bodyProvidesTitleHeading(document.body);
let authoredTitleHtml = '';
let bodyHtml = rendered.html;
if (!showShellTitle) {
  const titleEnd = bodyHtml.indexOf('</h1>');
  if (titleEnd >= 0) {
    authoredTitleHtml = bodyHtml.slice(0, titleEnd + '</h1>'.length);
    bodyHtml = bodyHtml.slice(titleEnd + '</h1>'.length).trimStart();
  }
}
const isStub = !rendered.html && document.childIds.length === 0;
const hasSupplementary = Astro.slots.has('default');
---

<div class="garden-document-layout">
  <article class="garden-document">
    {
      !isRoot && (
        <header class="garden-document__header">
          <nav class="garden-breadcrumbs" aria-label="breadcrumb">
            <ol class="garden-breadcrumbs__list">
              <li class="garden-breadcrumbs__item">
                <a
                  class="garden-breadcrumbs__crumb"
                  href="/notes"
                  data-page-preview-ignore
                >
                  notes
                </a>
              </li>
              {ancestors.map((ancestor) => (
                <li class="garden-breadcrumbs__item">
                  <span
                    class="garden-breadcrumbs__separator"
                    aria-hidden="true"
                  >
                    ›
                  </span>
                  <a
                    class="garden-breadcrumbs__crumb"
                    href={ancestor.href}
                    data-page-preview-ignore
                  >
                    {ancestor.title}
                  </a>
                </li>
              ))}
              <li class="garden-breadcrumbs__item">
                <span class="garden-breadcrumbs__separator" aria-hidden="true">
                  ›
                </span>
                <span class="garden-breadcrumbs__crumb" aria-current="page">
                  {document.title}
                </span>
                {hasNestedContents && (
                  <span
                    class="garden-breadcrumbs__separator"
                    aria-hidden="true"
                  >
                    ›
                  </span>
                )}
              </li>
            </ol>
          </nav>
          <p class="garden-document__tended">
            updated{' '}
            <time datetime={document.updated}>
              {formatNoteDate(document.updated)}
            </time>
          </p>
        </header>
      )
    }
    {showShellTitle && <h1 class="garden-document__title">{document.title}</h1>}
    {
      authoredTitleHtml && (
        <div
          class="prose garden-document__authored-title"
          set:html={authoredTitleHtml}
        />
      )
    }
    <NoteTableOfContents headings={tocHeadings} variant="mobile" />
    {
      bodyHtml && (
        <div
          class:list={[
            'prose',
            'garden-document__body',
            authoredTitleHtml && 'garden-document__body--continuation',
          ]}
          set:html={bodyHtml}
        />
      )
    }
    {
      isStub && (
        <p class="garden-document__stub">
          this note is still a stub — nothing here yet.
        </p>
      )
    }
  </article>

  <aside class="note-context" aria-label={`Context for ${document.title}`}>
    <div class="note-context__inner">
      <NoteTableOfContents headings={tocHeadings} variant="rail" />
      {
        hasSupplementary && (
          <div class="note-context__supplementary">
            <slot />
          </div>
        )
      }
      <NoteBacklinks document={document} index={index} />
      <RelatedNotes document={document} index={index} />
      {
        /* Any note with a neighbourhood — see `hasLocalMap`, which the
           landscape's "bearings" link asks too so it never points at a
           missing anchor. */
        hasLocalMap(document, index) && (
          <LocalNoteMap document={document} index={index} />
        )
      }
    </div>
  </aside>
</div>
