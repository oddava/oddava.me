---
import type { GardenDocument, GardenIndex } from '@lib/garden';
import { hasLocalMap } from '@lib/garden/local-map';
import { renderNote } from '@lib/garden/render';
import {
  bodyProvidesTitleHeading,
  shouldShowNoteTitle,
  formatNoteDate,
} from '@lib/garden/utils';
import LocalNoteMap from './LocalNoteMap.astro';
import NoteTableOfContents from './NoteTableOfContents.astro';
import RelatedNotes from './RelatedNotes.astro';
import InteractiveGraph from './InteractiveGraph';
import { deriveNoteGraph } from '@lib/garden/graph';
import { describeConnections, noteNeighbourIds } from '@lib/garden/wayfinder';
import '../../styles/components/_note-prose.css';
import NotePageIcon from '../NotePageIcon';

interface Props {
  document: GardenDocument;
  index: GardenIndex;
}

const { document, index } = Astro.props;
const rendered = document.body.trim()
  ? renderNote(document.body, { wikiLinkHrefs: index.wikiLinkHrefs })
  : { html: '', headings: [] };
const tocHeadings = rendered.headings.length >= 2 ? rendered.headings : [];

const isRoot = document.id === index.root.id;

// A note whose body opens with its own `# h1` supplies the page title itself;
// otherwise the shell provides it only when there is content to introduce.
const showShellTitle = shouldShowNoteTitle(document.body);
let authoredTitleHtml = '';
let bodyHtml = rendered.html;
if (bodyProvidesTitleHeading(document.body)) {
  const titleEnd = bodyHtml.indexOf('</h1>');
  if (titleEnd >= 0) {
    authoredTitleHtml = bodyHtml.slice(0, titleEnd + '</h1>'.length);
    bodyHtml = bodyHtml.slice(titleEnd + '</h1>'.length).trimStart();
  }
}
const isStub = !rendered.html && document.childIds.length === 0;

const neighbourCount = noteNeighbourIds(document, index).length;
---

<div class="garden-document-layout">
  {
    /* Rail first in the tree so the wide layout can pin it left without
       fighting source-order placement. On narrow screens grid areas still
       stack the article above it. */
  }
  <aside class="note-context" aria-label={`Context for ${document.title}`}>
    <div class="note-context__inner">
      <div class="note-context__graph">
        <InteractiveGraph
          client:visible
          data={deriveNoteGraph(index, document.id)}
          globalData={deriveNoteGraph(index)}
          currentId={document.id}
        />
      </div>
      <NoteTableOfContents headings={tocHeadings} variant="rail" />
      <RelatedNotes document={document} index={index} />
      {
        /* Narrow screens end the note with one card, reading outward: this
           note's contents, what it links to (standing in for the hidden
           graph), then every note by folder. The wide rail has its own
           contents and the live graph, so there only the folder browser
           shows, as a plain rail section. */
      }
      <div class="note-wayfinder">
        <NoteTableOfContents headings={tocHeadings} variant="mobile" />
        <a
          class="note-wayfinder__row note-context__graph-link"
          data-page-preview-ignore
          href={`/notes/graph#place=${encodeURIComponent(document.id)}`}
        >
          <svg
            class="note-wayfinder__icon"
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <path d="M6 12.3 8.7 7.2M11.6 7l2.5 3.5M7.5 14.3l5.5-1"></path>
            <circle cx="4.75" cy="14.75" r="2.25"></circle>
            <circle cx="10" cy="4.75" r="2.25"></circle>
            <circle cx="15.75" cy="12.75" r="2.25"></circle>
          </svg>
          <span class="note-wayfinder__text">
            <span class="note-wayfinder__title">Connections</span>
            <span class="note-wayfinder__meta">
              {describeConnections(neighbourCount)}
            </span>
          </span>
          <svg
            class="note-wayfinder__affordance"
            viewBox="0 0 16 16"
            aria-hidden="true"
          >
            <path d="M5.5 10.5 10.5 5.5M6.5 5.5h4v4"></path>
          </svg>
        </a>
        {
          /* Keep the explorer in the existing rail. Its anchor also serves
             the landscape's nearby link; linked notes retain inbound
             navigation. */
          hasLocalMap(document, index) && (
            <LocalNoteMap document={document} index={index} />
          )
        }
      </div>
    </div>
  </aside>

  <article class="garden-document">
    <NotePageIcon icon={document.data.icon} />
    {showShellTitle && <h1 class="garden-document__title">{document.title}</h1>}
    {
      authoredTitleHtml && (
        <div
          class="prose garden-document__authored-title"
          set:html={authoredTitleHtml}
        />
      )
    }
    {
      bodyHtml && (
        <div
          class:list={[
            'prose',
            'garden-document__body',
            authoredTitleHtml && 'garden-document__body--continuation',
          ]}
          set:html={bodyHtml}
        />
      )
    }
    {
      isStub && (
        <p class="garden-document__stub">
          this note is still a stub — nothing here yet.
        </p>
      )
    }
    {
      !isRoot && (
        <p class="garden-document__tended">
          edited{' '}
          <time datetime={document.updated}>
            {formatNoteDate(document.updated)}
          </time>
        </p>
      )
    }
  </article>
</div>
