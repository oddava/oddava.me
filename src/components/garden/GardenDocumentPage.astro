---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import type { GardenDocument, GardenIndex } from '@lib/garden';
import { mdxComponents } from '../mdx/components';
import NoteContents from './NoteContents.astro';

interface Props {
  entry: CollectionEntry<'notes'>;
  document: GardenDocument;
  index: GardenIndex;
}

const { entry, document, index } = Astro.props;
const { Content } = await render(entry);
---

<article class="garden-document">
  {
    document.body.trim() && (
      <div class="prose garden-document__body">
        <Content components={mdxComponents} />
      </div>
    )
  }

  <NoteContents document={document} index={index} />
</article>
