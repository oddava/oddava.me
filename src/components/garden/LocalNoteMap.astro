---
import type { GardenDocument, GardenIndex } from '@lib/garden';
import {
  deriveLocalMap,
  summarizeLocalMap,
  type LocalMapStop,
} from '@lib/garden/local-map';
import { NOTES_GRAPH_PATH } from '@lib/site-routes';
import '../../styles/components/_local-map.css';

interface Props {
  document: GardenDocument;
  index: GardenIndex;
}

const { document, index } = Astro.props;
const map = deriveLocalMap(document, index);

const landscapeHref = `${NOTES_GRAPH_PATH}#place=${encodeURIComponent(document.id)}`;

/** One row of the strip map: a station on the trunk, or something hanging off it. */
type StopKind =
  'ancestor' | 'current' | 'child' | 'more' | 'outbound' | 'backlink';

interface Row {
  kind: StopKind;
  href: string;
  title: string;
  /** Spoken form — carries the relationship, which the drawing carries visually. */
  label: string;
  /** Written form for the readout, in the map's own shorthand. */
  detail: string;
}

const rows: Row[] = [];

if (map) {
  for (const stop of map.ancestors) {
    const where =
      stop.distance === 1 ? 'parent folder' : `${stop.distance} levels up`;
    rows.push({
      kind: 'ancestor',
      href: stop.document.href,
      title: stop.document.title,
      label: `${where}: ${stop.document.title}`,
      detail: `↑ ${where}`,
    });
  }

  rows.push({
    kind: 'current',
    href: landscapeHref,
    title: document.title,
    label: `Open the full notes map, focused on ${document.title}`,
    detail: '↗ open the full map',
  });

  const childRow = (stop: LocalMapStop): Row => ({
    kind: 'child',
    href: stop.document.href,
    title: stop.document.title,
    label: `inside this folder: ${stop.document.title}`,
    detail: '↳ inside this folder',
  });
  rows.push(...map.children.map(childRow));

  const hiddenChildren = map.totals.children - map.children.length;
  if (hiddenChildren > 0) {
    rows.push({
      kind: 'more',
      href: landscapeHref,
      title: `+${hiddenChildren} more inside`,
      label: `See ${hiddenChildren} more notes inside ${document.title} on the full map`,
      detail: '↗ the rest are on the full map',
    });
  }

  for (const stop of map.references) {
    const outbound = stop.relationship === 'outbound';
    rows.push({
      kind: outbound ? 'outbound' : 'backlink',
      href: stop.document.href,
      title: stop.document.title,
      label: outbound
        ? `linked from this note: ${stop.document.title}`
        : `links back to this note: ${stop.document.title}`,
      detail: outbound ? '→ linked from here' : '← links back here',
    });
  }
}

const readout = map ? summarizeLocalMap(map) : '';

// Drawing coordinates, in the 26×26 box each row reserves for its marker. The
// trunk sits at x=9 in both the SVG and the CSS rule that continues it between
// rows, so the two must move together. Traces leave the trunk at 45°, which is
// what keeps a map of five notes looking drafted rather than sketched.
const TRACE: Partial<Record<StopKind, string>> = {
  child: 'M9 8.6 L13.4 13 H16',
  more: 'M9 8.6 L13.4 13 H16',
  outbound: 'M9 8.6 L13.4 13 H16.6',
  backlink: 'M21 8.6 L16.6 13 H13.6',
};

// Light travels the way meaning does: out along a branch, up the trunk toward a
// parent, inward from off-map for a backlink. Each path is drawn in that
// direction, so one keyframe animates all of them.
const PULSE: Record<StopKind, string> = {
  ancestor: 'M9 26 V0',
  current: 'M9 26 V0',
  child: 'M9 8.6 L13.4 13 H19',
  more: 'M9 8.6 L13.4 13 H19',
  outbound: 'M9 8.6 L13.4 13 H20',
  backlink: 'M21 8.6 L16.6 13 H10.9',
};
---

{
  map && (
    <section
      id="local-map"
      class="local-map note-context__section"
      aria-labelledby="local-map-heading"
      data-local-map
    >
      <h2 id="local-map-heading" class="note-context__label">
        Bearings
      </h2>

      <div
        class:list={[
          'local-map__frame',
          map.ancestorsTruncated && 'local-map__frame--continues',
        ]}
      >
        {map.ancestorsTruncated && (
          <span class="local-map__continues" aria-hidden="true" />
        )}

        <ol class="local-map__stops" role="list">
          {rows.map((row) => (
            <li
              class:list={[
                'local-map__stop',
                `local-map__stop--${row.kind}`,
                (row.kind === 'outbound' || row.kind === 'backlink') &&
                  'local-map__stop--ref',
              ]}
            >
              <a
                class="local-map__link"
                href={row.href}
                aria-label={row.label}
                data-local-map-stop
                data-detail={row.detail}
                data-page-preview-ignore
              >
                <svg
                  class="local-map__mark"
                  viewBox="0 0 26 26"
                  width="26"
                  height="26"
                  aria-hidden="true"
                  focusable="false"
                >
                  {TRACE[row.kind] && (
                    <path
                      class:list={[
                        'local-map__trace',
                        row.kind !== 'child' &&
                          row.kind !== 'more' &&
                          'local-map__trace--ref',
                      ]}
                      d={TRACE[row.kind]}
                    />
                  )}

                  {row.kind === 'outbound' && (
                    <path
                      class="local-map__arrow"
                      d="M17 10.3 L19.9 13 L17 15.7"
                    />
                  )}
                  {row.kind === 'backlink' && (
                    <path
                      class="local-map__arrow"
                      d="M13.6 10.3 L10.7 13 L13.6 15.7"
                    />
                  )}

                  {row.kind === 'current' && (
                    <circle class="local-map__ring" cx="9" cy="13" r="6.6" />
                  )}
                  {row.kind === 'current' && (
                    <circle
                      class="local-map__dot local-map__dot--here"
                      cx="9"
                      cy="13"
                      r="3.4"
                    />
                  )}
                  {row.kind === 'ancestor' && (
                    <circle class="local-map__dot" cx="9" cy="13" r="2.4" />
                  )}
                  {(row.kind === 'child' || row.kind === 'more') && (
                    <circle
                      class:list={[
                        'local-map__dot',
                        row.kind === 'more' && 'local-map__dot--more',
                      ]}
                      cx="19"
                      cy="13"
                      r="2.4"
                    />
                  )}

                  <path
                    class="local-map__pulse"
                    d={PULSE[row.kind]}
                    pathLength="1"
                  />
                </svg>

                <span class="local-map__title">{row.title}</span>

                {row.kind === 'current' && (
                  <span class="local-map__zoom" aria-hidden="true">
                    ↗
                  </span>
                )}
              </a>
            </li>
          ))}
        </ol>
      </div>

      <p class="local-map__readout" data-local-map-readout aria-hidden="true">
        {readout}
      </p>
    </section>
  )
}

<script>
  // Everything visual — dimming, the travelling pulse, the hover states — is CSS.
  // Script covers only what CSS cannot see: which stop is under the pointer, so
  // the readout can name the relationship the drawing is showing. Nothing here
  // animates on its own; the map moves only in answer to a pointer or a key.
  const maps = document.querySelectorAll<HTMLElement>('[data-local-map]');

  for (const map of maps) {
    const readout = map.querySelector<HTMLElement>('[data-local-map-readout]');
    const stops = Array.from(
      map.querySelectorAll<HTMLAnchorElement>('[data-local-map-stop]'),
    );
    if (!readout || stops.length === 0) continue;

    const census = (readout.textContent ?? '').trim();
    const stillMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const write = (text: string) => {
      if (readout.textContent === text) return;
      readout.textContent = text;
      // A swap this small reads as a glitch without a beat of movement; the Web
      // Animations API keeps it off the CSP-blocked inline-style path.
      if (!stillMotion.matches) {
        readout.animate(
          [
            { opacity: 0.25, transform: 'translateY(2px)' },
            { opacity: 1, transform: 'none' },
          ],
          { duration: 220, easing: 'cubic-bezier(0.2, 0.75, 0.25, 1)' },
        );
      }
    };

    const describe = (stop: HTMLAnchorElement | null) =>
      write(stop?.dataset.detail ?? census);

    const restore = () => {
      const focused = document.activeElement?.closest<HTMLAnchorElement>(
        '[data-local-map-stop]',
      );
      describe(focused && map.contains(focused) ? focused : null);
    };

    stops.forEach((stop, stopIndex) => {
      stop.addEventListener('pointerenter', () => describe(stop));
      stop.addEventListener('focus', () => describe(stop));
      stop.addEventListener('keydown', (event) => {
        let nextIndex: number | null = null;
        if (event.key === 'ArrowUp') nextIndex = stopIndex - 1;
        else if (event.key === 'ArrowDown') nextIndex = stopIndex + 1;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = stops.length - 1;

        // Wrapping would let a held arrow key cycle forever; the map is a short
        // line, and running off its end should hand the page back.
        if (nextIndex === null || nextIndex < 0 || nextIndex >= stops.length) {
          return;
        }
        event.preventDefault();
        stops[nextIndex]?.focus();
      });
    });

    map.addEventListener('pointerleave', restore);
    map.addEventListener('focusout', () => {
      window.requestAnimationFrame(restore);
    });
  }
</script>
