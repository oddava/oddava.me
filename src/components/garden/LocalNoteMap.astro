---
import type { GardenDocument, GardenIndex } from '@lib/garden';
import { deriveLocalMap } from '@lib/garden/local-map';
import { NOTES_GRAPH_PATH } from '@lib/site-routes';
import { compactTrail, folderTrail } from '@lib/garden/wayfinder';
import NoteExplorerNode from './NoteExplorerNode.astro';
import '../../styles/components/_local-map.css';

interface Props {
  document: GardenDocument;
  index: GardenIndex;
}

const { document, index } = Astro.props;
const map = deriveLocalMap(document, index);
const expanded = new Set<string>([index.root.id]);
let ancestor: GardenDocument | undefined = document;
while (ancestor && !expanded.has(ancestor.id)) {
  expanded.add(ancestor.id);
  ancestor = ancestor.parentId ? index.byId.get(ancestor.parentId) : undefined;
}
const hiddenReferences = map
  ? map.totals.outbound + map.totals.backlinks - map.references.length
  : 0;
const landscapeHref = `${NOTES_GRAPH_PATH}#place=${encodeURIComponent(document.id)}`;
const trail = folderTrail(document, index);
const isRoot = trail.length === 0;
const crumbs = compactTrail(trail);
---

<nav
  id="local-map"
  class="note-explorer note-context__section"
  aria-label="Notes explorer"
>
  <details class="note-explorer__browser">
    <summary
      class="note-explorer__summary note-wayfinder__row"
      title="Browse notes by folder"
    >
      {
        /* Where you are, and the tree on tap — the same row in the rail and
          in the narrow-screen footer. */
      }
      <svg class="note-wayfinder__icon" viewBox="0 0 20 20" aria-hidden="true">
        <path
          d="M3 6.25C3 5.28 3.78 4.5 4.75 4.5h3.1l1.9 2h5.5c.97 0 1.75.78 1.75 1.75v6c0 .97-.78 1.75-1.75 1.75H4.75C3.78 16 3 15.22 3 14.25Z"
        ></path>
      </svg>
      <span class="note-wayfinder__text">
        <span class="note-wayfinder__title">Browse notes</span>
        {
          isRoot ? (
            <span class="note-wayfinder__meta">
              {index.documents.length} notes
            </span>
          ) : (
            <span class="note-wayfinder__meta note-wayfinder__trail">
              {/* set:text, not children: no markup whitespace may reach the
                  breadcrumb, or it would widen the gaps around each "/". */}
              {crumbs.map((title) => (
                <span
                  class:list={[
                    'note-wayfinder__crumb',
                    title === '…' && 'note-wayfinder__crumb--gap',
                  ]}
                  set:text={title}
                />
              ))}
              <span
                class="note-wayfinder__crumb note-wayfinder__here"
                set:text={document.title}
              />
            </span>
          )
        }
      </span>
      <svg
        class="note-wayfinder__affordance note-wayfinder__chevron"
        viewBox="0 0 16 16"
        aria-hidden="true"
      >
        <path d="m6.5 4.5 3.5 3.5-3.5 3.5"></path>
      </svg>
    </summary>
    <div class="note-explorer__scroll">
      <ul class="note-explorer__root" role="list">
        <NoteExplorerNode
          node={index.root}
          {index}
          currentId={document.id}
          {expanded}
        />
      </ul>
      {
        map && (map.references.length > 0 || hiddenReferences > 0) && (
          <div class="note-explorer__references">
            <h2 class="note-context__label">Linked notes</h2>
            <ul role="list">
              {map.references.map((stop) => (
                <li>
                  <a
                    class="note-explorer__row note-explorer__reference"
                    href={stop.document.href}
                    aria-label={`${stop.relationship === 'backlink' ? 'Links to this note' : 'Linked from this note'}: ${stop.document.title}`}
                    title={stop.document.title}
                    data-page-preview-ignore
                  >
                    <span
                      class="note-explorer__reference-direction"
                      aria-hidden="true"
                    >
                      {stop.relationship === 'backlink' ? '↙' : '↗'}
                    </span>
                    <span>{stop.document.title}</span>
                  </a>
                </li>
              ))}
              {hiddenReferences > 0 && (
                <li>
                  <a class="note-explorer__more" href={landscapeHref}>
                    View {hiddenReferences} more linked notes
                  </a>
                </li>
              )}
            </ul>
          </div>
        )
      }
    </div>
  </details>
</nav>
