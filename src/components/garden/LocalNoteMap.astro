---
import type { GardenDocument, GardenIndex } from '@lib/garden';
import { deriveLocalMap } from '@lib/garden/local-map';
import { NOTES_GRAPH_PATH } from '@lib/site-routes';
import NoteExplorerNode from './NoteExplorerNode.astro';
import '../../styles/components/_local-map.css';

interface Props {
  document: GardenDocument;
  index: GardenIndex;
}

const { document, index } = Astro.props;
const map = deriveLocalMap(document, index);
const expanded = new Set<string>([index.root.id]);
let ancestor: GardenDocument | undefined = document;
while (ancestor && !expanded.has(ancestor.id)) {
  expanded.add(ancestor.id);
  ancestor = ancestor.parentId ? index.byId.get(ancestor.parentId) : undefined;
}
const hiddenReferences = map
  ? map.totals.outbound + map.totals.backlinks - map.references.length
  : 0;
const landscapeHref = `${NOTES_GRAPH_PATH}#place=${encodeURIComponent(document.id)}`;
---

<nav
  id="local-map"
  class="note-explorer note-context__section"
  aria-label="Notes explorer"
>
  <ul class="note-explorer__root" role="list">
    <NoteExplorerNode
      node={index.root}
      {index}
      currentId={document.id}
      {expanded}
    />
  </ul>
  {
    map && (map.references.length > 0 || hiddenReferences > 0) && (
      <div class="note-explorer__references">
        <h2 class="note-context__label">Linked notes</h2>
        <ul role="list">
          {map.references.map((stop) => (
            <li>
              <a
                class="note-explorer__row note-explorer__reference"
                href={stop.document.href}
                aria-label={`${stop.relationship === 'backlink' ? 'Links to this note' : 'Linked from this note'}: ${stop.document.title}`}
                title={stop.document.title}
                data-page-preview-ignore
              >
                <span
                  class="note-explorer__reference-direction"
                  aria-hidden="true"
                >
                  {stop.relationship === 'backlink' ? '↙' : '↗'}
                </span>
                <span>{stop.document.title}</span>
              </a>
            </li>
          ))}
          {hiddenReferences > 0 && (
            <li>
              <a class="note-explorer__more" href={landscapeHref}>
                View {hiddenReferences} more linked notes
              </a>
            </li>
          )}
        </ul>
      </div>
    )
  }
</nav>
