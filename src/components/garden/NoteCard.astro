---
/**
 * One note as an index card: its icon and title, a line or two of its
 * opening text, and a foot with where it lives and when it was last tended.
 * The whole card is the link. Cards lie on the desk a touch askew
 * (`.note-cards`) and straighten under the pointer.
 *
 * Used by the landing (recently tended), tag pages, and under a note (keep
 * reading), where `kicker` says why the card is there.
 */
import type { GardenDocument, GardenIndex } from '@lib/garden';
import { formatNoteDate } from '@lib/garden/utils';
import NoteListIcon from './NoteListIcon.astro';

interface Props {
  note: GardenDocument;
  index: GardenIndex;
  /** Leave out the folder where every card shares it. */
  showFolder?: boolean;
  /** A word on the card's corner: why it is here. */
  kicker?: string;
}

const { note, index, showFolder = true, kicker } = Astro.props;

// A note's summary is its first paragraph; one that only repeats the title
// says nothing more, so it is left out.
const excerpt =
  note.summary.trim().toLowerCase() === note.title.trim().toLowerCase()
    ? ''
    : note.summary;
const parent = note.parentId ? index.byId.get(note.parentId) : undefined;
const folder = showFolder && parent && parent.id !== index.root.id && parent;
const pages = note.childIds.length;
---

<li class="note-card">
  <a class="note-card__link" href={note.href} data-page-preview-ignore>
    {kicker && <span class="notes-sticker note-card__kicker">{kicker}</span>}
    <span class="note-card__head">
      <NoteListIcon icon={note.data.icon} folder={pages > 0} />
      <span class="note-card__title">{note.title}</span>
    </span>
    {excerpt && <span class="note-card__excerpt">{excerpt}</span>}
    <span class="note-card__foot">
      {folder && <span>in {folder.title}</span>}
      {pages > 0 && <span>{pages} inside</span>}
      <time datetime={note.updated}>
        {formatNoteDate(note.updated, 'short')}
      </time>
    </span>
  </a>
</li>
