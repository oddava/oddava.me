---
/**
 * The layout for a notes page: the notes host's own shell there, and the
 * personal site's Base layout (unchanged) on the apex.
 */
import Base from '../../layouts/Base.astro';
import NotesLayout from '../../layouts/NotesLayout.astro';
import type { Props as SiteHeadProps } from '../SiteHead.astro';
import { isNotesHostRequest } from '@lib/server/core';

export interface Props extends SiteHeadProps {
  wide?: boolean;
}

const onNotesHost = isNotesHostRequest(Astro.url);
---

{
  onNotesHost ? (
    <NotesLayout {...Astro.props}>
      <slot name="head" slot="head" />
      <slot />
    </NotesLayout>
  ) : (
    <Base {...Astro.props}>
      <slot name="head" slot="head" />
      <slot />
    </Base>
  )
}
