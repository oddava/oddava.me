---
import type { GardenDocument, GardenIndex } from '@lib/garden';

interface Props {
  document: GardenDocument;
  index: GardenIndex;
}

const { document, index } = Astro.props;
const sources = document.backlinks
  .map((id) => index.byId.get(id))
  .filter((source): source is GardenDocument => Boolean(source));
---

{
  sources.length > 0 && (
    <section
      class="note-links"
      aria-label={`Notes that link to ${document.title}`}
    >
      <h2 class="note-links__label">Backlinks</h2>
      <ul class="note-links__list">
        {sources.map((source) => (
          <li class="note-link">
            <a href={source.href} class="note-link__anchor">
              <span class="note-link__title">{source.title}</span>
              {source.summary && (
                <span class="note-link__summary">{source.summary}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
