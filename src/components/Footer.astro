---
/**
 * Site footer: the floor the page ends on, with the cat asleep on it. Only
 * pages under the quiet sky have one — a floor with no cat on it reads as a
 * stray rule.
 */
---

<footer class="site-footer" aria-hidden="true">
  <div class="site-footer__floor">
    <canvas class="site-footer__nap" data-quiet-nap></canvas>
  </div>
</footer>
