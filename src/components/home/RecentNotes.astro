---
/**
 * Home's notes: the latest few, one row each — title, then topic and day —
 * and a way to the rest. A server island over the same Redis-backed index
 * every /notes page reads. Links are the garden's own hrefs, so they follow
 * wherever notes are served.
 */
import { getGardenIndexOrUnavailable } from '@lib/garden';
import { pickRecentNotes, type HomeNote } from '../../lib/home';

const garden = await getGardenIndexOrUnavailable();
const notes: HomeNote[] | null = garden.ok
  ? pickRecentNotes(garden.index.documents, garden.index.root)
  : null;
const allHref = garden.ok ? garden.index.root.href : undefined;

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00Z`)
    .toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    })
    .toLowerCase();
---

{
  notes === null ? (
    <p class="home-empty">the notes are resting just now.</p>
  ) : notes.length === 0 ? (
    <p class="home-empty">nothing written yet.</p>
  ) : (
    <>
      <ol class="note-rows">
        {notes.map((note) => (
          <li>
            <a class="note-row" href={note.href} data-page-preview-ignore>
              <span class="note-row__title">{note.title}</span>
              <span class="note-row__meta">
                {note.topic && (
                  <span class="note-row__topic">{note.topic}</span>
                )}
                {note.date && (
                  <time datetime={note.date}>{formatDate(note.date)}</time>
                )}
              </span>
            </a>
          </li>
        ))}
      </ol>
      <a class="home-more" href={allHref}>
        all notes<span aria-hidden="true">→</span>
      </a>
    </>
  )
}
