---
/**
 * Home's latest notes: a server island over the same Redis-backed garden
 * index every /notes page reads, so a Studio save is here on the next visit.
 * Links are the garden's own hrefs, which follow wherever notes are served.
 */
import { getGardenIndexOrUnavailable } from '@lib/garden';
import { pickLatestNotes, type HomeNote } from '../../lib/home';

const garden = await getGardenIndexOrUnavailable();
const notes: HomeNote[] | null = garden.ok
  ? pickLatestNotes(garden.index.documents, garden.index.root.id)
  : null;

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00Z`)
    .toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    })
    .toLowerCase();
---

{
  notes === null ? (
    <p class="home-empty">the notes are resting just now.</p>
  ) : notes.length === 0 ? (
    <p class="home-empty">nothing written yet.</p>
  ) : (
    <ol class="home-notes">
      {notes.map((note) => (
        <li>
          <a class="home-note" href={note.href}>
            <span class="home-note__title">{note.title}</span>
            {note.date && (
              <time class="home-note__date" datetime={note.date}>
                {formatDate(note.date)}
              </time>
            )}
          </a>
        </li>
      ))}
    </ol>
  )
}
