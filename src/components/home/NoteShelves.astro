---
/**
 * Home's notes, by topic: each top-level folder of the garden with its newest
 * note — title, summary, when it was last updated — and how many more the
 * folder holds. A server island over the same Redis-backed index every /notes
 * page reads. Links are the garden's own hrefs, so they follow wherever notes
 * are served.
 */
import { getGardenIndexOrUnavailable } from '@lib/garden';
import { pickNoteShelves, type HomeShelf } from '../../lib/home';

const garden = await getGardenIndexOrUnavailable();
const shelves: HomeShelf[] | null = garden.ok
  ? pickNoteShelves(garden.index.documents, garden.index.root)
  : null;

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00Z`)
    .toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    })
    .toLowerCase();
---

{
  shelves === null ? (
    <p class="home-empty">the notes are resting just now.</p>
  ) : shelves.length === 0 ? (
    <p class="home-empty">nothing written yet.</p>
  ) : (
    <ul class="shelves">
      {shelves.map((shelf) => (
        <li class="shelf">
          <a class="shelf__topic" href={shelf.href}>
            <span class="shelf__topic-name">{shelf.topic}</span>
            {shelf.more > 0 && (
              <span class="shelf__more">+{shelf.more} more</span>
            )}
          </a>
          <article class="shelf__note">
            <h3 class="shelf__title">
              <a href={shelf.latest.href}>{shelf.latest.title}</a>
            </h3>
            {shelf.latest.summary && (
              <p class="shelf__summary">{shelf.latest.summary}</p>
            )}
            {shelf.latest.date && (
              <p class="shelf__date">
                Updated{' '}
                <time datetime={shelf.latest.date}>
                  {formatDate(shelf.latest.date)}
                </time>
              </p>
            )}
          </article>
        </li>
      ))}
    </ul>
  )
}
