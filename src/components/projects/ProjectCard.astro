---
/**
 * One gallery card: the screenshot in a lit tray (or the empty tray with the
 * project's initial), one line under it — name, year, links — and what it is
 * under that. The whole card links to the project in the same tab — it is
 * the card's one main action; site and source stay their own links, opening
 * a new tab and saying so. Shared by /projects and home's strip so both
 * speak the same card.
 */
import type { Project } from '../../lib/contracts';
import { displayAttributes } from '../../lib/project-image';

interface Props {
  project: Project;
  /** The one image that can be on screen at load. */
  eager?: boolean;
  /** The name's heading level under the page's own headings. */
  heading?: 'h2' | 'h3';
  class?: string;
}

const {
  project,
  eager = false,
  heading: Heading = 'h2',
  class: className,
} = Astro.props;
const href = project.site ?? project.source;
const contain = project.image?.fit === 'contain';
const display = project.image ? displayAttributes(project.image) : {};
const hostOf = (url: string) => new URL(url).host;
---

<li
  class:list={[
    'pcard',
    !project.image && 'pcard--blank',
    contain && 'pcard--contain',
    className,
  ]}
>
  <div class="pcard__media">
    {
      project.image ? (
        <div class="pcard__shot">
          <img
            class="pcard__img"
            {...display}
            src={project.image.src}
            alt={project.image.alt}
            width="1600"
            height="1200"
            loading={eager ? 'eager' : 'lazy'}
            fetchpriority={eager ? 'high' : 'auto'}
            decoding="async"
            draggable="false"
          />
        </div>
      ) : (
        <span class="pcard__glyph" aria-hidden="true">
          {project.name.charAt(0).toLowerCase()}
        </span>
      )
    }
  </div>
  <div class="pcard__body">
    <div class="pcard__title">
      <Heading class="pcard__name">
        {
          href ? (
            <a href={href} draggable="false">
              {project.name}
            </a>
          ) : (
            project.name
          )
        }
      </Heading>
      <span
        class:list={[
          'pcard__year',
          project.year === 'now' && 'pcard__year--now',
        ]}
      >
        {project.year}
      </span>
    </div>
    {
      href && (
        <ul class="pcard__links">
          {project.site && (
            <li>
              <a
                href={project.site}
                target="_blank"
                rel="noopener noreferrer"
                draggable="false"
              >
                {hostOf(project.site)}
                <span class="sr-only"> (opens in new tab)</span>
              </a>
            </li>
          )}
          {project.source && (
            <li>
              <a
                href={project.source}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.name} source code (opens in new tab)`}
                draggable="false"
              >
                source
              </a>
            </li>
          )}
        </ul>
      )
    }
  </div>
  {
    (project.description || project.stack.length > 0) && (
      <div class="pcard__about">
        {project.description && (
          <p class="pcard__description">{project.description}</p>
        )}
        {project.stack.length > 0 && (
          <ul class="pcard__stack" aria-label="built with">
            {project.stack.map((tool) => (
              <li>{tool}</li>
            ))}
          </ul>
        )}
      </div>
    )
  }
</li>
