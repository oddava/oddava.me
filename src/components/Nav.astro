---
/**
 * Site navigation bar.
 */
import { getPublicNavigationRoutes } from '../lib/site-routes';

const routes = getPublicNavigationRoutes();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActiveRoute(route: string): boolean {
  if (route === '/') {
    return currentPath === '/';
  }

  return currentPath === route || currentPath.startsWith(`${route}/`);
}
---

<nav class="site-nav" aria-label="Primary navigation">
  <div class="site-nav__track">
    {
      routes.map((route) => (
        <a
          href={route.href}
          class:list={[
            'site-nav__link',
            route.isHome && 'site-nav__link--home',
            isActiveRoute(route.href) && 'is-active',
          ]}
          aria-current={isActiveRoute(route.href) ? 'page' : undefined}
        >
          <span class="site-nav__label">{route.label}</span>
        </a>
      ))
    }
  </div>
</nav>
