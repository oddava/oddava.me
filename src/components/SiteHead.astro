---
import {
  SITE_AUTHOR_NAME,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TWITTER_HANDLE,
} from '../lib/site';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  modifiedTime?: string;
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  // Default OG/social image. PNG rendered from public/og-default.svg (the
  // diffable source) — SVG itself is not parsed by every consumer.
  image = '/og-default.png',
  imageAlt = `${SITE_NAME} social preview`,
  type = 'website',
  modifiedTime,
} = Astro.props;

const pageTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
// Pin canonical to the site origin + pathname so trailing-slash drift
// (and dev/preview host drift) cannot split the canonical from production.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const socialImage = new URL(image, Astro.site ?? Astro.url).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="author" content={SITE_AUTHOR_NAME} />
<title>{pageTitle}</title>
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={socialImage} />
<meta property="og:image:secure_url" content={socialImage} />
<meta property="og:image:alt" content={imageAlt} />
{
  type === 'article' && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE_TWITTER_HANDLE} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<link
  rel="alternate"
  type="application/rss+xml"
  title="oddava writing"
  href="/rss.xml"
/>
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Preload critical fonts -->
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/m-plus-rounded-1c-latin-400-normal.woff2"
  crossorigin
  fetchpriority="high"
/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/m-plus-rounded-1c-latin-700-normal.woff2"
  crossorigin
  fetchpriority="high"
/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/jetbrains-mono-latin-400-normal.woff2"
  crossorigin
  fetchpriority="high"
/>

<slot />
