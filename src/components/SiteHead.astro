---
import DocumentTheme from './DocumentTheme.astro';
import { notesHostPathFor } from '../lib/notes-host';
import { isNotesHostRequest } from '../lib/server/core';
import {
  SITE_AUTHOR_NAME,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_ROLE,
  SITE_TITLE,
  SITE_TWITTER_HANDLE,
  SITE_URL,
} from '../lib/site';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  modifiedTime?: string;
  /**
   * `body` preloads only the roman serif and the sans; `all` adds the italic
   * (the personal pages set their titles in it). The notes host uses `body`.
   */
  fontPreloads?: 'all' | 'body';
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  // Default OG/social image, rendered from scripts/og-default-card.ts by
  // `pnpm run og:render`.
  image = '/og-default.png',
  imageAlt = SITE_TITLE,
  type = 'website',
  modifiedTime,
  fontPreloads = 'all',
} = Astro.props;

const pageTitle = title === SITE_NAME ? SITE_TITLE : `${title} | ${SITE_NAME}`;
// Pin canonical to the site origin + pathname so trailing-slash drift
// (and dev/preview host drift) cannot split the canonical from production.
// On the notes host the page renders at its in-app `/notes/…` path; the
// canonical is the path visitors see there, on that origin. Prerendered pages
// render as `about.html` / `index.html`, which is not the URL they are served
// at, so the file suffix is dropped.
const onNotesHost = isNotesHostRequest(Astro.url);
const canonicalOrigin = onNotesHost
  ? Astro.url.origin
  : (Astro.site ?? Astro.url);
const canonicalPath = onNotesHost
  ? notesHostPathFor(Astro.url.pathname)
  : Astro.url.pathname.replace(/(?:^|\/)index\.html$|\.html$/, '') || '/';
const canonicalUrl = new URL(canonicalPath, canonicalOrigin).href;
const socialImage = new URL(image, canonicalOrigin).href;
// Lets search engines show the site name and tie the profiles to one person.
const structuredData =
  Astro.url.pathname === '/'
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_NAME,
        alternateName: 'oddava.me',
        url: `${SITE_URL}/`,
        description: SITE_DESCRIPTION,
        author: {
          '@type': 'Person',
          name: SITE_AUTHOR_NAME,
          jobTitle: SITE_ROLE,
          url: `${SITE_URL}/about`,
          sameAs: ['https://github.com/oddava', 'https://x.com/oddava'],
        },
      })
    : null;
---

<meta charset="utf-8" />
<DocumentTheme />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="author" content={SITE_AUTHOR_NAME} />
<title>{pageTitle}</title>
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={socialImage} />
<meta property="og:image:secure_url" content={socialImage} />
<meta property="og:image:alt" content={imageAlt} />
{
  type === 'article' && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE_TWITTER_HANDLE} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_NAME} | notes`}
  href="/rss.xml"
/>
<link rel="sitemap" href="/sitemap-index.xml" />
{
  structuredData && (
    <script is:inline type="application/ld+json" set:html={structuredData} />
  )
}

<!-- Preload the faces every page paints first: the serif for titles and
     prose, the sans for the header and meta. Italic and mono load from CSS
     when a page uses them, unless the page asks for the italic up front. -->
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/alegreya-latin-wght-normal.woff2"
  crossorigin
  fetchpriority="high"
/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/alegreya-sans-latin-400-normal.woff2"
  crossorigin
  fetchpriority="high"
/>
{
  fontPreloads === 'all' && (
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/alegreya-latin-wght-italic.woff2"
      crossorigin
    />
  )
}

<slot />
