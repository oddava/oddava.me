---
import Base from '../layouts/Base.astro';
import '../styles/components/_status-page.css';
---

<Base title="500" description="Something broke on our end.">
  <meta slot="head" name="robots" content="noindex" />
  <section class="status-page">
    <h1>500</h1>
    <p class="status-page__copy">
      something broke on our end. not you — us. try heading back home and giving
      it another go.
    </p>
    <p class="status-page__links">
      <a href="/">← back to home</a>
    </p>
  </section>
</Base>
