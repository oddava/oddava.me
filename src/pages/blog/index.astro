---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { formatPostStats, getPostStats, getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();

function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---
<Base title="writing" description="Things I've written.">
  <ul class="post-list">
    {posts.map((post: any) => (
      <li class="post-item">
        <a href={`/blog/${post.id}`} class="post-item__link">
          <div class="post-item__title">{post.data.title}</div>
          <div class="post-item__footer">
            <div class="post-item__meta">
              <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
              {post.data.updated && (
                <>
                  <span aria-hidden="true"> · </span>
                  <span>updated <time datetime={post.data.updated}>{formatDate(post.data.updated)}</time></span>
                </>
              )}
              <span aria-hidden="true"> · </span>
              <span>{formatPostStats(getPostStats(post.body))}</span>
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>
</Base>
