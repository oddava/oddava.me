---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import {
  formatPostDate,
  getPublishedPosts,
  groupEntriesByYear,
} from '../../lib/content';

const posts = await getPublishedPosts();
const postsByYear = groupEntriesByYear(posts);
---

<Base title="writing" description="Things I've written.">
  <div class="post-archive">
    {
      Object.entries(postsByYear).map(([year, yearPosts]) => (
        <section class="post-year" aria-labelledby={`posts-${year}`}>
          <h2 class="post-year__heading" id={`posts-${year}`}>
            {year}
          </h2>
          <ul class="post-list">
            {yearPosts.map((post) => (
              <li class="post-item">
                <a href={`/blog/${post.id}`} class="post-item__link">
                  <div class="post-item__title">{post.data.title}</div>
                  <div class="post-item__footer">
                    <div class="post-item__meta">
                      <time datetime={post.data.date}>
                        {formatPostDate(post.data.date, 'short')}
                      </time>
                      {post.data.updated && (
                        <>
                          <span aria-hidden="true"> / </span>
                          <span>
                            updated{' '}
                            <time datetime={post.data.updated}>
                              {formatPostDate(post.data.updated, 'short')}
                            </time>
                          </span>
                        </>
                      )}
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
