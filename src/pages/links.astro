---
export const prerender = true;

import Base from '../layouts/Base.astro';
import LinkIcon from '../components/LinkIcon.astro';
import '../styles/components/_links.css';
import linksData from '../data/links.json';

const { profile, links, theme } = linksData;
---

<Base
  title="Links"
  description={`Where to find ${profile.name} online: GitHub, X, email, and notes.`}
  hideNav
  sky
>
  <div class="links-page">
    <section class="links-profile rise">
      <img
        src={profile.avatar}
        alt=""
        class="links-profile__avatar"
        width="64"
        height="64"
        loading="eager"
      />
      <h1 class="links-profile__name">
        <a href="/" data-page-preview-ignore>{profile.name}</a>
      </h1>
      <p class="links-profile__bio">{profile.bio}</p>
    </section>

    <ul class="links-list rise rise--1">
      {
        links.map((link) => {
          const isExternal = link.url.startsWith('http');
          return (
            <li>
              <a
                href={link.url}
                class="links-item"
                data-page-preview-ignore={
                  link.url === '/notes' ? '' : undefined
                }
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                aria-label={
                  isExternal ? `${link.title} (opens in new tab)` : undefined
                }
              >
                <span class="links-item__icon">
                  {theme.showIcons !== false && link.icon && (
                    <LinkIcon name={link.icon} />
                  )}
                </span>
                <span class="links-item__label">{link.title}</span>
                {isExternal && (
                  <span class="links-item__out" aria-hidden="true">
                    ↗
                  </span>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</Base>
