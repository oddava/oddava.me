---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getAnimeFavorites, type AnimeFavoriteEntry } from '../../lib/content';

let animeList: AnimeFavoriteEntry[] = [];
let animeAvailable = true;

try {
  animeList = await getAnimeFavorites();
} catch {
  animeAvailable = false;
}
---

<Base title="anime" description="My favorite anime and watch list.">
  {
    animeAvailable && (
      <ul class="post-list">
        {animeList.map((entry) => (
          <li class="post-item">
            <a
              href={
                entry.anime.url ||
                `https://anilist.co/anime/${entry.anime.slug}`
              }
              class="post-item__link"
            >
              <div class="anime-item">
                <img
                  src={entry.anime.cover_image_small || entry.anime.cover_image}
                  alt={entry.anime.title}
                  class="anime-item__image"
                  loading="lazy"
                />
                <div class="anime-item__content">
                  <div class="post-item__title">{entry.anime.title}</div>
                  <div class="post-item__meta">
                    {entry.anime.title_jp}{' '}
                    {entry.anime.rating && `/ score ${entry.anime.rating}`}
                  </div>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    animeAvailable && animeList.length === 0 && (
      <p class="empty-state">Nothing here yet.</p>
    )
  }

  {
    !animeAvailable && (
      <p class="empty-state">Favorites are offline right now.</p>
    )
  }
</Base>

<style>
  .anime-item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .anime-item__image {
    width: 48px;
    height: 64px;
    object-fit: cover;
    border-radius: 4px;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-rule);
    flex-shrink: 0;
  }

  .anime-item__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
