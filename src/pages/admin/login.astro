---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdminConfigured, isAdminRequest } from '../../lib/server/admin';
import { safeRedirectPath } from '../../lib/server/core';

if (await isAdminRequest(Astro.cookies)) {
  return Astro.redirect('/admin');
}

const configured = isAdminConfigured();
const requestedNext = Astro.url.searchParams.get('next') ?? '/admin';
const next = safeRedirectPath(requestedNext, '/admin');
const invalid = Astro.url.searchParams.get('error') === 'invalid';
const loggedOut = Astro.url.searchParams.get('logged_out') === '1';
---

<AdminLayout title="Login" description="Authenticate to manage oddava.me.">
  <section class="admin-card admin-login">
    <p class="admin-kicker">oddava</p>
    <h1>Sign in</h1>
    <p class="admin-login__intro">
      Use the shared admin token to access the panel.
    </p>
    {
      !configured && (
        <p class="admin-note admin-login__message">
          Set <code>ADMIN_PANEL_TOKEN</code> or{' '}
          <code>GUESTBOOK_ADMIN_TOKEN</code> to enable admin access.
        </p>
      )
    }
    {
      invalid && (
        <p class="admin-error admin-login__message">
          The admin token was rejected.
        </p>
      )
    }
    {
      loggedOut && (
        <p class="admin-success admin-login__message">Admin session cleared.</p>
      )
    }
    <form id="admin-login-form" method="post" action="/api/admin/session">
      <input type="hidden" name="next" value={next} />
      <label>
        <span class="admin-label">Token</span>
        <input
          class="admin-input"
          type="password"
          name="token"
          required
          autocomplete="current-password"
          disabled={!configured}
          placeholder="Enter admin token"
        />
      </label>
      <button class="admin-button primary" type="submit" disabled={!configured}>
        Sign in
      </button>
    </form>
    <p
      id="admin-login-error"
      class="admin-error"
      role="alert"
      aria-live="assertive"
      hidden
    >
    </p>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>('#admin-login-form');
    const errorElement =
      document.querySelector<HTMLElement>('#admin-login-error');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!errorElement) return;
      errorElement.hidden = true;

      try {
        const formData = new FormData(form);
        const response = await fetch('/api/admin/session', {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            token: formData.get('token'),
            next: formData.get('next'),
          }),
        });
        const payload = (await response.json().catch(() => ({}))) as {
          error?: string;
          next?: string;
        };

        if (!response.ok) {
          throw new Error(payload.error || 'Could not sign in.');
        }
        window.location.assign(payload.next || '/admin');
      } catch (error) {
        errorElement.textContent =
          error instanceof Error ? error.message : 'Could not sign in.';
        errorElement.hidden = false;
      }
    });
  </script>
</AdminLayout>
