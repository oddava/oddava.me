---
import Cabinet from '../../layouts/Cabinet.astro';
import CabinetOff from '../../components/admin/CabinetOff.astro';
import { isAdminConfigured, isAdminRequest } from '../../lib/server/admin';
import { safeRedirectPath } from '../../lib/server/core';
import { registerPortfolioCsp } from '../../lib/portfolio/csp';

if (await isAdminRequest(Astro.cookies)) {
  return Astro.redirect('/admin');
}

registerPortfolioCsp(Astro.csp, import.meta.env.PROD);

const configured = isAdminConfigured();
const requestedNext = Astro.url.searchParams.get('next') ?? '/admin';
const next = safeRedirectPath(requestedNext, '/admin');
const invalid = Astro.url.searchParams.get('error') === 'invalid';
const loggedOut = Astro.url.searchParams.get('logged_out') === '1';
---

<Cabinet title="sign in" description="Authenticate to manage oddava.me." narrow>
  {
    configured ? (
      <section class="cab-gate" aria-labelledby="cab-gate-title">
        <h1 class="pf-title" id="cab-gate-title">
          sign in
        </h1>
        <p class="cab-gate__lede">the admin token opens the dashboard.</p>
        {loggedOut && (
          <p class="cab-gate__note" role="status">
            signed out. see you soon <span aria-hidden="true">( ˘ω˘ )</span>
          </p>
        )}
        <form
          id="admin-login-form"
          class="cab-gate__form"
          method="post"
          action="/api/admin/session"
        >
          <input type="hidden" name="next" value={next} />
          <label class="adm-field">
            <span class="adm-field__label">admin token</span>
            <input
              class="adm-input"
              type="password"
              name="token"
              required
              autocomplete="current-password"
              autofocus
              aria-invalid={invalid ? 'true' : undefined}
              aria-describedby="admin-login-error"
            />
          </label>
          {/* The one place a sign-in error shows, whether the server
              redirected here with ?error=invalid or the script caught it. */}
          <p
            id="admin-login-error"
            class="adm-error"
            role="alert"
            hidden={!invalid}
          >
            {invalid ? 'that token was rejected.' : ''}
          </p>
          <button class="adm-button adm-button--solid" type="submit">
            sign in
          </button>
        </form>
      </section>
    ) : (
      <CabinetOff />
    )
  }
  <script>
    const form = document.querySelector<HTMLFormElement>('#admin-login-form');
    const errorElement =
      document.querySelector<HTMLElement>('#admin-login-error');

    const submitButton = form?.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    const tokenInput = form?.querySelector<HTMLInputElement>(
      'input[name="token"]',
    );

    const clearError = () => {
      if (errorElement) errorElement.hidden = true;
      tokenInput?.removeAttribute('aria-invalid');
    };

    // Editing the token answers the error; it stops being red at once.
    tokenInput?.addEventListener('input', clearError);

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (
        !errorElement ||
        submitButton?.getAttribute('aria-disabled') === 'true'
      ) {
        return;
      }
      clearError();
      // aria-disabled, not disabled: the button keeps focus and its fill
      // while the request is out (disabled would drop focus to the page and
      // turn the button into the "nothing to do" outline).
      if (submitButton) {
        submitButton.setAttribute('aria-disabled', 'true');
        submitButton.textContent = 'signing in…';
      }

      try {
        const formData = new FormData(form);
        const response = await fetch('/api/admin/session', {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            token: formData.get('token'),
            next: formData.get('next'),
          }),
        });
        const payload = (await response.json().catch(() => ({}))) as {
          error?: string;
          next?: string;
        };

        if (!response.ok) {
          throw new Error(payload.error || 'could not sign in.');
        }
        window.location.assign(payload.next || '/admin');
      } catch (error) {
        const message =
          error instanceof Error && error.message
            ? error.message
            : 'could not sign in.';
        // Server messages arrive in sentence case; the page speaks lowercase.
        errorElement.textContent =
          message.charAt(0).toLowerCase() + message.slice(1);
        errorElement.hidden = false;
        tokenInput?.setAttribute('aria-invalid', 'true');
        if (submitButton) {
          submitButton.removeAttribute('aria-disabled');
          submitButton.textContent = 'sign in';
        }
        // Back to the field, so the token can be corrected at once.
        tokenInput?.focus();
        tokenInput?.select();
      }
    });
  </script>
</Cabinet>
