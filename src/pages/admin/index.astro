---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPanel from '../../components/admin/AdminPanel';
import { isAdminConfigured, isAdminRequest } from '../../lib/server/admin';

const configured = isAdminConfigured();

if (configured && !(await isAdminRequest(Astro.cookies))) {
  return Astro.redirect(
    `/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`,
  );
}
---

<AdminLayout title="Admin" description="Unified admin panel for oddava.me.">
  {
    configured ? (
      <>
        <header class="admin-header">
          <img
            class="admin-header__image"
            src="/images/twt-pfp.jpg"
            alt=""
            loading="eager"
            decoding="async"
          />
          <form method="post" action="/api/admin/logout">
            <button
              class="admin-header__action"
              type="submit"
              aria-label="Sign out"
              title="Sign out"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M10 17l5-5-5-5" />
                <path d="M15 12H3" />
                <path d="M21 19V5a2 2 0 0 0-2-2h-5" />
                <path d="M14 21h5a2 2 0 0 0 2-2" />
              </svg>
            </button>
          </form>
        </header>
        <main class="admin-main">
          <AdminPanel client:only="preact" />
        </main>
      </>
    ) : (
      <section class="admin-card admin-login">
        <p class="admin-kicker">oddava</p>
        <h1>Admin unavailable</h1>
        <p class="admin-note">
          Set <code>ADMIN_PANEL_TOKEN</code> or{' '}
          <code>GUESTBOOK_ADMIN_TOKEN</code> in the environment, then reload
          this page.
        </p>
      </section>
    )
  }
</AdminLayout>
