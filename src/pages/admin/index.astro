---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPanel from '../../components/admin/AdminPanel';
import { isAdminConfigured, isAdminRequest } from '../../lib/server/admin';

const configured = isAdminConfigured();

if (configured && !(await isAdminRequest(Astro.cookies))) {
  return Astro.redirect(`/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const keystaticHref = '/keystatic';
---
<AdminLayout title="Admin" description="Unified admin panel for oddava.me.">
  {configured ? (
    <>
      <header class="admin-header">
        <div>
          <p class="admin-kicker">oddava control plane</p>
          <h1>Unified admin panel</h1>
          <p>Manage content, moderate community features, and inspect service readiness without leaving one surface.</p>
        </div>
        <a class="admin-button ghost" href="/api/admin/logout">Sign out</a>
      </header>
      <main class="admin-main">
        <AdminPanel client:load keystaticHref={keystaticHref} />
      </main>
    </>
  ) : (
    <section class="admin-card admin-login">
      <p class="admin-kicker">oddava control plane</p>
      <h1>Admin unavailable</h1>
      <p class="admin-note">Set `ADMIN_PANEL_TOKEN` or `GUESTBOOK_ADMIN_TOKEN` in the environment, then reload this page.</p>
    </section>
  )}
</AdminLayout>
