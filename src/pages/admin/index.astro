---
import Cabinet from '../../layouts/Cabinet.astro';
import AdminPanel from '../../components/admin/AdminPanel';
import CabinetOff from '../../components/admin/CabinetOff.astro';
import { isAdminConfigured, isAdminRequest } from '../../lib/server/admin';
import { registerPortfolioCsp } from '../../lib/portfolio/csp';

const configured = isAdminConfigured();

if (configured && !(await isAdminRequest(Astro.cookies))) {
  return Astro.redirect(
    `/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`,
  );
}

registerPortfolioCsp(Astro.csp, import.meta.env.PROD);
---

<Cabinet
  title="dashboard"
  description="Unified admin panel for oddava.me."
  signedIn={configured}
  narrow={!configured}
>
  {configured ? <AdminPanel client:load /> : <CabinetOff />}
</Cabinet>
