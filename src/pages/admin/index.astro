---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPanel from '../../components/admin/AdminPanel';
import AdminUnavailable from '../../components/admin/AdminUnavailable.astro';
import { isAdminConfigured, isAdminRequest } from '../../lib/server/admin';

const configured = isAdminConfigured();

if (configured && !(await isAdminRequest(Astro.cookies))) {
  return Astro.redirect(
    `/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`,
  );
}
---

<AdminLayout
  title="Dashboard"
  description="Unified admin panel for oddava.me."
  bare={configured}
  sky
>
  {configured ? <AdminPanel client:load /> : <AdminUnavailable />}
</AdminLayout>
