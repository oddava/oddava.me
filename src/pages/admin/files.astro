---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ContentWorkspace } from '../../components/admin/ContentWorkspace';
import AdminUnavailable from '../../components/admin/AdminUnavailable.astro';
import { isAdminConfigured, isAdminRequest } from '../../lib/server/admin';

const configured = isAdminConfigured();

if (configured && !(await isAdminRequest(Astro.cookies))) {
  return Astro.redirect(
    `/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`,
  );
}
---

<AdminLayout
  title="Files"
  description="Knowledge-base file manager and editor for oddava.me."
  fullWidth
>
  {
    configured ? (
      <>
        <main class="admin-main admin-main--full">
          <ContentWorkspace client:load fullWidth />
        </main>
      </>
    ) : (
      <AdminUnavailable />
    )
  }
</AdminLayout>
