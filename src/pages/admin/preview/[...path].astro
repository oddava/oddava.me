---
/**
 * The owner's preview of a note, drafts included, on the admin host.
 *
 * Published notes may live on their own origin (PUBLIC_NOTES_BASE), where the
 * host-only admin cookie never arrives, so a draft opened there is a 404 even
 * for its author. This page renders the same note page here, behind the admin
 * session, and Studio's "Preview draft" links point at it (see
 * src/lib/note-preview-url.ts).
 */
import NotesShell from '../../../components/garden/NotesShell.astro';
import GardenDocumentPage from '../../../components/garden/GardenDocumentPage.astro';
import { getGardenIndexOrUnavailable, isDraftNote } from '@lib/garden';
import { requireAdminPage } from '@lib/server/admin';
import { NOTE_FALLBACK_DESCRIPTION } from '@lib/site';
import '../../../styles/components/_garden.css';

const denied = await requireAdminPage(Astro.cookies, Astro.url);
if (denied) return denied;

const owner = await getGardenIndexOrUnavailable({ includeDrafts: true });
if (!owner.ok) return Astro.rewrite('/503');

const requestedPath = Astro.params.path ?? '';
const document = owner.index.documents.find(
  (entry) => entry.path === requestedPath,
);
if (!document) return Astro.rewrite('/404');

const draft = isDraftNote(document.data);
// Never stored where anyone else could be served it, never indexed.
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<NotesShell
  title={document.title}
  description={document.summary || NOTE_FALLBACK_DESCRIPTION}
  type="article"
  modifiedTime={document.updated}
  wide
>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class="garden-page">
    {
      draft && (
        <p class="draft-banner" role="status">
          <strong>draft</strong>
          only you can see this page. publish it from Studio to share it.
        </p>
      )
    }
    <GardenDocumentPage document={document} index={owner.index} />
  </div>
</NotesShell>
