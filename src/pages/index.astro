---
// Prerendered: the hero and the static lines are the same for everyone. The
// two Redis-backed parts — the project strip and the latest notes — are
// server islands, fetched after first paint.
export const prerender = true;
import Base from '@layouts/Base.astro';
import Footer from '../components/Footer.astro';
import RecentNotes from '../components/home/RecentNotes.astro';
import ProjectStrip from '../components/home/ProjectStrip.astro';
import linksData from '../data/links.json';
import { getPublicNavigationRoutes } from '../lib/site-routes';
import '../styles/components/_projects.css';
import '../styles/components/_home.css';

// Off-site contacts only; the header already covers on-site pages.
const contacts = linksData.links.flatMap(({ url, ...link }) =>
  url && !url.startsWith('/') ? [{ ...link, url }] : [],
);
const routes = getPublicNavigationRoutes();
const pageHref = (label: string) =>
  routes.find((route) => route.label === label)?.href ?? '/';
---

<Base>
  <section class="home-hero">
    <h1 class="home-hero__name rise">oddava</h1>
    <p class="home-hero__tagline rise rise--1">
      i write software, interrogate SI (silly intellect), and make tools for
      small&nbsp;annoyances.
    </p>
  </section>

  <section class="home-strip" aria-labelledby="home-projects">
    <div class="home-head">
      <h2 class="home-head__label" id="home-projects">
        <a href={pageHref('projects')}>projects</a>
      </h2>
      <div class="gallery-nav" data-gallery-nav hidden>
        <button type="button" data-step="-1" aria-label="previous project">
          <span aria-hidden="true">←</span>
        </button>
        <button type="button" data-step="1" aria-label="next project">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
    <ProjectStrip server:defer galleryHref={pageHref('projects')}>
      <div class="home-strip__pending" slot="fallback"></div>
    </ProjectStrip>
  </section>

  <section class="home-garden" aria-labelledby="home-notes">
    <div class="home-head">
      <h2 class="home-head__label" id="home-notes">
        <a href={pageHref('notes')}>notes</a>
      </h2>
    </div>
    <RecentNotes server:defer>
      <div class="note-rows--pending" slot="fallback"></div>
    </RecentNotes>
  </section>

  <p class="home-links" aria-label="contact and feeds">
    {
      contacts.map((link) => {
        const isExternal = link.url.startsWith('http');
        return (
          <a
            href={link.url}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'noopener noreferrer' : undefined}
          >
            {link.title.toLowerCase()}
            {isExternal && <span class="sr-only"> (opens in new tab)</span>}
          </a>
        );
      })
    }
    <a href="/rss.xml">rss</a>
  </p>

  <Footer slot="footer" />
</Base>

<script>
  import { mountGallery } from '../lib/project-gallery';

  // The strip is a server island: it arrives after this runs, so wait for it.
  const nav = document.querySelector<HTMLElement>('[data-gallery-nav]');
  const strip = document.querySelector<HTMLElement>('.home-strip');
  const mountStrip = () => {
    const gallery = strip?.querySelector<HTMLElement>('[data-gallery]');
    if (!gallery || !nav) return false;
    mountGallery(gallery, nav);
    return true;
  };
  if (strip && !mountStrip()) {
    const watch = new MutationObserver(() => {
      if (mountStrip()) watch.disconnect();
    });
    watch.observe(strip, { childList: true, subtree: true });
  }
</script>
