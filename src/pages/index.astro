---
export const prerender = true;
import Base from '@layouts/Base.astro';
import '../styles/components/_home.css';
---

<Base
  title="oddava"
  description="Software, AI, and personal projects by oddava."
  image="/og-default.svg"
>
  <section class="home-hero home-hero--intro">
    <h1 class="home-hero__tagline">
      hi, i'm oddava. i spend my time building software, playing games
      (maintaining my losing streak), reading webtoon/novels and occasionally
      watching anime
    </h1>

    <div class="home-hero__cta">
      <a href="/blog" class="home-cta">writing</a>
      <a href="/projects" class="home-cta">projects</a>
      <a href="/about" class="home-cta">about</a>
    </div>
  </section>
</Base>