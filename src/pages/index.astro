---
export const prerender = true;
import Base from '@layouts/Base.astro';
import LinkIcon from '../components/LinkIcon.astro';
import { getGardenIndex } from '@lib/garden';
import '../styles/components/_home.css';

const index = await getGardenIndex();
// The garden index is already ordered most-recently-touched first, so "what
// I've been writing" is just the top of it, minus the notes home itself.
const recentNotes = index.documents
  .filter((note) => note.id !== 'index')
  .slice(0, 6);
---

<Base
  title="oddava"
  description="the notebook i keep out in the open — things i'm making, reading, and thinking about."
  image="/og-default.svg"
>
  <section class="home-hero home-hero--intro">
    <img
      src="/images/twt-pfp.jpg"
      alt=""
      class="home-avatar"
      width="96"
      height="96"
      loading="eager"
    />
    <h1 class="home-hero__title">oddava</h1>
    <p class="home-hero__tagline">
      hi, i'm oddava. i build software, lose at games more than i'd like, and
      read a lot of webtoons and novels. this is where i keep the notes.
    </p>

    <nav class="home-hero__cta" aria-label="primary">
      <a href="/notes" class="home-cta home-cta--icon" aria-label="notes">
        <LinkIcon name="graph" />
      </a>
      <a href="/about" class="home-cta home-cta--icon" aria-label="about">
        <LinkIcon name="user" />
      </a>
      <a href="/links" class="home-cta home-cta--icon" aria-label="links">
        <LinkIcon name="link" />
      </a>
    </nav>
  </section>

  {
    recentNotes.length > 0 && (
      <section class="home-section" aria-labelledby="recent-notes-heading">
        <h2 id="recent-notes-heading" class="section-heading">
          lately
        </h2>
        <ul class="home-card-list">
          {recentNotes.map((note) => (
            <li>
              <a href={note.href} class="home-card">
                <span class="home-card__title">{note.title}</span>
                {note.summary && (
                  <span class="home-card__desc">{note.summary}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
