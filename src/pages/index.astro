---
export const prerender = true;
import Base from '@layouts/Base.astro';
import LivingFolio from '../components/LivingFolio.astro';
import '../styles/components/_home.css';
---

<Base
  title="oddava"
  description="the notebook i keep out in the open — things i'm making, reading, and thinking about."
  hideNav
>
  <LivingFolio slot="background" />
  <section class="home-hero home-hero--intro">
    <h1 class="home-hero__name">oddava</h1>
    <p class="home-hero__tagline">
      software engineer, currently at
      <a href="https://dt.uz/" target="_blank" rel="noopener">DT Ecosystem</a>.
      on the side i'm building anishows, a calmer way to track what i'm
      watching.
    </p>

    <nav class="folio-nav" aria-label="primary" data-folio-nav>
      <a href="/notes" class="folio-waypoint folio-waypoint--notes">
        <svg
          class="folio-waypoint__icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
          ><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"
          ></path><path d="M14 3v5h5M9 13h6M9 17h4"></path></svg
        >
        <span class="folio-waypoint__label">notes</span>
      </a>
      <a href="/about" class="folio-waypoint folio-waypoint--about">
        <svg
          class="folio-waypoint__icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
          ><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"
          ></path></svg
        >
        <span class="folio-waypoint__label">about</span>
      </a>
      <a href="/links" class="folio-waypoint folio-waypoint--links">
        <svg
          class="folio-waypoint__icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
          ><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1"
          ></path><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"
          ></path></svg
        >
        <span class="folio-waypoint__label">links</span>
      </a>
    </nav>
  </section>
</Base>
