---
export const prerender = true;
import Base from '@layouts/Base.astro';
import LinkIcon from '../components/LinkIcon.astro';
import '../styles/components/_home.css';
import { getFeaturedPosts, formatPostDate, getPostStats } from '../lib/content';
import { getAllProjects } from '../lib/projects';

const [featuredPosts, projects] = await Promise.all([
  getFeaturedPosts(),
  getAllProjects(),
]);

const featuredProjects = projects.filter((project) => project.featured);
---

<Base
  title="oddava"
  description="Software, AI, and personal projects by oddava."
  image="/og-default.svg"
>
  <section class="home-hero home-hero--intro">
    <img
      src="/images/twt-pfp.jpg"
      alt=""
      class="home-avatar"
      width="96"
      height="96"
      loading="eager"
    />
    <h1 class="home-hero__title">oddava</h1>
    <p class="home-hero__tagline">
      i spend my time building software, playing games (maintaining my losing
      streak), reading webtoon/novels and occasionally watching anime
    </p>

    <nav class="home-hero__cta" aria-label="primary">
      <a href="/blog" class="home-cta home-cta--icon" aria-label="writing">
        <LinkIcon name="pen" />
      </a>
      <a href="/projects" class="home-cta home-cta--icon" aria-label="projects">
        <LinkIcon name="code" />
      </a>
      <a href="/library" class="home-cta home-cta--icon" aria-label="library">
        <LinkIcon name="book" />
      </a>
      <a href="/about" class="home-cta home-cta--icon" aria-label="about">
        <LinkIcon name="user" />
      </a>
      <a href="/links" class="home-cta home-cta--icon" aria-label="links">
        <LinkIcon name="link" />
      </a>
    </nav>
  </section>

  {
    featuredProjects.length > 0 && (
      <section class="home-section" aria-labelledby="featured-projects-heading">
        <h2 id="featured-projects-heading" class="section-heading">
          featured projects
        </h2>
        <ul class="home-card-list">
          {featuredProjects.map((project) => (
            <li>
              <a href={`/projects/${project.id}`} class="home-card">
                <span class="home-card__title">{project.title}</span>
                <span class="home-card__desc">{project.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    featuredPosts.length > 0 && (
      <section class="home-section" aria-labelledby="featured-writing-heading">
        <h2 id="featured-writing-heading" class="section-heading">
          featured writing
        </h2>
        <ul class="home-card-list">
          {featuredPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class="home-card">
                <span class="home-card__title">{post.data.title}</span>
                <span class="home-card__desc">
                  <time datetime={post.data.date}>
                    {formatPostDate(post.data.date, 'short')}
                  </time>
                  {post.body && (
                    <>
                      <span aria-hidden="true"> · </span>
                      <span>
                        {getPostStats(post.body).readingTimeMinutes} min
                      </span>
                    </>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
