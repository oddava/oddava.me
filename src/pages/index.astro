---
export const prerender = true;
import Base from '@layouts/Base.astro';
import LivingFolio from '../components/LivingFolio.astro';
import '../styles/components/_home.css';
---

<Base hideNav>
  <LivingFolio slot="background" />
  <section class="home-hero home-hero--intro">
    <h1 class="home-hero__name">oddava</h1>
    <p class="home-hero__tagline">
      i write software, interrogate SI (silly intellect), and make tools for
      small annoyances.
    </p>

    <nav class="folio-nav" aria-label="primary" data-folio-nav>
      <a href="/notes" class="folio-waypoint folio-waypoint--notes">
        <svg viewBox="-40 -40 80 80" aria-hidden="true">
          <path class="folio-waypoint__echo" d="M-28 18L4 35 34-13"></path>
          <path
            class="folio-waypoint__mark"
            d="M-28 10L-3-26 27-15 0 25Z M-3-26L0 25 27-15"></path>
        </svg>
        <span class="folio-waypoint__label">notes</span>
      </a>
      <a href="/about" class="folio-waypoint folio-waypoint--about">
        <svg viewBox="-40 -40 80 80" aria-hidden="true">
          <path class="folio-waypoint__echo" d="M-23 25A33 33 0 0 0 30-11"
          ></path>
          <path
            class="folio-waypoint__mark"
            d="M-32 9A36 36 0 0 1 26-25A41 41 0 0 0-32 9Z"></path>
        </svg>
        <span class="folio-waypoint__label">about</span>
      </a>
    </nav>
  </section>
</Base>
