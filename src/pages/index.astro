---
export const prerender = true;
import Base from '@layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts, formatPostDate } from '../lib/content';
import '../styles/components/_home.css';
import '../styles/components/_lists.css';

const [posts, projects] = await Promise.all([
  getPublishedPosts(),
  getCollection('projects'),
]);

const featuredProjects = projects
  .filter((p) => p.data.featured)
  .slice(0, 3)
  .concat(projects.filter((p) => !p.data.featured))
  .slice(0, 3);

const latestPosts = posts.slice(0, 3);
---

<Base
  title="oddava"
  description="Software, AI, and personal projects by oddava."
  image="/og-default.svg"
>
  <section class="home-hero home-hero--intro">
    <h1 class="home-hero__tagline">
      hi, i'm oddava. i spend my time building software, getting lost in
      games(maintaining my losing streak), reading webtoon/novels and
      occasionally watching anime
    </h1>

    <div class="home-hero__cta">
      <a href="/blog" class="home-cta">writing</a>
      <a href="/projects" class="home-cta">projects</a>
      <a href="/about" class="home-cta">about</a>
    </div>
  </section>

  <section class="home-section" aria-labelledby="home-projects-heading">
    <h2 id="home-projects-heading" class="section-heading">
      featured projects
    </h2>
    {
      featuredProjects.length > 0 ? (
        <ul class="home-card-list">
          {featuredProjects.map((project) => (
            <li>
              <a href={`/projects/${project.id}`} class="home-card">
                <span class="home-card__title">{project.data.title}</span>
                <span class="home-card__desc">{project.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="home-empty">nothing shipped yet — check back soon.</p>
      )
    }
  </section>

  <section class="home-section" aria-labelledby="home-writing-heading">
    <h2 id="home-writing-heading" class="section-heading">latest writing</h2>
    {
      latestPosts.length > 0 ? (
        <ul class="home-card-list">
          {latestPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class="home-card">
                <span class="home-card__title">{post.data.title}</span>
                <span class="home-card__desc">
                  <time datetime={post.data.date}>
                    {formatPostDate(post.data.date, 'short')}
                  </time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="home-empty">no posts yet.</p>
      )
    }
  </section>
</Base>
