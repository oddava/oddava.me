---
export const prerender = true;
import Base from '@layouts/Base.astro';
import LinkIcon from '../components/LinkIcon.astro';
import '../styles/components/_home.css';
---

<Base
  title="oddava"
  description="the notebook i keep out in the open — things i'm making, reading, and thinking about."
  hideNav
>
  <section class="home-hero home-hero--intro">
    <img
      src="/images/twt-pfp.jpg"
      alt=""
      class="home-avatar"
      width="96"
      height="96"
      loading="eager"
    />
    <h1 class="home-hero__title">oddava</h1>
    <p class="home-hero__tagline">
      hi, i'm oddava. i build software, explore AI, and enjoy webtoons, novels,
      and anime. currently an intern at
      <a href="https://dt.uz/" target="_blank" rel="noopener">DT</a>.
    </p>

    {
      /* Three plotted destinations rather than three buttons — see
         `_home.css`. The `__plot` span is the drawing (rule, tick, station
         dot); it carries no text, so it is hidden from the reading order. */
    }
    <nav class="home-hero__cta" aria-label="primary">
      <a href="/notes" class="home-cta">
        <span class="home-cta__face">
          <LinkIcon name="pen" class="home-cta__glyph" />
          <span class="home-cta__label">notes</span>
        </span>
        <span class="home-cta__plot" aria-hidden="true">
          <svg
            class="home-cta__mark"
            viewBox="0 0 14 14"
            width="14"
            height="14"
            aria-hidden="true"
            focusable="false"
          >
            <circle class="home-cta__dot" cx="7" cy="7" r="2.6"></circle>
          </svg>
        </span>
      </a>
      <a href="/about" class="home-cta">
        <span class="home-cta__face">
          <LinkIcon name="user" class="home-cta__glyph" />
          <span class="home-cta__label">about</span>
        </span>
        <span class="home-cta__plot" aria-hidden="true">
          <svg
            class="home-cta__mark"
            viewBox="0 0 14 14"
            width="14"
            height="14"
            aria-hidden="true"
            focusable="false"
          >
            <circle class="home-cta__dot" cx="7" cy="7" r="2.6"></circle>
          </svg>
        </span>
      </a>
      <a href="/links" class="home-cta">
        <span class="home-cta__face">
          <LinkIcon name="link" class="home-cta__glyph" />
          <span class="home-cta__label">links</span>
        </span>
        <span class="home-cta__plot" aria-hidden="true">
          <svg
            class="home-cta__mark"
            viewBox="0 0 14 14"
            width="14"
            height="14"
            aria-hidden="true"
            focusable="false"
          >
            <circle class="home-cta__dot" cx="7" cy="7" r="2.6"></circle>
          </svg>
        </span>
      </a>
    </nav>
  </section>
</Base>
