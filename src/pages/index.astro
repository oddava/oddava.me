---
export const prerender = true;
import Base from '@layouts/Base.astro';
import LinkIcon from '../components/LinkIcon.astro';
import '../styles/components/_home.css';
---

<Base
  title="oddava"
  description="the notebook i keep out in the open — things i'm making, reading, and thinking about."
  image="/og-default.svg"
>
  <section class="home-hero home-hero--intro">
    <img
      src="/images/twt-pfp.jpg"
      alt=""
      class="home-avatar"
      width="96"
      height="96"
      loading="eager"
    />
    <h1 class="home-hero__title">oddava</h1>
    <p class="home-hero__tagline">
      hi, i'm oddava. i build software, explore AI, and enjoy webtoons, novels,
      and anime. currently an intern at
      <a href="https://dt.uz/" target="_blank" rel="noopener">DT</a>.
    </p>

    <nav class="home-hero__cta" aria-label="primary">
      <a href="/notes" class="home-cta home-cta--icon" aria-label="notes">
        <LinkIcon name="graph" />
      </a>
      <a href="/about" class="home-cta home-cta--icon" aria-label="about">
        <LinkIcon name="user" />
      </a>
      <a href="/links" class="home-cta home-cta--icon" aria-label="links">
        <LinkIcon name="link" />
      </a>
    </nav>
  </section>
</Base>
