---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import '../../styles/components/_library.css';
import {
  getAnimeFavorites,
  toAnimeFavoriteCards,
  type AnimeFavoriteCard,
} from '../../lib/content';

let animeCards: AnimeFavoriteCard[] = [];
let animeAvailable = true;

try {
  animeCards = toAnimeFavoriteCards(await getAnimeFavorites());
} catch {
  animeAvailable = false;
}
---

<Base title="library" description="Things I like.">
  <h2 class="library-heading">anime</h2>

  <section class="library-section">
    {
      animeAvailable && (
        <div class="anime-grid">
          {animeCards.map((card) => (
            <a
              href={card.href}
              class="anime-card"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={card.coverImage}
                alt={card.title}
                class="anime-card__cover"
                width="95"
                height="125"
                loading="lazy"
              />
              <span class="anime-card__tooltip">{card.title}</span>
            </a>
          ))}
        </div>
      )
    }

    {
      animeAvailable && animeCards.length === 0 && (
        <p class="library-empty-state">Nothing here yet.</p>
      )
    }

    {
      !animeAvailable && (
        <p class="library-empty-state">Favorites are offline right now.</p>
      )
    }
  </section>
</Base>
