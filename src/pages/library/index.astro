---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import '../../styles/components/_library.css';
import {
  getAnimeFavorites,
  getBookCards,
  toAnimeFavoriteCards,
  type AnimeFavoriteCard,
  type BookCard,
} from '../../lib/content';

let animeCards: AnimeFavoriteCard[] = [];
let animeAvailable = true;
const bookCards: BookCard[] = await getBookCards();

try {
  animeCards = toAnimeFavoriteCards(await getAnimeFavorites());
} catch {
  animeAvailable = false;
}
---

<Base title="library" description="Things I like.">
  <h2 class="library-heading">
    anime
    <a
      href={`https://anilist.co/user/${import.meta.env.ANILIST_USERNAME ?? 'codeJ'}`}
      class="library-external-link"
      target="_blank"
      rel="noopener noreferrer"
      title="View full list on AniList"
    >
      ↗
    </a>
  </h2>

  <section class="library-section">
    {
      animeAvailable && (
        <div class="library-card-grid">
          {animeCards.map((card) => (
            <a
              href={card.href}
              class="library-card"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={card.coverImage}
                alt={card.title}
                class="library-card__cover"
                width="95"
                height="125"
                loading="lazy"
              />
              <span class="library-card__label">{card.title}</span>
            </a>
          ))}
        </div>
      )
    }

    {
      animeAvailable && animeCards.length === 0 && (
        <p class="library-empty-state">Nothing here yet.</p>
      )
    }

    {
      !animeAvailable && (
        <p class="library-empty-state">Favorites are offline right now.</p>
      )
    }
  </section>

  <h2 class="library-heading">books</h2>

  <section class="library-section">
    {
      bookCards.length > 0 && (
        <div class="library-card-grid">
          {bookCards.map((card) => (
            <a
              href={card.href}
              class="library-card"
              target={card.href.startsWith('#') ? undefined : '_blank'}
              rel={
                card.href.startsWith('#') ? undefined : 'noopener noreferrer'
              }
            >
              <img
                src={card.coverImage}
                alt={card.title}
                class="library-card__cover"
                width="95"
                height="125"
                loading="lazy"
              />
              <span class="library-card__label">{card.title}</span>
            </a>
          ))}
        </div>
      )
    }

    {
      bookCards.length === 0 && (
        <p class="library-empty-state">Nothing here yet.</p>
      )
    }
  </section>
</Base>
