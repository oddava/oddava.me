---
// Server-rendered so the status code is a real 404 — both for direct misses
// and for the notes routes that rewrite here on unknown paths. A prerendered
// 404 would be served 200 by those rewrites (a soft 404).
import Portfolio from '@layouts/Portfolio.astro';
import { notesIndexUrl } from '../lib/notes-url';
import { registerPortfolioCsp } from '../lib/portfolio/csp';
import '../styles/portfolio/_status.css';

registerPortfolioCsp(Astro.csp, import.meta.env.PROD);
Astro.response.status = 404;
---

<Portfolio
  title="Page not found"
  description="This page doesn't exist on oddava.me."
  header={false}
>
  <meta slot="head" name="robots" content="noindex" />
  <section class="pf-status" aria-labelledby="status-code">
    <h1 class="pf-status__code" id="status-code">404</h1>
    <p class="pf-status__copy">
      this page wandered off. maybe it's in the notes, or maybe it never existed
      at all.
    </p>
    <nav class="pf-status__links" aria-label="where to go">
      <a class="pf-status__entry" href="/" data-page-preview-ignore>
        <span>home</span>
        <span class="pf-status__arrow" aria-hidden="true">→</span>
      </a>
      <a
        class="pf-status__entry"
        href={notesIndexUrl()}
        data-page-preview-ignore
      >
        <span>notes</span>
        <span class="pf-status__arrow" aria-hidden="true">→</span>
      </a>
    </nav>
  </section>
</Portfolio>
