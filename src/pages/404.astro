---
// Server-rendered so the status code is a real 404 — both for direct misses
// and for the notes routes that rewrite here on unknown paths. A prerendered
// 404 would be served 200 by those rewrites (a soft 404).
import Base from '../layouts/Base.astro';
import { notesIndexUrl } from '../lib/notes-url';
import '../styles/components/_status-page.css';

Astro.response.status = 404;
---

<Base
  title="Page not found"
  description="This page doesn't exist on oddava.me."
>
  <meta slot="head" name="robots" content="noindex" />
  <section class="status-page">
    <h1 class="status-page__code rise">404</h1>
    <p class="status-page__copy rise rise--1">
      this page wandered off. maybe it's in the notes, or maybe it never existed
      at all.
    </p>
    <ul class="status-page__links rise rise--2">
      <li><a href="/">home</a></li>
      <li><a href={notesIndexUrl()}>notes</a></li>
    </ul>
  </section>
</Base>
