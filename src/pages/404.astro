---
// Server-rendered so the status code is a real 404 — both for direct misses
// and for the notes routes that rewrite here on unknown paths. A prerendered
// 404 would be served 200 by those rewrites (a soft 404).
import Base from '../layouts/Base.astro';
import '../styles/components/_status-page.css';

Astro.response.status = 404;
---

<Base title="404" description="This page wandered off.">
  <meta slot="head" name="robots" content="noindex" />
  <section class="status-page">
    <h1>404</h1>
    <p class="status-page__copy">
      this page wandered off. maybe it's in the notes, or maybe it never existed
      at all.
    </p>
    <ul class="status-page__links">
      <li><a href="/">home</a></li>
      <li><a href="/notes">notes</a></li>
      <li><a href="/about">about</a></li>
    </ul>
    <p class="status-page__hint">
      or check the url — typos happen to the best of us.
    </p>
  </section>
</Base>
