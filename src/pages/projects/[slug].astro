---
export const prerender = true;

import { getCollection } from 'astro:content';
import { uniqueNoteLeafRedirects } from '@lib/garden';

// Old /projects/<slug> links redirect into the notes garden, keyed off each
// note's file name.
export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return uniqueNoteLeafRedirects(notes).map(({ slug, redirectTo }) => ({
    params: { slug },
    props: { redirectTo },
  }));
}

if (Astro.props.redirectTo) {
  return Astro.redirect(Astro.props.redirectTo, 301);
}
---
