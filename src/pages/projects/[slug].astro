---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import '../../styles/components/_prose.css';
import { getCollection, render } from 'astro:content';
import { mdxComponents } from '../../components/mdx/components';
import { SITE_AUTHOR_NAME, siteUrl } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.description,
  url:
    project.data.url ?? project.data.repo ?? siteUrl(`/projects/${project.id}`),
  codeRepository: project.data.repo,
  author: {
    '@type': 'Person',
    name: SITE_AUTHOR_NAME,
    url: siteUrl('/about'),
  },
  mainEntityOfPage: siteUrl(`/projects/${project.id}`),
};
const serializedProjectSchema = JSON.stringify(projectSchema)
  .replaceAll('<', '\\u003c')
  .replaceAll('>', '\\u003e')
  .replaceAll('&', '\\u0026');
---

<Base
  title={project.data.title}
  description={project.data.description}
  type="article"
  image="/og-default.svg"
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={serializedProjectSchema}
  />
  <article class="project-page">
    <header class="project-header">
      {
        project.data.repo ? (
          <h1>
            <a
              href={project.data.repo}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.data.title}
            </a>
          </h1>
        ) : (
          <h1>{project.data.title}</h1>
        )
      }
      <p class="project-description">{project.data.description}</p>
    </header>

    <div class="prose">
      <Content components={mdxComponents} />
    </div>
  </article>
</Base>

<style>
  .project-page {
    padding-top: var(--space-sm);
  }

  .project-header {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-rule);
  }

  .project-header h1 {
    margin: 0 0 0.35rem;
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .project-header h1 a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .project-header h1 a:hover {
    color: var(--color-text-interactive-hover);
  }

  .project-description {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    max-width: 55ch;
  }
</style>
