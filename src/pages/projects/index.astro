---
import Portfolio from '@layouts/Portfolio.astro';
import ProjectShot from '../../components/portfolio/ProjectShot.astro';
import { isStorageUnavailableError } from '../../lib/server/core';
import { readPublicProjects } from '../../lib/server/projects';
import { presentProjects } from '../../lib/portfolio-projects';
import { registerPortfolioCsp } from '../../lib/portfolio/csp';
import type { Project } from '../../lib/contracts';
import '../../styles/components/_project-image.css';
import '../../styles/portfolio/_projects-page.css';

registerPortfolioCsp(Astro.csp, import.meta.env.PROD);

// Rendered per request: the list is edited from the admin dashboard and lives
// in Redis, so a save shows here without a deploy. Featured projects come
// first (readPublicProjects); presentProjects only changes how they show.
let stored: Project[];
try {
  stored = await readPublicProjects();
} catch (error) {
  if (isStorageUnavailableError(error)) return Astro.rewrite('/503');
  throw error;
}

const projects = presentProjects(stored);
// Only the first picture can be on screen at load; the rest wait for scroll.
const firstImageId = projects.find(
  (project) => !project.previewUnavailable,
)?.id;
---

<Portfolio
  title="Projects"
  description="Software oddava has built, from day-job work to side projects."
>
  <div class="pf-column">
    <h1 class="pf-title">projects</h1>
    {
      projects.length === 0 ? (
        <p class="pf-empty">nothing here yet.</p>
      ) : (
        <ul class="pf-cards">
          {projects.map((project) => (
            <ProjectShot
              project={project}
              eager={project.id === firstImageId}
            />
          ))}
        </ul>
      )
    }
  </div>
</Portfolio>

<script>
  import { revealShots } from '../../scripts/shot-reveal';
  revealShots();
</script>
