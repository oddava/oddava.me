---
import Base from '@layouts/Base.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import { isStorageUnavailableError } from '../../lib/server/core';
import { readPublicProjects } from '../../lib/server/projects';
import type { Project } from '../../lib/contracts';
import '../../styles/components/_projects.css';

// Rendered per request: the list is edited from the admin dashboard and lives
// in Redis, so a save shows here without a deploy. Featured projects come
// first; see readPublicProjects.
let projects: Project[];
try {
  projects = await readPublicProjects();
} catch (error) {
  if (isStorageUnavailableError(error)) return Astro.rewrite('/503');
  throw error;
}

// Only the first image can be on screen at load; the rest wait for the scroll.
const firstImageId = projects.find((project) => project.image)?.id;
---

<Base
  title="Projects"
  description="Software oddava has built, from day-job work to side projects."
  sky
>
  <article class="projects-page">
    <div class="gallery-head">
      <h1 class="page-title rise">projects</h1>
      <div class="gallery-nav rise" data-gallery-nav hidden>
        <button type="button" data-step="-1" aria-label="previous project">
          <span aria-hidden="true">←</span>
        </button>
        <button type="button" data-step="1" aria-label="next project">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <div
      class="gallery"
      data-gallery
      tabindex="0"
      role="region"
      aria-label="projects, scroll sideways"
    >
      <ol class="gallery__track">
        {
          projects.map((project) => (
            <ProjectCard
              project={project}
              eager={project.id === firstImageId}
              class="rise"
            />
          ))
        }
      </ol>
    </div>
  </article>
</Base>

<script>
  import { mountGallery } from '../../lib/project-gallery';

  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const nav = document.querySelector<HTMLElement>('[data-gallery-nav]');
  if (gallery && nav) mountGallery(gallery, nav);
</script>
