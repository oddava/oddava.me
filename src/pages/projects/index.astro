---
import Base from '@layouts/Base.astro';
import { isStorageUnavailableError } from '../../lib/server/core';
import { readPublicProjects } from '../../lib/server/projects';
import type { Project } from '../../lib/contracts';
import '../../styles/components/_projects.css';

// Rendered per request: the list is edited from the admin dashboard and lives
// in Redis, so a save shows here without a deploy.
let projects: Project[];
try {
  projects = await readPublicProjects();
} catch (error) {
  if (isStorageUnavailableError(error)) return Astro.rewrite('/503');
  throw error;
}

const hostOf = (url: string) => new URL(url).host;
---

<Base
  title="Projects"
  description="Software oddava has built, from day-job work to side projects."
  sky
>
  <article class="projects-page">
    <h1 class="page-title rise">projects</h1>

    <ol class="projects">
      {
        projects.map((project) => {
          const href = project.site ?? project.source;
          return (
            <li class="project rise">
              <div class="project__head">
                <h2 class="project__name">
                  {href ? (
                    <a href={href} target="_blank" rel="noopener noreferrer">
                      {project.name}
                    </a>
                  ) : (
                    project.name
                  )}
                </h2>
                <span class="project__rule" aria-hidden="true" />
                <span
                  class:list={[
                    'project__year',
                    project.year === 'now' && 'project__year--now',
                  ]}
                >
                  {project.year}
                </span>
              </div>
              <p class="project__description">{project.description}</p>
              <div class="project__meta">
                {project.stack.length > 0 && (
                  <ul class="project__stack" aria-label="built with">
                    {project.stack.map((tool) => (
                      <li>{tool}</li>
                    ))}
                  </ul>
                )}
                {href && (
                  <ul class="project__links">
                    {project.site && (
                      <li>
                        <a
                          href={project.site}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {hostOf(project.site)}
                        </a>
                      </li>
                    )}
                    {project.source && (
                      <li>
                        <a
                          href={project.source}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`${project.name} source code`}
                        >
                          source
                        </a>
                      </li>
                    )}
                  </ul>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </article>
</Base>
