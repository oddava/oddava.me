---
export const prerender = true;
import Base from '@layouts/Base.astro';
import { Guestbook } from '../components/Guestbook';
import '../styles/components/_prose.css';
import '../styles/components/_about.css';
---

<Base
  title="About"
  description="Oddava is a software engineer based in Uzbekistan, building web applications and working on Ishbay."
>
  <article class="about">
    <h1>about</h1>

    <p>
      I'm a software engineer based in Uzbekistan. I build web applications,
      currently working on <a href="https://ishbay.com"
        ><strong>Ishbay</strong></a
      >, a payroll management platform for businesses.
    </p>

    <p>
      I'm interested in backend engineering, system design, self-hosting, and
      developer tools.
    </p>

    <p>Outside of coding, I enjoy games, anime and going on long walks.</p>
  </article>

  <Guestbook client:idle />
  <noscript>
    <p class="guestbook-noscript">
      the guestbook needs javascript to load and post notes. with it off, you
      can still say hi at <a href="mailto:hello@oddava.me">hello@oddava.me</a>.
    </p>
  </noscript>
</Base>
