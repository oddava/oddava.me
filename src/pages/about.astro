---
export const prerender = true;
import Base from '@layouts/Base.astro';
import { Guestbook } from '../components/Guestbook';
import '../styles/components/_prose.css';
---

<Base title="about" description="a little about me and this site.">
  <div class="about-content">
    <h1>about</h1>
    <p>
      most of my time goes into fullstack development and side projects. when
      i'm away from my editor, i'm usually reading or watching anime.
    </p>

    <p>
      this website is where i keep my projects, notes and anything else i think
      is worth remembering. it's mostly for myself, but if you find something
      useful here, that's a nice bonus ;)
    </p>
  </div>

  <Guestbook client:idle />
  <noscript>
    <p class="guestbook-noscript">
      the guestbook needs javascript to load and post notes. with it off, you
      can still say hi at <a href="mailto:hello@oddava.me">hello@oddava.me</a>.
    </p>
  </noscript>
</Base>
