---
export const prerender = true;
import Base from '@layouts/Base.astro';
import { Guestbook } from '../components/Guestbook';
---
<Base title="about" description="Who is Oddava">
  <div class="about-content">
    <p>
      i'm oddava. i spend most of my time building software, following the AI ecosystem,
      and chasing side projects that feel a little weird but worth making.
    </p>

    <p>
      this site is where i keep the public version of that process: notes, experiments, a few games,
      and project writeups that show how i think when i ship things.
    </p>

    <p>
      i care about products that feel personal, infrastructure that stays simple until it absolutely
      cannot, and tools that give people leverage instead of ceremony.
    </p>

    <p>
      you can find me on <a href="https://x.com/oddava" target="_blank" rel="noopener">twitter</a>,
      browse the code on <a href="https://github.com/oddava" target="_blank" rel="noopener">github</a>,
      or reach me at <a href="mailto:hello@oddava.me">hello@oddava.me</a>.
    </p>
  </div>

  <Guestbook client:only="react" />
</Base>
