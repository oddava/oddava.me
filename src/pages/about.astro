---
export const prerender = true;
import Base from '@layouts/Base.astro';
import { Guestbook } from '../components/Guestbook';
import '../styles/components/_prose.css';
---

<Base title="About" description="A little about me and this site.">
  <div class="about-content">
    <h1>About</h1>
    <p>
      I'm a software engineer at
      <a href="https://dt.uz/" target="_blank" rel="noopener">DT Ecosystem</a>.
      Most of my time goes into full-stack development and side projects, like
      AniShows, a calmer way to keep track of what I'm watching. Away from the
      editor I'm usually reading or watching anime.
    </p>

    <p>
      This site is where I keep my projects, notes, and anything else worth
      remembering. It's mostly for me, but if you find something useful here,
      that's a nice bonus.
    </p>
  </div>

  <Guestbook client:idle />
  <noscript>
    <p class="guestbook-noscript">
      the guestbook needs javascript to load and post notes. with it off, you
      can still say hi at <a href="mailto:hello@oddava.me">hello@oddava.me</a>.
    </p>
  </noscript>
</Base>
