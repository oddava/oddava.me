---
import Base from '../../layouts/Base.astro';
import GardenDocumentPage from '../../components/garden/GardenDocumentPage.astro';
import {
  decidePublicNote,
  getGardenIndexOrUnavailable,
  readPublicNoteRetirement,
} from '@lib/garden';
import { noteSocialCardImage } from '@lib/garden/og-card';
import { deriveNoteSocialImage } from '@lib/garden/utils';
import { NOTE_FALLBACK_DESCRIPTION } from '@lib/site';
import '../../styles/components/_garden.css';
import '../../styles/components/_status-page.css';

const requestedPath = Astro.params.path ?? '';

const garden = await getGardenIndexOrUnavailable();
if (!garden.ok) return Astro.rewrite('/503');
const index = garden.index;

const document = index.documents.find((entry) => entry.path === requestedPath);

// A live note renders below. Anything else — a rename, a removal, the old
// bare-filename alias — is decided once the retirement snapshot is in hand.
// That read stays off the path that already found the note.
let removed = false;
if (!document) {
  const retirement = await readPublicNoteRetirement();
  if (!retirement.ok) return Astro.rewrite('/503');
  const decision = decidePublicNote(
    requestedPath,
    index.documents,
    retirement.retired,
  );
  if (decision.kind === 'redirect') {
    return new Response(null, {
      status: 301,
      headers: {
        Location: decision.href,
        'Cache-Control': 'no-store',
      },
    });
  }
  if (decision.kind === 'missing') return Astro.rewrite('/404');
  removed = true;
  Astro.response.status = 410;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

// An image the author put in the note beats a generated card; a note without
// one gets a card of its own rather than the site-wide default.
const socialImage = document
  ? (deriveNoteSocialImage(document.body) ?? noteSocialCardImage(document))
  : null;
const description = document
  ? document.summary || NOTE_FALLBACK_DESCRIPTION
  : 'This note was removed from oddava.me.';
---

{
  removed || !document ? (
    <Base title="Note removed" {description}>
      <meta slot="head" name="robots" content="noindex" />
      <section class="status-page">
        <h1>410</h1>
        <p class="status-page__copy">
          this note was removed. the link was real — the page is gone on
          purpose, not a typo.
        </p>
        <ul class="status-page__links">
          <li>
            <a href="/">home</a>
          </li>
          <li>
            <a href="/notes">notes</a>
          </li>
        </ul>
      </section>
    </Base>
  ) : (
    <Base
      title={document.title}
      {description}
      image={socialImage?.src}
      imageAlt={socialImage?.alt}
      type="article"
      modifiedTime={document.updated}
      wide
    >
      <div class="garden-page">
        <GardenDocumentPage document={document} index={index} />
      </div>
    </Base>
  )
}
