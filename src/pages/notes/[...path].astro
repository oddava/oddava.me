---
import Base from '../../layouts/Base.astro';
import GardenDocumentPage from '../../components/garden/GardenDocumentPage.astro';
import { getGardenIndexOrUnavailable, noteIdFromSourceId } from '@lib/garden';
import { deriveNoteSocialImage } from '@lib/garden/utils';
import '../../styles/components/_garden.css';

const requestedPath = Astro.params.path ?? '';

const garden = await getGardenIndexOrUnavailable();
if (!garden.ok) return Astro.rewrite('/503');
const index = garden.index;

const document = index.documents.find((entry) => entry.path === requestedPath);

// A nested note stays reachable by its bare file name too, redirecting to its
// real path — the one legacy alias we keep now that hierarchy is inferred.
if (!document) {
  const aliases = index.documents.filter(
    (entry) =>
      entry.path && noteIdFromSourceId(entry.sourceId) === requestedPath,
  );
  if (aliases.length === 1) return Astro.redirect(aliases[0]!.href, 301);
  return Astro.rewrite('/404');
}

const socialImage = deriveNoteSocialImage(document.body);
const description = document.summary || 'a note from oddava’s digital garden.';
---

<Base
  title={document.title}
  {description}
  image={socialImage?.src}
  imageAlt={socialImage?.alt}
  type="article"
  modifiedTime={document.updated}
  wide
>
  <div class="garden-page">
    <GardenDocumentPage document={document} index={index} />
  </div>
</Base>
