---
import NotesLayout from '../../layouts/NotesLayout.astro';
import GardenDocumentPage from '../../components/garden/GardenDocumentPage.astro';
import {
  decidePublicNote,
  getGardenIndexOrUnavailable,
  isDraftNote,
  readPublicNoteRetirement,
} from '@lib/garden';
import { isAdminRequest } from '@lib/server/admin';
import { registerPortfolioCsp } from '@lib/portfolio/csp';
import { noteSocialCardImage } from '@lib/garden/og-card';
import { resolveNoteSocialImage } from '@lib/garden/utils';
import { NOTE_FALLBACK_DESCRIPTION } from '@lib/site';
import { notesIndexUrl } from '@lib/notes-url';

registerPortfolioCsp(Astro.csp, import.meta.env.PROD);

const requestedPath = Astro.params.path ?? '';

const garden = await getGardenIndexOrUnavailable();
if (!garden.ok) return Astro.rewrite('/503');
let index = garden.index;

let document = index.documents.find((entry) => entry.path === requestedPath);

// A draft is not in the public index, so a visitor reaches the 404 below. The
// signed-in owner gets to read it as the page it will become — from the
// owner's index, so its own links and backlinks resolve too. Asked only after
// a miss: a visitor opening a live note never pays for the session check.
let draftPreview = false;
if (!document && (await isAdminRequest(Astro.cookies).catch(() => false))) {
  const owner = await getGardenIndexOrUnavailable({ includeDrafts: true });
  const draft = owner.ok
    ? owner.index.documents.find(
        (entry) => entry.path === requestedPath && isDraftNote(entry.data),
      )
    : undefined;
  if (owner.ok && draft) {
    index = owner.index;
    document = draft;
    draftPreview = true;
    // The owner's page must never be stored where a visitor could be served it.
    Astro.response.headers.set('Cache-Control', 'private, no-store');
  }
}

// A live note renders below. Anything else — a rename, a removal, the old
// bare-filename alias — is decided once the retirement snapshot is in hand.
// That read stays off the path that already found the note.
let removed = false;
if (!document) {
  const retirement = await readPublicNoteRetirement();
  if (!retirement.ok) return Astro.rewrite('/503');
  const decision = decidePublicNote(
    requestedPath,
    index.documents,
    retirement.retired,
  );
  if (decision.kind === 'redirect') {
    return new Response(null, {
      status: 301,
      headers: {
        Location: decision.href,
        'Cache-Control': 'no-store',
      },
    });
  }
  if (decision.kind === 'missing') return Astro.rewrite('/404');
  removed = true;
  Astro.response.status = 410;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

// Frontmatter image/cover, then the first body image, then a generated card;
// the site-wide default is the last resort.
const socialImage = document
  ? (resolveNoteSocialImage(document) ?? noteSocialCardImage(document))
  : null;
const description = document
  ? document.summary || NOTE_FALLBACK_DESCRIPTION
  : 'This note was removed from oddava.me.';
---

{
  removed || !document ? (
    <NotesLayout title="Note removed" {description}>
      <meta slot="head" name="robots" content="noindex" />
      <div class="notes-column">
        <article class="notes-sheet notes-gone">
          <span class="notes-stamp">410 · removed</span>
          <h1 class="notes-title">this page was taken down</h1>
          <p class="notes-lede">
            the link was real — the note is gone on purpose, not a typo.
          </p>
          <a class="notes-way" href={notesIndexUrl()}>
            ← back to the notes
          </a>
        </article>
      </div>
    </NotesLayout>
  ) : (
    <NotesLayout
      title={document.title}
      {description}
      image={socialImage?.src}
      imageAlt={socialImage?.alt}
      type="article"
      modifiedTime={document.updated}
    >
      {draftPreview && <meta slot="head" name="robots" content="noindex" />}
      <GardenDocumentPage {document} {index} draft={draftPreview} />
    </NotesLayout>
  )
}
