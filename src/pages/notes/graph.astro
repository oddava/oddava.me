---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import KnowledgeMap, {
  type KnowledgeMapEdge,
  type KnowledgeMapNode,
} from '../../components/garden/KnowledgeMap';
import NotesNav from '../../components/garden/NotesNav.astro';
import { getGardenIndex, getNoteTags } from '@lib/garden';
import '../../styles/components/_garden.css';

const index = await getGardenIndex();
const pairKey = (left: string, right: string) =>
  [left, right].toSorted().join('::');
const edgeKindsByPair = new Map<string, Set<KnowledgeMapEdge['kind']>>();
const edges: KnowledgeMapEdge[] = [];

const addEdge = (edge: KnowledgeMapEdge) => {
  if (edge.sourceId === edge.targetId) return;
  const key = pairKey(edge.sourceId, edge.targetId);
  const kinds = edgeKindsByPair.get(key) ?? new Set();
  if (kinds.has(edge.kind)) return;
  kinds.add(edge.kind);
  edgeKindsByPair.set(key, kinds);
  edges.push(edge);
};

for (const note of index.documents) {
  if (note.parentId) {
    addEdge({
      sourceId: note.parentId,
      targetId: note.id,
      kind: 'branch',
    });
  }

  for (const link of note.outbound) {
    if (!link.resolvedId) continue;
    addEdge({
      sourceId: note.id,
      targetId: link.resolvedId,
      kind: 'reference',
    });
  }
}

// Shared themes create quieter paths, but only when two or more topics overlap.
// They are deliberately the lowest-priority relation in the visual language.
for (let leftIndex = 0; leftIndex < index.documents.length; leftIndex += 1) {
  const left = index.documents[leftIndex]!;
  const leftTags = new Set(getNoteTags(left));

  for (
    let rightIndex = leftIndex + 1;
    rightIndex < index.documents.length;
    rightIndex += 1
  ) {
    const right = index.documents[rightIndex]!;
    const key = pairKey(left.id, right.id);
    if (edgeKindsByPair.has(key)) continue;

    const sharedTopics = getNoteTags(right).filter((tag) => leftTags.has(tag));
    if (sharedTopics.length < 2) continue;

    addEdge({ sourceId: left.id, targetId: right.id, kind: 'affinity' });
  }
}

const degree = new Map(index.documents.map((note) => [note.id, 0]));
const countedPairs = new Set<string>();
for (const edge of edges) {
  const key = pairKey(edge.sourceId, edge.targetId);
  if (countedPairs.has(key)) continue;
  countedPairs.add(key);
  degree.set(edge.sourceId, (degree.get(edge.sourceId) ?? 0) + 1);
  degree.set(edge.targetId, (degree.get(edge.targetId) ?? 0) + 1);
}

const nodes: KnowledgeMapNode[] = index.documents.map((note) => ({
  id: note.id,
  title: note.title,
  summary: note.summary,
  href: note.href,
  parentId: note.parentId,
  childIds: note.childIds,
  tags: getNoteTags(note),
  featured: note.backlinks.length > 0,
  degree: degree.get(note.id) ?? 0,
  outboundCount: note.outbound.filter((link) => link.resolvedId).length,
}));
---

<Base
  title="thought atlas"
  description="an interactive atlas of notes, neighborhoods, and the paths between them."
  wide
  hideFooter
>
  <div class="garden-page garden-page--map">
    <NotesNav
      documents={index.searchDocuments}
      current="map"
      showSearch={false}
    />

    <header class="garden-map-header">
      <div>
        <p class="garden-map-header__eyebrow">the living index</p>
        <h1>an atlas of<br />unfinished things</h1>
      </div>
      <div class="garden-map-header__intro">
        <p>
          every note has a place, but none of them lives alone. wander a
          neighborhood, follow a trail, or look for something by name.
        </p>
        <a href="#atlas-search"
          >start with a thought <span aria-hidden="true">↘</span></a
        >
      </div>
    </header>

    <section class="garden-map-section" aria-label="Note connections">
      <KnowledgeMap client:load nodes={nodes} edges={edges} />
    </section>
  </div>
</Base>
