---
import { notesIndexUrl } from '@lib/notes-url';

// The graph page is gone; the live graph sits in every note's rail, and its
// expand button opens the whole garden. Old links land on the garden's root.
// The route stays so `graph` remains a reserved note name and old links
// answer with a real 301 rather than a 404.
export const prerender = false;
return Astro.redirect(notesIndexUrl(), 301);
---
