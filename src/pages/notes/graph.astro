---
import Immersive from '../../layouts/Immersive.astro';
import InteractiveGraph from '../../components/garden/InteractiveGraph';
import { getGardenIndexOrUnavailable } from '@lib/garden';
import { deriveNoteGraph } from '@lib/garden/graph';

export const prerender = false;
const garden = await getGardenIndexOrUnavailable();
if (!garden.ok) return Astro.rewrite('/503');
const data = deriveNoteGraph(garden.index);
---

<Immersive
  title="graph of notes"
  description="Explore the connections between notes."
>
  <h1 class="sr-only">Graph of notes</h1>
  <InteractiveGraph client:load data={data} fullPage />
  <noscript>
    <p>The interactive graph needs JavaScript. Browse the notes:</p>
    <ul>
      {
        data.nodes.map((note) => (
          <li>
            <a href={note.href}>{note.title}</a>
          </li>
        ))
      }
    </ul>
  </noscript>
</Immersive>
