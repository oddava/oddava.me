---
export const prerender = true;

import Base from '../../../layouts/Base.astro';
import NoteCard from '../../../components/garden/NoteCard.astro';
import NotesNav from '../../../components/garden/NotesNav.astro';
import { getGardenIndex, getNoteTags } from '@lib/garden';
import '../../../styles/components/_garden.css';

export async function getStaticPaths() {
  const index = await getGardenIndex();
  return index.tags.map((tag) => ({
    params: { tag: tag.name },
    props: { index },
  }));
}

const { index } = Astro.props;
const tag = Astro.params.tag ?? '';
const notes = index.documents.filter((note) => getNoteTags(note).includes(tag));
---

<Base title={'#' + tag} description={'Notes connected to #' + tag + '.'} wide>
  <div class="garden-page">
    <NotesNav documents={index.searchDocuments} />

    <div class="garden-index garden-index--topic">
      <header class="garden-topic-header">
        <a href="/notes" class="garden-topic-header__back">← Notes</a>
        <h1>#{tag}</h1>
        <p>A few pages I’ve kept under this word.</p>
      </header>

      <section aria-label={`Notes about ${tag}`}>
        <div class="garden-list">
          {notes.map((note) => <NoteCard note={note} />)}
        </div>
      </section>
    </div>
  </div>
</Base>
