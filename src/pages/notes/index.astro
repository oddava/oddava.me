---
/**
 * The notes landing: uses the same 3-column shell as every note page —
 * quiet garden tree on the left, the root note's own title and prose in the
 * centre, and the garden graph (plus tags when present) in the right rail.
 */
import NotesLayout from '../../layouts/NotesLayout.astro';
import InteractiveGraph from '../../components/garden/InteractiveGraph';
import NotesSearchButton from '../../components/garden/NotesSearchButton.astro';
import NoteTree from '../../components/garden/NoteTree.astro';
import NotePageIcon from '../../components/NotePageIcon';
import { registerPortfolioCsp } from '@lib/portfolio/csp';
import { getGardenIndexOrUnavailable } from '@lib/garden';
import { deriveNoteGraph } from '@lib/garden/graph';
import { noteSocialCardImage } from '@lib/garden/og-card';
import { renderNote } from '@lib/garden/render';
import {
  bodyProvidesTitleHeading,
  deriveNoteSocialImage,
  formatNoteDate,
} from '@lib/garden/utils';
import { notesTagUrl } from '@lib/notes-url';
import { isNotesHostRequest } from '@lib/server/core';
import { NOTES_DESCRIPTION, SITE_NAME, SITE_URL } from '@lib/site';
import '../../styles/components/_note-prose.css';

registerPortfolioCsp(Astro.csp, import.meta.env.PROD);

const garden = await getGardenIndexOrUnavailable();
if (!garden.ok) return Astro.rewrite('/503');
const index = garden.index;
const root = index.root;
const socialImage =
  deriveNoteSocialImage(root.body) ?? noteSocialCardImage(root);

// The root note's body is the introduction. Its own `# title`, when it opens
// with one, becomes the page title, as on every note page.
let intro = root.body.trim()
  ? renderNote(root.body, { wikiLinkHrefs: index.wikiLinkHrefs }).html
  : '';
if (bodyProvidesTitleHeading(root.body)) {
  const titleEnd = intro.indexOf('</h1>');
  if (titleEnd >= 0) intro = intro.slice(titleEnd + '</h1>'.length).trim();
}

const notes = index.documents.filter((note) => note.id !== root.id);
const recent = notes
  .filter((note) => note.childIds.length === 0)
  .toSorted((left, right) => right.updated.localeCompare(left.updated))
  .slice(0, 5);
const tagCounts = new Map<string, number>();
for (const note of notes) {
  for (const tag of note.tags)
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const tags = [...tagCounts].toSorted(
  ([leftTag, left], [rightTag, right]) =>
    right - left || leftTag.localeCompare(rightTag),
);

const graph = deriveNoteGraph(index);
const showGraph = graph.nodes.length > 1;
const hasAside = showGraph || tags.length > 0;
const homeHref = isNotesHostRequest(Astro.url) ? SITE_URL : '/';
---

<NotesLayout
  title="Notes"
  description={NOTES_DESCRIPTION}
  image={socialImage.src}
  imageAlt={socialImage.alt}
  type="article"
  modifiedTime={root.updated}
>
  <div class="notes-shell notes-home">
    <NoteTree {index} currentId={root.id} />

    <div class="notes-center">
      <div class="notes-bar notes-bar--mobile-only">
        <button
          class="notes-menu-btn"
          type="button"
          data-note-nav-open
          aria-expanded="false"
          aria-label="Open notes menu"
        >
          <svg viewBox="0 0 18 18" aria-hidden="true">
            <path d="M3 5h12M3 9h12M3 13h12"></path>
          </svg>
        </button>
        <a class="notes-back" href={homeHref} data-page-preview-ignore>
          ← {SITE_NAME}
        </a>
        <NotesSearchButton variant="pill" />
      </div>

      <header class="notes-sheet notes-home__sheet">
        <div class="notes-home__head">
          <NotePageIcon icon={root.data.icon} />
          <h1 class="notes-title">{root.title}</h1>
        </div>
        {intro && <div class="prose notes-home__intro" set:html={intro} />}
      </header>

      {
        recent.length > 0 && (
          <section class="note-children" aria-labelledby="notes-recent-heading">
            <h2 class="notes-label" id="notes-recent-heading">
              recently updated
            </h2>
            <ol class="note-children__list" role="list">
              {recent.map((note) => {
                const parent = note.parentId
                  ? index.byId.get(note.parentId)
                  : undefined;
                const folder = parent && parent.id !== root.id && parent;
                return (
                  <li>
                    <a
                      class="note-children__row"
                      href={note.href}
                      data-page-preview-ignore
                    >
                      <span class="note-children__title">{note.title}</span>
                      <span class="note-children__meta">
                        {folder && (
                          <span class="note-children__folder">
                            {folder.title}
                          </span>
                        )}
                        <time datetime={note.updated}>
                          {formatNoteDate(note.updated, 'short')}
                        </time>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>
        )
      }
    </div>

    {
      hasAside && (
        <aside class="note-aside" aria-label="Around the notes">
          {showGraph && (
            <section class="note-nearby" aria-labelledby="notes-graph-heading">
              <h2 class="notes-label" id="notes-graph-heading">
                graph
              </h2>
              <div class="notes-slip note-nearby__graph">
                <InteractiveGraph
                  client:visible
                  data={graph}
                  globalData={graph}
                  currentId={root.id}
                />
              </div>
            </section>
          )}
          {tags.length > 0 && (
            <section class="note-tags-panel" aria-labelledby="notes-tags">
              <h2 class="notes-label" id="notes-tags">
                tags
              </h2>
              <ul class="note-tags" role="list">
                {tags.map(([tag, count]) => (
                  <li>
                    <a
                      class="notes-sticker notes-sticker--tag"
                      href={notesTagUrl(tag)}
                    >
                      #{tag}
                      <span class="notes-sticker__count">{count}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </aside>
      )
    }
  </div>
</NotesLayout>
