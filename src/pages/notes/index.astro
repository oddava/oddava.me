---
import NotesShell from '../../components/garden/NotesShell.astro';
import GardenDocumentPage from '../../components/garden/GardenDocumentPage.astro';
import { getGardenIndexOrUnavailable } from '@lib/garden';
import { noteSocialCardImage } from '@lib/garden/og-card';
import { deriveNoteSocialImage } from '@lib/garden/utils';
import { NOTES_DESCRIPTION } from '@lib/site';
import { isNotesHostRequest } from '@lib/server/core';
import '../../styles/components/_garden.css';

const garden = await getGardenIndexOrUnavailable();
if (!garden.ok) return Astro.rewrite('/503');
const index = garden.index;
const socialImage =
  deriveNoteSocialImage(index.root.body) ?? noteSocialCardImage(index.root);
---

<NotesShell
  title="Notes"
  description={NOTES_DESCRIPTION}
  image={socialImage.src}
  imageAlt={socialImage.alt}
  type="article"
  modifiedTime={index.root.updated}
  wide
>
  <div class="garden-page">
    <GardenDocumentPage
      document={index.root}
      index={index}
      railGraph={!isNotesHostRequest(Astro.url)}
    />
  </div>
</NotesShell>
