---
import Base from '../../layouts/Base.astro';
import GardenDocumentPage from '../../components/garden/GardenDocumentPage.astro';
import { getGardenIndexOrUnavailable } from '@lib/garden';
import '../../styles/components/_garden.css';

const garden = await getGardenIndexOrUnavailable();
if (!garden.ok) return Astro.rewrite('/503');
const index = garden.index;

// Documents are already sorted most-recently-updated first.
const recent = index.documents
  .filter((document) => document.id !== index.root.id)
  .slice(0, 5);
---

<Base title={index.root.title} description={index.root.summary} wide>
  <div class="garden-page">
    <GardenDocumentPage document={index.root} index={index}>
      <!-- Map of the whole garden: under root contents, same reading column. -->
      <nav class="note-contents note-contents--views" aria-label="Notes views">
        <ul class="note-contents__list">
          <li class="note-content">
            <a href="/notes/graph" class="note-content__link">
              <span class="note-content__icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none">
                  <circle cx="5" cy="6" r="2"></circle>
                  <circle cx="15" cy="5" r="2"></circle>
                  <circle cx="10.5" cy="14.5" r="2"></circle>
                  <path d="M6.7 7.1 9 13M13.2 6.2 11.7 13M6.9 5.7 13.1 5.1"
                  ></path>
                </svg>
              </span>
              <span class="note-content__title">map</span>
            </a>
          </li>
        </ul>
      </nav>

      {
        recent.length > 0 && (
          <section class="garden-recent" aria-labelledby="recently-tended">
            <h2 class="garden-recent__heading" id="recently-tended">
              recently updated
            </h2>
            <ul class="garden-recent__list">
              {recent.map((note) => (
                <li>
                  <a href={note.href} class="garden-recent__link">
                    <span class="garden-recent__title">{note.title}</span>
                    <time class="garden-recent__date" datetime={note.updated}>
                      {note.updated.slice(0, 10)}
                    </time>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </GardenDocumentPage>
  </div>
</Base>
