---
import { getGardenIndexOrUnavailable } from '@lib/garden';

const requestedPath = Astro.params.path ?? '';

const garden = await getGardenIndexOrUnavailable();
if (!garden.ok) return garden.response;
const index = garden.index;

// A folder path resolves to its own document page. Folders with children
// redirect to the note that represents them.
const document = index.documents.find(
  (entry) => entry.path === requestedPath && entry.childIds.length > 0,
);
if (document) return Astro.redirect(document.href, 301);
return Astro.rewrite('/404');
---
