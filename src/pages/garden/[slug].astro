---
export const prerender = true;

import { getCollection } from 'astro:content';
import { uniqueNoteLeafRedirects } from '@lib/garden';

// Old /garden/<slug> links live on as redirects into the notes garden. The map
// is built straight from where each note sits on disk — no aliases to maintain.
export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return uniqueNoteLeafRedirects(notes).map(({ slug, redirectTo }) => ({
    params: { slug },
    props: { redirectTo },
  }));
}

return Astro.redirect(Astro.props.redirectTo, 301);
---
