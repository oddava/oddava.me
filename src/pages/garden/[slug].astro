---
export const prerender = true;

import { getCollection } from 'astro:content';
import { noteHrefFromSourceId, noteIdFromSourceId } from '@lib/garden';

// Old /garden/<slug> links live on as redirects into the notes garden. The map
// is built straight from where each note sits on disk — no aliases to maintain.
export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  const bySlug = new Map<string, string>();

  for (const note of notes) {
    const slug = noteIdFromSourceId(note.id);
    if (slug === 'index' || bySlug.has(slug)) continue;
    bySlug.set(slug, noteHrefFromSourceId(note.id));
  }

  return [...bySlug].map(([slug, redirectTo]) => ({
    params: { slug },
    props: { redirectTo },
  }));
}

return Astro.redirect(Astro.props.redirectTo, 301);
---
