---
import { findNoteLeafRedirect, getGardenIndexOrUnavailable } from '@lib/garden';

// Old /garden/<slug> links live on as redirects into the notes garden, keyed
// off each note's file name. Server-rendered rather than prerendered so the map
// follows the live content store instead of the last deploy.
const garden = await getGardenIndexOrUnavailable();
if (!garden.ok) return Astro.rewrite('/503');

const redirectTo = findNoteLeafRedirect(garden.index, Astro.params.slug ?? '');
if (!redirectTo) return Astro.rewrite('/404');
return Astro.redirect(redirectTo, 301);
---
