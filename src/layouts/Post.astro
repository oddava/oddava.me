---
import Base from './Base.astro';
import '../styles/components/_prose.css';
import { formatPostDate } from '../lib/content';
import { SITE_AUTHOR_NAME, siteUrl } from '../lib/site';

export interface Props {
  frontmatter: {
    title: string;
    date: string;
    updated?: string;
    description?: string;
    image?: string;
  };
}

const { frontmatter } = Astro.props;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: frontmatter.date,
  dateModified: frontmatter.updated ?? frontmatter.date,
  author: {
    '@type': 'Person',
    name: SITE_AUTHOR_NAME,
    url: siteUrl('/about'),
  },
  image: frontmatter.image
    ? new URL(frontmatter.image, Astro.url).toString()
    : undefined,
  mainEntityOfPage: Astro.url.toString(),
};
const serializedArticleSchema = JSON.stringify(articleSchema)
  .replaceAll('<', '\\u003c')
  .replaceAll('>', '\\u003e')
  .replaceAll('&', '\\u0026');
---

<Base
  title={frontmatter.title}
  description={frontmatter.description}
  type="article"
  image={frontmatter.image}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={serializedArticleSchema}
  />
  <article>
    <header class="post-header">
      <h1>{frontmatter.title}</h1>
      <div class="post-header__meta">
        <time datetime={frontmatter.date}>
          {formatPostDate(frontmatter.date)}
        </time>
        {
          frontmatter.updated && (
            <>
              <span aria-hidden="true"> / </span>
              <span>
                updated{' '}
                <time datetime={frontmatter.updated}>
                  {formatPostDate(frontmatter.updated)}
                </time>
              </span>
            </>
          )
        }

      </div>
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
