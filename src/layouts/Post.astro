---
import Base from './Base.astro';
import { formatPostStats, type PostStats } from '../lib/content';

export interface Props {
  frontmatter: {
    title: string;
    date: string;
    updated?: string;
    description?: string;
    image?: string;
  };
  stats: PostStats;
}

const { frontmatter, stats } = Astro.props;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: frontmatter.date,
  dateModified: frontmatter.updated ?? frontmatter.date,
  author: {
    '@type': 'Person',
    name: 'oddava',
    url: 'https://oddava.me/about',
  },
  image: frontmatter.image ? new URL(frontmatter.image, Astro.url).toString() : undefined,
  mainEntityOfPage: Astro.url.toString(),
};
const serializedArticleSchema = JSON.stringify(articleSchema)
  .replaceAll('<', '\\u003c')
  .replaceAll('>', '\\u003e')
  .replaceAll('&', '\\u0026');

function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---
<Base title={frontmatter.title} description={frontmatter.description} type="article" image={frontmatter.image}>
  <script slot="head" is:inline type="application/ld+json" set:html={serializedArticleSchema} />
  <article>
    <header class="post-header">
      <h1>{frontmatter.title}</h1>
      <div class="post-header__meta">
        <time datetime={frontmatter.date}>{formatDate(frontmatter.date)}</time>
        {frontmatter.updated && (
          <>
            <span aria-hidden="true"> · </span>
            <span>updated <time datetime={frontmatter.updated}>{formatDate(frontmatter.updated)}</time></span>
          </>
        )}
        <span aria-hidden="true"> · </span>
        <span>{formatPostStats(stats)}</span>
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
