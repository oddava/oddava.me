---
export interface Props {
  title?: string;
  description?: string;
}

const { title = 'admin', description = 'Site administration for oddava.me.' } =
  Astro.props;
const pageTitle = `${title} | oddava admin`;
---

<!doctype html>
<html lang="en" class="admin-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <style is:global>
      .admin-page {
        --admin-bg: #f4efe4;
        --admin-bg-alt: #efe6d5;
        --admin-surface: rgba(255, 252, 246, 0.88);
        --admin-surface-strong: #fffaf1;
        --admin-text-primary: #20180f;
        --admin-text-secondary: #655849;
        --admin-text-muted: #756858;
        --admin-text-disabled: #8a7e70;
        --admin-text-interactive: #a64222;
        --admin-text-interactive-hover: #7f2d16;
        --admin-text-success: #2e6b43;
        --admin-text-warning: #7d5812;
        --admin-text-error: #8f2f25;
        --admin-text-on-accent: #f2e6d7;
        --admin-text-on-danger: #f1e1de;
        --admin-line: rgba(63, 47, 34, 0.12);
        --admin-accent: var(--admin-text-interactive);
        --admin-danger: var(--admin-text-error);
        --admin-status-neutral-bg: rgba(101, 88, 73, 0.08);
        --admin-status-success-bg: rgba(46, 107, 67, 0.12);
        --admin-status-warning-bg: rgba(125, 88, 18, 0.12);
        --admin-status-error-bg: rgba(143, 47, 37, 0.1);
        --admin-radius: 20px;
        --admin-shadow: 0 24px 80px rgba(63, 42, 20, 0.08);
      }

      .admin-page *,
      .admin-page *::before,
      .admin-page *::after {
        box-sizing: border-box;
      }

      .admin-page,
      .admin-page__body {
        margin: 0;
        min-height: 100%;
      }

      .admin-page__body {
        font-family: Georgia, 'Iowan Old Style', 'Palatino Linotype', serif;
        color: var(--admin-text-primary);
        background:
          radial-gradient(
            circle at top left,
            rgba(166, 66, 34, 0.12),
            transparent 28%
          ),
          radial-gradient(
            circle at top right,
            rgba(146, 104, 24, 0.16),
            transparent 24%
          ),
          linear-gradient(180deg, var(--admin-bg), var(--admin-bg-alt));
      }

      .admin-page a {
        color: inherit;
      }
      .admin-page a:not(.admin-button):hover {
        color: var(--admin-text-interactive-hover);
      }
      .admin-page button,
      .admin-page input,
      .admin-page select,
      .admin-page textarea {
        font: inherit;
      }

      .admin-shell {
        max-width: 1320px;
        margin: 0 auto;
        padding: 32px 20px 56px;
      }

      .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        margin-bottom: 24px;
      }

      .admin-header h1 {
        margin: 0;
        font-size: clamp(2.25rem, 4vw, 4rem);
        line-height: 0.95;
        letter-spacing: -0.04em;
      }

      .admin-header p {
        margin: 10px 0 0;
        color: var(--admin-text-secondary);
        max-width: 54ch;
      }

      .admin-kicker {
        margin: 0 0 8px;
        font-family: 'Courier New', monospace;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--admin-text-interactive);
      }

      .admin-card {
        background: var(--admin-surface);
        border: 1px solid var(--admin-line);
        border-radius: var(--admin-radius);
        box-shadow: var(--admin-shadow);
        backdrop-filter: blur(14px);
      }

      .admin-toolbar {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
      }

      .admin-button,
      .admin-input,
      .admin-select {
        border-radius: 999px;
        border: 1px solid var(--admin-line);
        background: rgba(255, 250, 241, 0.92);
        color: var(--admin-text-primary);
        min-height: 44px;
      }

      .admin-input::placeholder,
      .admin-select:invalid {
        color: var(--admin-text-muted);
      }

      .admin-label {
        display: block;
        margin-bottom: 8px;
        color: var(--admin-text-secondary);
      }

      .admin-button {
        padding: 0 18px;
        cursor: pointer;
        transition:
          transform 140ms ease,
          background 140ms ease,
          color 140ms ease;
      }

      .admin-button:hover {
        transform: translateY(-1px);
      }
      .admin-button:disabled {
        color: var(--admin-text-disabled);
        cursor: wait;
        transform: none;
      }
      .admin-button.primary {
        background: var(--admin-accent);
        color: var(--admin-text-on-accent);
        border-color: transparent;
      }
      .admin-button.danger {
        background: var(--admin-danger);
        color: var(--admin-text-on-danger);
        border-color: transparent;
      }
      .admin-button.ghost {
        background: transparent;
      }
      .admin-button.primary:disabled,
      .admin-button.danger:disabled {
        background: var(--admin-status-neutral-bg);
        color: var(--admin-text-disabled);
        border-color: var(--admin-line);
      }

      .admin-input,
      .admin-select {
        width: 100%;
        padding: 0 16px;
      }

      .admin-main {
        display: grid;
        gap: 20px;
      }

      .admin-login {
        max-width: 520px;
        margin: 9vh auto 0;
        padding: 28px;
      }

      .admin-login form {
        display: grid;
        gap: 14px;
      }

      .admin-note,
      .admin-error,
      .admin-success {
        margin: 0;
        padding: 12px 14px;
        border-radius: 14px;
      }

      .admin-note {
        background: var(--admin-status-warning-bg);
        color: var(--admin-text-warning);
      }
      .admin-error {
        background: var(--admin-status-error-bg);
        color: var(--admin-text-error);
      }
      .admin-success {
        background: var(--admin-status-success-bg);
        color: var(--admin-text-success);
      }

      @media (max-width: 720px) {
        .admin-shell {
          padding: 20px 14px 40px;
        }
        .admin-header {
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body class="admin-page__body">
    <div class="admin-shell">
      <slot />
    </div>
  </body>
</html>
