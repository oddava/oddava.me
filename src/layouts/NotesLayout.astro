---
/**
 * The notes garden's own shell, used when a page is served on the notes
 * hostname. Compared with Base: its own header (the `oddava` wordmark back
 * to the personal site, the notes, and search), no music widget, and one
 * font preload. See docs/notes-host.md.
 */
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import ManiculeLists from '../components/ManiculeLists.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PagePreview from '../components/PagePreview.astro';
import SiteHead, {
  type Props as SiteHeadProps,
} from '../components/SiteHead.astro';

export interface Props extends SiteHeadProps {
  wide?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  type,
  modifiedTime,
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <SiteHead
      {title}
      {description}
      {image}
      {imageAlt}
      {type}
      {modifiedTime}
      fontPreloads="body"
    >
      <slot name="head" />
    </SiteHead>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader variant="notes" />
    <div class:list={['page', wide && 'page--wide']}>
      <main id="main">
        <slot />
      </main>
    </div>
    <Footer sitemapHref="/sitemap.xml" />
    <PagePreview />
    <ManiculeLists />
  </body>
</html>
