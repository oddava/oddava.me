---
import '../styles/global.css';
import SiteHead, {
  type Props as SiteHeadProps,
} from '../components/SiteHead.astro';

export interface Props extends SiteHeadProps {}

const { title, description, image, type } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <SiteHead {title} {description} {image} {type}>
      <slot name="head" />
    </SiteHead>
  </head>
  <body class="body--immersive">
    <div class="page page--immersive">
      <a href="#main" class="skip-link">Skip to content</a>
      <main id="main">
        <slot />
      </main>
    </div>
  </body>
</html>
