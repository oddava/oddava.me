---
import '../styles/global.css';
import LoadingIndicator from '../components/LoadingIndicator.astro';
import Footer from '../components/Footer.astro';
import PagePreview from '../components/PagePreview.astro';
import QuietSky from '../components/QuietSky.astro';
import SiteHead, {
  type Props as SiteHeadProps,
} from '../components/SiteHead.astro';
import SiteNav from '../components/SiteNav.astro';
import { loadSpotifyWidgetSlot } from '../lib/spotify-widget-slot';

export interface Props extends SiteHeadProps {
  hideFooter?: boolean;
  /** The homepage hero is its own navigation; every other page shows the nav. */
  hideNav?: boolean;
  /** Home's stars, dimmed, behind the page, and the cat asleep on the footer. */
  sky?: boolean;
  wide?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  type,
  modifiedTime,
  hideFooter = false,
  hideNav = false,
  sky = false,
  wide = false,
} = Astro.props;

const SpotifyWidgetLoader = await loadSpotifyWidgetSlot();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <SiteHead {title} {description} {image} {imageAlt} {type} {modifiedTime}>
      <slot name="head" />
    </SiteHead>
  </head>
  <body>
    {hideNav && <LoadingIndicator />}
    <slot name="background" />
    {sky && <QuietSky />}
    <div class:list={['page', wide && 'page--wide', sky && 'page--sky']}>
      <a href="#main" class="skip-link">Skip to content</a>

      {!hideNav && <SiteNav />}

      <main id="main">
        <slot />
      </main>

      {!hideFooter && <Footer nap={sky} />}
    </div>
    {Astro.url.pathname !== '/' && <PagePreview />}
    {SpotifyWidgetLoader && <SpotifyWidgetLoader />}
  </body>
</html>
