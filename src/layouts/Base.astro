---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import PagePreview from '../components/PagePreview.astro';
import ParticleField from '../components/ParticleField.astro';
import SiteHead, {
  type Props as SiteHeadProps,
} from '../components/SiteHead.astro';
import SiteNav from '../components/SiteNav.astro';
import type { ParticlePresetName } from '../lib/particles/presets';
import { loadSpotifyWidgetSlot } from '../lib/spotify-widget-slot';

export interface Props extends SiteHeadProps {
  hideFooter?: boolean;
  /** The homepage hero is its own navigation; every other page shows the nav. */
  hideNav?: boolean;
  wide?: boolean;
  /** Overrides the drift field the route would choose, or removes it entirely
   *  for a page that composes its own full-bleed canvas. */
  particles?: ParticlePresetName | false;
}

const {
  title,
  description,
  image,
  imageAlt,
  type,
  modifiedTime,
  hideFooter = false,
  hideNav = false,
  wide = false,
  particles,
} = Astro.props;

const SpotifyWidgetLoader = await loadSpotifyWidgetSlot();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <SiteHead {title} {description} {image} {imageAlt} {type} {modifiedTime}>
      <slot name="head" />
    </SiteHead>
  </head>
  <body>
    {particles !== false && <ParticleField preset={particles} />}
    <div class:list={['page', wide && 'page--wide']}>
      <a href="#main" class="skip-link">Skip to content</a>

      {!hideNav && <SiteNav />}

      <main id="main">
        <slot />
      </main>

      {!hideFooter && <Footer />}
    </div>
    {Astro.url.pathname !== '/' && <PagePreview />}
    {SpotifyWidgetLoader && <SpotifyWidgetLoader />}
  </body>
</html>
