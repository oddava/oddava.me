---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { loadSpotifyWidgetSlot } from '../lib/spotify-widget-slot';
import { SITE_DESCRIPTION, SITE_NAME, SITE_TWITTER_HANDLE } from '../lib/site';

const SpotifyWidgetLoader = await loadSpotifyWidgetSlot();

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  image = '/favicon.svg',
  type = 'website',
} = Astro.props;

const pageTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonicalUrl = Astro.url.toString();
const socialImage = new URL(image, Astro.url).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE_TWITTER_HANDLE} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="oddava writing"
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preload critical fonts -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/m-plus-rounded-1c-latin-400-normal.woff2"
      crossorigin
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/m-plus-rounded-1c-latin-700-normal.woff2"
      crossorigin
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/jetbrains-mono-latin-400-normal.woff2"
      crossorigin
      fetchpriority="high"
    />

    <slot name="head" />

    {/* Keep the site on its intended dark palette before paint. */}
    <script is:inline>
      (function () {
        document.documentElement.setAttribute('data-theme', 'dark');

        try {
          localStorage.removeItem('theme');
        } catch {
          /* localStorage can be unavailable in strict browser modes. */
        }
      })();
    </script>

    {/* Inline critical CSS: font-face, variables, reset, typography */}
    <style is:inline>
      /* --- Font Faces --- */
      @font-face { font-family: 'JetBrains Mono'; font-style: normal; font-display: swap; font-weight: 400; src: url(/fonts/jetbrains-mono-latin-400-normal.woff2) format('woff2'); }
      @font-face { font-family: 'JetBrains Mono'; font-style: normal; font-display: swap; font-weight: 500; src: url(/fonts/jetbrains-mono-latin-500-normal.woff2) format('woff2'); }
      @font-face { font-family: 'M PLUS Rounded 1c'; font-style: normal; font-display: swap; font-weight: 400; src: url(/fonts/m-plus-rounded-1c-latin-400-normal.woff2) format('woff2'); }
      @font-face { font-family: 'M PLUS Rounded 1c'; font-style: normal; font-display: swap; font-weight: 500; src: url(/fonts/m-plus-rounded-1c-latin-500-normal.woff2) format('woff2'); }
      @font-face { font-family: 'M PLUS Rounded 1c'; font-style: normal; font-display: swap; font-weight: 700; src: url(/fonts/m-plus-rounded-1c-latin-700-normal.woff2) format('woff2'); }

      /* --- Variables --- */
      :root {
        --font-body: 'M PLUS Rounded 1c', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', 'Courier New', monospace;
        --text-sm: 0.875rem;
        --text-base: 1.125rem;
        --text-lg: 1.25rem;
        --text-xl: 1.5rem;
        --text-2xl: 2rem;
        --leading-body: 1.75;
        --leading-tight: 1.3;
        --space-xs: 0.5rem;
        --space-sm: 1rem;
        --space-md: 2rem;
        --space-lg: 4rem;
        --space-xl: 6rem;
        --max-width: 38rem;
        --max-width-wide: 70rem;
        --page-padding: 1.5rem;
      }

      :root,
      [data-theme],
      [data-theme='dark'] {
        --color-text-primary: #e8e4ee;
        --color-text-secondary: #b7b1c4;
        --color-text-muted: #9892a5;
        --color-text-disabled: #777282;
        --color-text-accent: #a78bfa;
        --color-text-interactive: #a78bfa;
        --color-text-interactive-hover: #c4b5fd;
        --color-text-success: #7fcf9c;
        --color-text-warning: #e8bd6a;
        --color-text-error: #ff8585;
        --color-text-on-accent: #121018;
        --color-surface: color-mix(in srgb, #0b0c0f 96%, #8b5cf6 4%);
        --color-surface-raised: color-mix(in srgb, #121317 94%, #8b5cf6 6%);
        --color-surface-elevated: color-mix(in srgb, #17181d 91%, #8b5cf6 9%);
        --color-surface-glass: color-mix(in srgb, var(--color-surface-elevated) 84%, transparent);
        --color-surface-overlay: color-mix(in srgb, var(--color-surface-raised) 95%, transparent);
        --color-accent: var(--color-text-accent);
        --color-accent-soft: var(--color-text-interactive);
        --color-accent-hover: var(--color-text-interactive-hover);
        --color-rule: color-mix(in srgb, #8b5cf6 10%, transparent);
        --color-rule-strong: color-mix(in srgb, #8b5cf6 18%, transparent);
        --color-overlay-soft: color-mix(in srgb, #8b5cf6 6%, transparent);
        --color-overlay-strong: color-mix(in srgb, #8b5cf6 12%, transparent);
        --color-shadow: color-mix(in srgb, #8b5cf6 10%, transparent);
        --color-focus-ring: color-mix(in srgb, #8b5cf6 28%, transparent);
        --color-selection: color-mix(in srgb, #8b5cf6 24%, transparent);
        color-scheme: dark;
      }

      /* --- Reset --- */
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
      html { font-size: 100%; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; scroll-behavior: smooth; }
      ::selection { background: var(--color-selection); color: var(--color-text-primary); }

      /* --- Typography --- */
      body {
        font-family: var(--font-body);
        font-size: var(--text-base);
        line-height: var(--leading-body);
        color: var(--color-text-primary);
        background-color: var(--color-surface);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        min-height: 100vh;
      }
      :focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 3px; }
      a { color: var(--color-text-interactive); text-decoration: none; transition: color 0.15s ease; }
      a:hover { color: var(--color-text-interactive-hover); }
      h1, h2, h3, h4 { font-family: var(--font-body); line-height: var(--leading-tight); color: var(--color-text-primary); letter-spacing: -0.02em; }
      h1 { font-size: var(--text-2xl); font-weight: 700; margin-bottom: var(--space-sm); }
      h2 { font-size: var(--text-xl); font-weight: 600; margin-top: var(--space-lg); margin-bottom: var(--space-sm); }
      h3 { font-size: var(--text-lg); font-weight: 600; margin-top: var(--space-md); margin-bottom: var(--space-xs); }
      hr { border: none; border-top: 1px solid var(--color-rule); margin: var(--space-lg) 0; }
    </style>
  </head>
  <body>
    <div class="page">
      <Nav />

      <main>
        <slot />
      </main>

      <Footer />
    </div>
    {SpotifyWidgetLoader && <SpotifyWidgetLoader />}

    {import.meta.env.DEV && (
      <script is:inline>
        (function () {
          function log(msg, ms) {
            console.log('%c' + msg + '%c ' + ms + 'ms', 'color:#a78bfa;font-weight:bold', 'color:inherit');
          }

          window.addEventListener('load', function () {
            var p = performance.getEntriesByType('navigation')[0];
            var paint = performance.getEntriesByType('paint');

            if (p) {
              log('TTFB', Math.round(p.responseStart - p.requestStart));
              log('DNS', Math.round(p.domainLookupEnd - p.domainLookupStart));
              log('Connect', Math.round(p.connectEnd - p.connectStart));
              log('Response', Math.round(p.responseEnd - p.responseStart));
              log('DOM Interactive', Math.round(p.domInteractive - p.startTime));
              log('DOMContentLoaded', Math.round(p.domContentLoadedEventEnd - p.startTime));
              log('Load Event', Math.round(p.loadEventEnd - p.startTime));
            }

            var fcp = paint.find(function (e) { return e.name === 'first-contentful-paint'; });
            if (fcp) log('FCP', Math.round(fcp.startTime));

            var lcp = null;
            try {
              new PerformanceObserver(function (o) {
                var entries = o.getEntries();
                lcp = entries[entries.length - 1];
                if (lcp) log('LCP', Math.round(lcp.startTime));
              }).observe({ type: 'largest-contentful-paint', buffered: true });
            } catch {}

            var cls = 0;
            try {
              new PerformanceObserver(function (o) {
                o.getEntries().forEach(function (e) { if (!e.hadRecentInput) cls += e.value; });
                console.log('%cCLS' + '%c ' + cls.toFixed(4), 'color:#a78bfa;font-weight:bold', 'color:inherit');
              }).observe({ type: 'layout-shift', buffered: true });
            } catch {}

            var resources = performance.getEntriesByType('resource');
            var cssCount = 0, fontCount = 0, jsCount = 0;
            resources.forEach(function (r) {
              if (r.initiatorType === 'css' || r.name.endsWith('.css')) cssCount++;
              if (r.name.endsWith('.woff2') || r.name.endsWith('.woff')) fontCount++;
              if (r.initiatorType === 'script') jsCount++;
            });

            console.log(
              '%cResources:%c ' + resources.length + ' total (' + cssCount + ' css, ' + fontCount + ' fonts, ' + jsCount + ' js)',
              'color:#a78bfa;font-weight:bold', 'color:inherit'
            );
            console.log(
              '%cTransfer:%c ' + (resources.reduce(function (a, r) { return a + r.transferSize; }, 0) / 1024).toFixed(1) + ' KB',
              'color:#a78bfa;font-weight:bold', 'color:inherit'
            );
          });
        })();
      </script>
    )}
  </body>
</html>
