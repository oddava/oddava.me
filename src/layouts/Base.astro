---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import SiteHead, {
  type Props as SiteHeadProps,
} from '../components/SiteHead.astro';
import SiteNav from '../components/SiteNav.astro';
import { loadSpotifyWidgetSlot } from '../lib/spotify-widget-slot';

export interface Props extends SiteHeadProps {
  hideFooter?: boolean;
  /** The homepage hero is its own navigation; every other page shows the nav. */
  hideNav?: boolean;
  wide?: boolean;
}

const {
  title,
  description,
  image,
  type,
  hideFooter = false,
  hideNav = false,
  wide = false,
} = Astro.props;

const SpotifyWidgetLoader = await loadSpotifyWidgetSlot();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <SiteHead {title} {description} {image} {type}>
      <slot name="head" />
    </SiteHead>
  </head>
  <body>
    <div class:list={['page', wide && 'page--wide']}>
      <a href="#main" class="skip-link">Skip to content</a>

      {!hideNav && <SiteNav />}

      <main id="main">
        <slot />
      </main>

      {!hideFooter && <Footer />}
    </div>
    {SpotifyWidgetLoader && <SpotifyWidgetLoader />}
  </body>
</html>
